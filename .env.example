# ── 기후시민회의 환경변수 예시 ──────────────────────────────────────────────

# Google Sheets CSV URL (read-only) — 라이브 Q&A 대시보드 (/ko/moderator/live)
# LiveQA 시트 스키마: 순번|일자|채널|지역|분임|답변자|내용|예정시간|상태
# ⚠️ 시트 ID에 하이픈(-)이 포함될 수 있음 — 복사 시 누락 주의 (보통 44자)
PUBLIC_LIVE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<LIVEQA_ID>/gviz/tq?tqx=out:csv

# Google Sheets CSV URL (read-only) — 의제 보드 (/ko/moderator/board)
# Board 시트 스키마: 순번|일자|조|발언자|안건|상태|도메인|타임스탬프|키워드|override_양단
# 미설정 시 PUBLIC_LIVE_SHEET_CSV_URL로 폴백하나, 두 시트 스키마가 다르므로 운영 시 분리 필수
PUBLIC_BOARD_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<BOARD_ID>/gviz/tq?tqx=out:csv

# 정체성 카드 시뮬레이션용 로컬 CSV (dev 전용)
PUBLIC_IDENTITY_SHEET_CSV_URL=/sim-identity.csv

# ── 양단(감축↔적응) 보드 드래그앤드롭 writeback ──────────────────────────
# Apps Script web app URL (배포 후 입력)
# 형식: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# - 본부 모드(?mode=control) 드래그앤드롭이 이 URL로 POST함
# - Content-Type: text/plain;charset=utf-8 (CORS 제약)
# - 미설정 시 본부 드래그 기능 비활성 (read-only 폴링만 동작)
# - 배포 후 Cloudflare Pages 환경변수에도 동일하게 등록 필요
PUBLIC_BOARD_WRITEBACK_URL=

# 사이트 canonical URL
PUBLIC_SITE_URL=https://climate-assembly.org
