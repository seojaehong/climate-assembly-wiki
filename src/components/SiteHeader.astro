---
/**
 * SiteHeader.astro — B4 (Phase 3 uplift)
 * Site header: sticky, backdrop-blur on scroll, max-width 1280px.
 *
 * Dark mode: .dark class (Tailwind) + [data-theme="dark"] (tokens.css) — both set by ThemeToggle.
 * Mobile: <details>/<summary> CSS-only hamburger.
 */

import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { TOP_NAV_ITEMS } from '../data/navigation';

const currentUrl = Astro.url.pathname;
const segments = currentUrl.split('/').filter(Boolean);
const currentLang = (['ko', 'en'].includes(segments[0])) ? segments[0] : 'ko';
const isKo = currentLang === 'ko';
const currentSection = segments[1] ?? '';

function navHref(section: string): string {
  return `/${currentLang}/${section}/`;
}
---

<header
  id="site-header"
  class="site-header sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)] py-0 transition-[background-color,border-color,backdrop-filter] duration-200"
>
  <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">

    <!-- Site logo / wordmark -->
    <a
      href={`/${currentLang}/`}
      class="site-logo font-bold text-sm text-[var(--color-accent)] shrink-0 tracking-tight hover:opacity-80 transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      transition:name="site-logo"
    >
      {isKo ? '기후시민회의 Wiki' : 'Korea Climate Assembly Wiki'}
    </a>

    <!-- Desktop nav (md+) -->
    <nav
      aria-label={isKo ? '주요 탐색' : 'Main navigation'}
      class="hidden md:flex items-center gap-0.5 text-sm"
    >
      {TOP_NAV_ITEMS.map((item) => {
        const active = currentSection === item.section;
        return (
          <a
            href={navHref(item.section)}
            aria-current={active ? 'page' : undefined}
            class={[
              'px-3 py-1.5 rounded-md font-medium transition-colors',
              active
                ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)] dark:bg-[var(--color-accent-muted)] dark:text-[var(--color-accent)]'
                : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
            ].join(' ')}
          >
            {isKo ? item.labelKo : item.labelEn}
          </a>
        );
      })}
    </nav>

    <!-- Controls: search + language + theme -->
    <div class="header-controls flex items-center gap-1.5 shrink-0">

      <!-- Search trigger -->
      <button
        data-search-trigger
        type="button"
        aria-label={isKo ? '검색 열기 (/)' : 'Open search (/)'}
        class="p-1.5 rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <LanguageToggle />
      <ThemeToggle />

      <!-- Mobile hamburger (md-: visible) -->
      <details class="relative md:hidden">
        <summary
          class="list-none p-1.5 rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] cursor-pointer hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
          aria-label={isKo ? '메뉴 열기' : 'Open menu'}
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </summary>

        <nav
          aria-label={isKo ? '모바일 탐색' : 'Mobile navigation'}
          class="absolute right-0 top-full mt-1 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xl shadow-[var(--shadow-lg)] z-50 min-w-[180px] py-1.5 overflow-hidden"
        >
          {TOP_NAV_ITEMS.map((item) => {
            const active = currentSection === item.section;
            return (
              <a
                href={navHref(item.section)}
                aria-current={active ? 'page' : undefined}
                class={[
                  'block px-4 py-2.5 text-sm font-medium transition-colors',
                  active
                    ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)]'
                    : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
                ].join(' ')}
              >
                {isKo ? item.labelKo : item.labelEn}
              </a>
            );
          })}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Scroll-based header blur — re-attaches after every ClientRouter soft navigation
  function initHeaderScroll() {
    const header = document.getElementById('site-header');

    function updateHeader() {
      const scrolled = window.scrollY > 8;
      if (header) {
        if (scrolled) {
          header.classList.add('header-scrolled');
          header.style.borderBottomColor = 'transparent';
        } else {
          header.classList.remove('header-scrolled');
          header.style.borderBottomColor = '';
        }
      }
    }

    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }

  document.addEventListener('astro:page-load', initHeaderScroll);
</script>
