---
/**
 * SiteHeader.astro — B4 (Phase 3 uplift)
 * Site header: sticky, backdrop-blur on scroll, max-width 1280px.
 *
 * Dark mode: .dark class (Tailwind) + [data-theme="dark"] (tokens.css) — both set by ThemeToggle.
 * Mobile: <details>/<summary> CSS-only hamburger.
 */

import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { TOP_NAV_ITEMS, SIDEBAR_SECTIONS } from '../data/navigation';

const currentUrl = Astro.url.pathname;
const segments = currentUrl.split('/').filter(Boolean);
const currentLang = (['ko', 'en'].includes(segments[0])) ? segments[0] : 'ko';
const isKo = currentLang === 'ko';
const currentSection = segments[1] ?? '';

// R-11: Find the sidebar section matching the current section (for mobile sub-nav)
const currentSidebarSection = SIDEBAR_SECTIONS.find((s) => s.id === currentSection) ?? null;

function navHref(section: string): string {
  return `/${currentLang}/${section}/`;
}
---

<header
  id="site-header"
  class="site-header sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)] py-0 transition-[background-color,border-color,backdrop-filter] duration-200"
>
  <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">

    <!-- Site logo / wordmark -->
    <a
      href={`/${currentLang}/`}
      class="site-logo font-bold text-sm text-[var(--color-accent)] shrink-0 tracking-tight hover:opacity-80 transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      transition:name="site-logo"
    >
      {isKo ? '기후시민회의 Wiki' : 'Korea Climate Assembly Wiki'}
    </a>

    <!-- Desktop nav (md+) -->
    <nav
      aria-label={isKo ? '주요 탐색' : 'Main navigation'}
      class="hidden md:flex items-center gap-0.5 text-sm"
    >
      {TOP_NAV_ITEMS.map((item) => {
        const active = currentSection === item.section;
        const href = item.href ?? navHref(item.section);
        const targetAttrs = item.external ? { target: '_blank', rel: 'noopener' } : {};
        if (item.children?.length) {
          return (
            <div class="relative group">
              <a
                href={href}
                {...targetAttrs}
                aria-current={active ? 'page' : undefined}
                class={[
                  'px-3 py-1.5 rounded-md font-medium transition-colors inline-flex items-center gap-1',
                  active
                    ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)] dark:bg-[var(--color-accent-muted)] dark:text-[var(--color-accent)]'
                    : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
                ].join(' ')}
              >
                {isKo ? item.labelKo : item.labelEn}
                <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </a>
              <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition z-50">
                <div class="min-w-[180px] rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-[var(--shadow-lg)] p-1.5">
                  {item.children.map((child) => {
                    const childAttrs = child.external ? { target: '_blank', rel: 'noopener' } : {};
                    return (
                      <a
                        href={child.href}
                        {...childAttrs}
                        class="block px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-accent)] transition-colors"
                      >
                        {isKo ? child.labelKo : child.labelEn}
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={href}
            {...targetAttrs}
            aria-current={active ? 'page' : undefined}
            class={[
              'px-3 py-1.5 rounded-md font-medium transition-colors',
              active
                ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)] dark:bg-[var(--color-accent-muted)] dark:text-[var(--color-accent)]'
                : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
            ].join(' ')}
          >
            {isKo ? item.labelKo : item.labelEn}
          </a>
        );
      })}
    </nav>

    <!-- Controls: search + language + theme -->
    <div class="header-controls flex items-center gap-1.5 shrink-0">

      <!-- Search trigger -->
      <button
        data-search-trigger
        type="button"
        aria-label={isKo ? '검색 열기 (/)' : 'Open search (/)'}
        class="min-w-11 min-h-11 p-2.5 rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] inline-flex items-center justify-center"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <LanguageToggle />
      <ThemeToggle />

      <!-- Mobile hamburger (md-: visible) -->
      <details class="relative md:hidden">
        <summary
          class="list-none min-w-11 min-h-11 p-2.5 rounded-md border border-[var(--color-border)] text-[var(--color-fg-muted)] cursor-pointer hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] inline-flex items-center justify-center"
          aria-label={isKo ? '메뉴 열기' : 'Open menu'}
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </summary>

        <nav
          aria-label={isKo ? '모바일 탐색' : 'Mobile navigation'}
          class="absolute right-0 top-full mt-1 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-xl shadow-[var(--shadow-lg)] z-50 min-w-[220px] py-1.5 overflow-hidden"
        >
          {TOP_NAV_ITEMS.map((item) => {
            const active = currentSection === item.section;
            const href = item.href ?? navHref(item.section);
            const targetAttrs = item.external ? { target: '_blank', rel: 'noopener' } : {};
            return (
              <>
                <a
                  href={href}
                  {...targetAttrs}
                  aria-current={active ? 'page' : undefined}
                  class={[
                    'block px-4 py-2.5 text-sm font-medium transition-colors',
                    active
                      ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)]'
                      : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
                  ].join(' ')}
                >
                  {isKo ? item.labelKo : item.labelEn}
                </a>
                {item.children?.map((child) => {
                  const childAttrs = child.external ? { target: '_blank', rel: 'noopener' } : {};
                  return (
                    <a
                      href={child.href}
                      {...childAttrs}
                      class="block px-7 py-2 text-sm text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-accent)] transition-colors"
                    >
                      {isKo ? child.labelKo : child.labelEn}
                    </a>
                  );
                })}
              </>
            );
          })}

          {/* R-11: Collapsible sub-navigation for current wiki section */}
          {currentSidebarSection && (
            <div class="border-t border-[var(--color-border)] mt-1 pt-1">
              <details class="group">
                <summary class="flex items-center justify-between px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] cursor-pointer list-none select-none hover:bg-[var(--color-bg-subtle)] transition-colors">
                  <span>{isKo ? currentSidebarSection.labelKo : currentSidebarSection.labelEn}</span>
                  <svg
                    aria-hidden="true"
                    class="w-3 h-3 transition-transform group-open:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </summary>
                <ul class="pb-1">
                  {currentSidebarSection.items.map((item) => {
                    const itemPath = segments.slice(1).join('/');
                    const active = itemPath === item.path || itemPath.startsWith(item.path + '/');
                    return (
                      <li>
                        <a
                          href={`/${currentLang}/${item.path}/`}
                          aria-current={active ? 'page' : undefined}
                          class={[
                            'block px-6 py-2 text-sm transition-colors',
                            active
                              ? 'bg-[var(--color-accent-subtle)] text-[var(--color-accent)] font-medium'
                              : 'text-[var(--color-fg-muted)] hover:bg-[var(--color-bg-subtle)] hover:text-[var(--color-fg)]',
                          ].join(' ')}
                        >
                          {isKo ? item.labelKo : item.labelEn}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            </div>
          )}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Scroll-based header blur — re-attaches after every ClientRouter soft navigation
  function initHeaderScroll() {
    const header = document.getElementById('site-header');

    function updateHeader() {
      const scrolled = window.scrollY > 8;
      if (header) {
        if (scrolled) {
          header.classList.add('header-scrolled');
          header.style.borderBottomColor = 'transparent';
        } else {
          header.classList.remove('header-scrolled');
          header.style.borderBottomColor = '';
        }
      }
    }

    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  }

  document.addEventListener('astro:page-load', initHeaderScroll);
</script>
