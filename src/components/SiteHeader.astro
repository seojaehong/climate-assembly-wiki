---
/**
 * SiteHeader.astro — B4
 * Site header with skip link, main nav, search trigger, language toggle, theme toggle.
 * (Design §3.4)
 *
 * Skip link contract: <a href="#main-content"> requires whoever renders <main>
 * to set id="main-content" on the <main> element.
 * Group C layouts (AgendaLayout, SessionLayout, etc.) MUST include id="main-content".
 *
 * Mobile: <details>/<summary> CSS-only hamburger — no JS required.
 * Breakpoint: nav collapses at <768px (md: prefix).
 */

import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { TOP_NAV_ITEMS } from '../data/navigation';

const currentUrl = Astro.url.pathname;
const segments = currentUrl.split('/').filter(Boolean);
const currentLang = (['ko', 'en'].includes(segments[0])) ? segments[0] : 'ko';
const isKo = currentLang === 'ko';

// Detect active nav section for aria-current
const currentSection = segments[1] ?? '';

function navHref(section: string): string {
  return `/${currentLang}/${section}/`;
}
---

<!-- Skip link (must be first child of <body>; placed here as first rendered element) -->
<a
  href="#main-content"
  class="skip-link sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-green-800 focus:border focus:border-green-600 focus:rounded focus:shadow"
>
  {isKo ? '본문으로 건너뛰기' : 'Skip to main content'}
</a>

<header class="site-header sticky top-0 z-40 border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 py-3 px-4">
  <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">

    <!-- Site logo / wordmark -->
    <a
      href={`/${currentLang}/`}
      class="site-logo font-bold text-base text-green-800 dark:text-green-400 shrink-0 hover:text-green-600 dark:hover:text-green-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
    >
      {isKo ? '기후시민회의 Wiki' : 'Korea Climate Assembly Wiki'}
    </a>

    <!-- Desktop nav (md+) -->
    <nav
      aria-label={isKo ? '주요 탐색' : 'Main navigation'}
      class="hidden md:flex items-center gap-1 text-sm"
    >
      {TOP_NAV_ITEMS.map((item) => {
        const active = currentSection === item.section;
        return (
          <a
            href={navHref(item.section)}
            aria-current={active ? 'page' : undefined}
            class={[
              'px-3 py-1.5 rounded transition-colors',
              active
                ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 font-medium'
                : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-green-700 dark:hover:text-green-400',
            ].join(' ')}
          >
            {isKo ? item.labelKo : item.labelEn}
          </a>
        );
      })}
    </nav>

    <!-- Controls: search + language + theme -->
    <div class="header-controls flex items-center gap-2 shrink-0">

      <!-- Search trigger button (opens Pagefind UI) -->
      <button
        data-search-trigger
        type="button"
        aria-label={isKo ? '검색 열기' : 'Open search'}
        class="p-1.5 rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 hover:border-green-500 hover:text-green-700 dark:hover:border-green-400 dark:hover:text-green-300 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
      >
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <LanguageToggle />
      <ThemeToggle />

      <!-- Mobile hamburger (md-: visible) -->
      <details class="relative md:hidden">
        <summary
          class="list-none p-1.5 rounded border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-400 cursor-pointer hover:border-green-500 hover:text-green-700 dark:hover:border-green-400 dark:hover:text-green-300 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
          aria-label={isKo ? '메뉴 열기' : 'Open menu'}
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </summary>

        <!-- Mobile dropdown nav -->
        <nav
          aria-label={isKo ? '모바일 탐색' : 'Mobile navigation'}
          class="absolute right-0 top-full mt-1 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded shadow-lg z-50 min-w-[160px] py-1"
        >
          {TOP_NAV_ITEMS.map((item) => {
            const active = currentSection === item.section;
            return (
              <a
                href={navHref(item.section)}
                aria-current={active ? 'page' : undefined}
                class={[
                  'block px-4 py-2 text-sm transition-colors',
                  active
                    ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 font-medium'
                    : 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800',
                ].join(' ')}
              >
                {isKo ? item.labelKo : item.labelEn}
              </a>
            );
          })}
        </nav>
      </details>
    </div>
  </div>
</header>
