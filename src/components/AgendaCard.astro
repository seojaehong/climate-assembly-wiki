---
/**
 * AgendaCard.astro — B6 (Phase 3 uplift)
 * Card for agenda grid — hover micro-interaction + category color coding.
 * Category mapping (기존 3종 → 색상):
 *   일반-의제 → 파랑 (감축/general)
 *   메타-의제 → 회색 (메타/governance)
 *   실행-의제 → 초록 (적응/action)
 *
 * R-05: translationStatus prop removed. Now accepts:
 *   contentStatus — trust level of the CURRENT LANGUAGE content (the KO original)
 *   enAvailable   — boolean: whether an EN translation exists
 *
 * This fixes the bug where KO cards displayed the EN translation status,
 * causing author-written Korean content to be labelled "Machine draft".
 */

import TrustBadge from './TrustBadge.astro';

interface Props {
  id: number;
  slug: string;
  title: string;
  category: '일반-의제' | '메타-의제' | '실행-의제';
  status: 'proposed' | 'discussed' | 'recommended' | 'final';
  /** Trust level of the current-language content (KO original = native/author-verified). */
  contentStatus: 'machine' | 'reviewed' | 'native' | 'author-verified';
  /** Whether an English translation is available. */
  enAvailable: boolean;
  lang: string;
}

const { id, slug, title, category, status, contentStatus, enAvailable, lang } = Astro.props;

// Category color config — full literal Tailwind classes for JIT
const categoryConfig = {
  '일반-의제': {
    pill: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
    bar: 'bg-blue-500',
    labelKo: '일반',
    labelEn: 'General',
  },
  '메타-의제': {
    pill: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300',
    bar: 'bg-slate-400',
    labelKo: '메타',
    labelEn: 'Meta',
  },
  '실행-의제': {
    pill: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
    bar: 'bg-emerald-500',
    labelKo: '실행',
    labelEn: 'Action',
  },
} as const;

// Status pills
const statusConfig = {
  proposed: {
    classes: 'border border-[var(--color-border-strong)] text-[var(--color-fg-muted)]',
    labelKo: '제안',
    labelEn: 'Proposed',
  },
  discussed: {
    classes: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
    labelKo: '논의됨',
    labelEn: 'Discussed',
  },
  recommended: {
    classes: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
    labelKo: '권고',
    labelEn: 'Recommended',
  },
  final: {
    classes: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
    labelKo: '최종',
    labelEn: 'Final',
  },
} as const;

const isKo = lang === 'ko';
const catCfg = categoryConfig[category];
const stsCfg = statusConfig[status];
const catLabel = isKo ? catCfg.labelKo : catCfg.labelEn;
const stsLabel = isKo ? stsCfg.labelKo : stsCfg.labelEn;
const idPadded = id.toString().padStart(2, '0');
---

<a
  href={`/${lang}/agenda/${slug}`}
  class="agenda-card card-interactive group block p-4 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
  transition:name={`agenda-card-${id}`}
>
  <!-- Category accent bar -->
  <div class={`h-0.5 w-8 rounded-full mb-3 transition-all duration-300 group-hover:w-12 ${catCfg.bar}`}></div>

  <!-- Top row: ID + status pill -->
  <div class="flex items-center justify-between gap-2 mb-2.5">
    <span class="text-xs font-mono text-[var(--color-fg-muted)]">#{idPadded}</span>
    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${stsCfg.classes}`}>
      {stsLabel}
    </span>
  </div>

  <!-- Title -->
  <h3 class="font-semibold text-[var(--color-fg)] text-sm leading-snug mb-3 group-hover:text-[var(--color-accent)] transition-colors">
    {title}
  </h3>

  <!-- Bottom row: category tag + content trust badge + EN indicator -->
  <div class="flex items-center flex-wrap gap-1.5 mt-auto">
    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${catCfg.pill}`}>
      {catLabel}
    </span>

    <!-- R-05: contentStatus = trust of the current-language original content -->
    <TrustBadge status={contentStatus} lang={lang} />

    {enAvailable && (
      <span
        class="text-xs px-1.5 py-0.5 rounded-md border border-[var(--color-info)] text-[var(--color-info)] dark:border-blue-600 dark:text-blue-300 font-medium"
        title={isKo ? '영문 번역 있음' : 'English available'}
        aria-label={isKo ? '영문 번역 있음' : 'English translation available'}
      >
        EN
      </span>
    )}
  </div>
</a>
