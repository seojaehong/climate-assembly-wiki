---
interface Props {
  id: number;
  title: string;
  category: string;
  status: string;
  slug: string;
  lang: string;
}

const { id, title, category, status, slug, lang } = Astro.props;

const statusColors: Record<string, string> = {
  proposed: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
  discussed: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
  recommended: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
  final: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200',
};
---
<a
  href={`/${lang}/agenda/${slug}`}
  class="block border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:border-green-500 dark:hover:border-green-400 hover:shadow transition"
>
  <div class="flex items-start justify-between gap-2">
    <span class="text-xs font-mono text-gray-400">#{id.toString().padStart(2, '0')}</span>
    <span class={`text-xs px-2 py-0.5 rounded font-medium ${statusColors[status] ?? 'bg-gray-100 text-gray-700'}`}>
      {status}
    </span>
  </div>
  <h3 class="mt-2 font-semibold text-gray-900 dark:text-gray-100">{title}</h3>
  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{category}</p>
</a>
