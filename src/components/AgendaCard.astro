---
/**
 * AgendaCard.astro — B6
 * Card for the agenda grid on the home page and agenda/ index (Design §3.6).
 *
 * Breaking change from the seed AgendaCard: adds translationStatus and hasEnglish props.
 * Call-site updates in pages/[lang]/agenda/ are handled by Group C/D agents.
 */

import TrustBadge from './TrustBadge.astro';

interface Props {
  id: number;
  slug: string;
  title: string;
  category: '일반-의제' | '메타-의제' | '실행-의제';
  status: 'proposed' | 'discussed' | 'recommended' | 'final';
  translationStatus: 'machine' | 'reviewed' | 'native' | 'author-verified';
  hasEnglish: boolean;
  lang: string;
}

const { id, slug, title, category, status, translationStatus, hasEnglish, lang } = Astro.props;

// Category colors — full literal strings required for Tailwind v4 JIT
const categoryConfig = {
  '일반-의제': {
    classes: 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300',
    labelKo: '일반',
    labelEn: 'General',
  },
  '메타-의제': {
    classes: 'bg-violet-100 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300',
    labelKo: '메타',
    labelEn: 'Meta',
  },
  '실행-의제': {
    classes: 'bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-300',
    labelKo: '실행',
    labelEn: 'Action',
  },
} as const;

// Status pills
const statusConfig = {
  proposed: {
    classes: 'border border-gray-400 text-gray-600 dark:border-gray-500 dark:text-gray-400',
    labelKo: '제안',
    labelEn: 'Proposed',
  },
  discussed: {
    classes: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300',
    labelKo: '논의됨',
    labelEn: 'Discussed',
  },
  recommended: {
    classes: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
    labelKo: '권고',
    labelEn: 'Recommended',
  },
  final: {
    classes: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
    labelKo: '최종',
    labelEn: 'Final',
  },
} as const;

const isKo = lang === 'ko';
const catCfg = categoryConfig[category];
const stsCfg = statusConfig[status];
const catLabel = isKo ? catCfg.labelKo : catCfg.labelEn;
const stsLabel = isKo ? stsCfg.labelKo : stsCfg.labelEn;
const idPadded = id.toString().padStart(2, '0');
const enLabel = isKo ? 'EN' : 'EN';
---

<a
  href={`/${lang}/agenda/${slug}`}
  class="agenda-card block border border-gray-200 dark:border-gray-700 rounded-lg p-4 hover:border-green-500 dark:hover:border-green-400 hover:shadow-md transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
>
  <!-- Top row: ID + status pill -->
  <div class="flex items-center justify-between gap-2 mb-2">
    <span class="text-xs font-mono text-gray-400 dark:text-gray-500">#{idPadded}</span>
    <span class={`text-xs px-2 py-0.5 rounded font-medium ${stsCfg.classes}`}>
      {stsLabel}
    </span>
  </div>

  <!-- Title -->
  <h3 class="font-semibold text-gray-900 dark:text-gray-100 text-sm leading-snug mb-2">
    {title}
  </h3>

  <!-- Bottom row: category tag + trust badge (small) + EN indicator -->
  <div class="flex items-center flex-wrap gap-1.5 mt-auto">
    <span class={`text-xs px-2 py-0.5 rounded font-medium ${catCfg.classes}`}>
      {catLabel}
    </span>

    <TrustBadge status={translationStatus} lang={lang} />

    {hasEnglish && (
      <span
        class="text-xs px-1.5 py-0.5 rounded border border-blue-300 text-blue-700 dark:border-blue-600 dark:text-blue-300"
        title={isKo ? '영문 번역 있음' : 'English available'}
        aria-label={isKo ? '영문 번역 있음' : 'English translation available'}
      >
        {enLabel}
      </span>
    )}
  </div>
</a>
