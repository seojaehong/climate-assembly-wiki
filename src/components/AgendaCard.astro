---
/**
 * AgendaCard.astro — B6 (Phase 3 uplift)
 * Card for agenda grid — hover micro-interaction + category color coding.
 * Category mapping (기존 3종 → 색상):
 *   일반-의제 → 파랑 (감축/general)
 *   메타-의제 → 회색 (메타/governance)
 *   실행-의제 → 초록 (적응/action)
 *
 * R-05: translationStatus prop removed. Now accepts:
 *   contentStatus — trust level of the CURRENT LANGUAGE content (the KO original)
 *   enAvailable   — boolean: whether an EN translation exists
 *
 * This fixes the bug where KO cards displayed the EN translation status,
 * causing author-written Korean content to be labelled "Machine draft".
 */

import TrustBadge from './TrustBadge.astro';
import { contentUiCopy } from '../lib/site-locales';

interface Props {
  id: number;
  slug: string;
  title: string;
  category: '일반-의제' | '메타-의제' | '실행-의제';
  status: 'proposed' | 'discussed' | 'recommended' | 'final';
  /** Trust level of the current-language content (KO original = native/author-verified). */
  contentStatus: 'machine' | 'reviewed' | 'native' | 'author-verified';
  /** Whether an English translation is available. */
  enAvailable: boolean;
  lang: string;
  /** Marks legacy agenda briefs as internal drafts, not source-backed records. */
  sourceMode?: 'standard' | 'internal-draft';
}

const {
  id,
  slug,
  title,
  category,
  status,
  contentStatus,
  enAvailable,
  lang,
  sourceMode = 'standard',
} = Astro.props;

// R-16: Category color config now uses CSS custom properties (tokens.css)
// instead of raw Tailwind color classes. Enables dark-mode + theming control.
const categoryConfig = {
  '일반-의제': {
    pillStyle: 'background:var(--color-cat-general-bg);color:var(--color-cat-general-fg)',
    barStyle: 'background:var(--color-cat-general-bar)',
    copyKey: 'general',
  },
  '메타-의제': {
    pillStyle: 'background:var(--color-cat-meta-bg);color:var(--color-cat-meta-fg)',
    barStyle: 'background:var(--color-cat-meta-bar)',
    copyKey: 'meta',
  },
  '실행-의제': {
    pillStyle: 'background:var(--color-cat-action-bg);color:var(--color-cat-action-fg)',
    barStyle: 'background:var(--color-cat-action-bar)',
    copyKey: 'action',
  },
} as const;

// Status pills
const statusConfig = {
  proposed: {
    classes: 'border border-[var(--color-border-strong)] text-[var(--color-fg-muted)]',
  },
  discussed: {
    classes: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300',
  },
  recommended: {
    classes: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  },
  final: {
    classes: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
  },
} as const;

const copy = contentUiCopy(lang);
const catCfg = categoryConfig[category];
const stsCfg = statusConfig[status];
const catLabel = copy.agendaCategory[catCfg.copyKey];
const stsLabel = copy.agendaStatus[status];
const idPadded = id.toString().padStart(2, '0');
const isInternalDraft = sourceMode === 'internal-draft';
---

<a
  href={`/${lang}/agenda/${slug}`}
  class="agenda-card card-interactive group block p-4 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
  transition:name={`agenda-card-${id}`}
>
  <!-- R-16: Category accent bar — h-1 w-10 (4px×40px) for better visibility vs prior h-0.5 w-8 (2px×32px) -->
  <div
    class="h-1 w-10 rounded-full mb-3 transition-all duration-300 group-hover:w-14"
    style={catCfg.barStyle}
  ></div>

  <!-- Top row: ID + status pill -->
  <div class="flex items-center justify-between gap-2 mb-2.5">
    <span class="text-xs font-mono text-[var(--color-fg-muted)]">#{idPadded}</span>
    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${stsCfg.classes}`}>
      {stsLabel}
    </span>
  </div>

  <!-- Title -->
  <h3 class="font-semibold text-[var(--color-fg)] text-sm leading-snug mb-3 group-hover:text-[var(--color-accent)] transition-colors">
    {title}
  </h3>

  <!-- Bottom row: category tag + content/source badge + EN indicator -->
  <div class="flex items-center flex-wrap gap-1.5 mt-auto">
    <!-- R-16: pill uses CSS token vars instead of raw Tailwind color classes -->
    <span class="text-xs px-2 py-0.5 rounded-full font-medium" style={catCfg.pillStyle}>
      {catLabel}
    </span>

    {isInternalDraft ? (
      <span
        class="text-xs px-2 py-0.5 rounded-md border border-amber-400/70 text-amber-700 bg-amber-50 dark:border-amber-500/60 dark:text-amber-200 dark:bg-amber-950/40 font-medium"
        title={copy.internalBriefDescription}
      >
        {copy.internalBriefDraft}
      </span>
    ) : (
      <!-- R-05: contentStatus = trust of the current-language original content -->
      <TrustBadge status={contentStatus} lang={lang} />
    )}

    {enAvailable && (
      <span
        class="text-xs px-1.5 py-0.5 rounded-md border border-[var(--color-info)] text-[var(--color-info)] dark:border-blue-600 dark:text-blue-300 font-medium"
        title={copy.englishAvailable}
        aria-label={copy.englishTranslationAvailable}
      >
        EN
      </span>
    )}
  </div>
</a>
