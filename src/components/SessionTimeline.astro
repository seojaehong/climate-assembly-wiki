---
interface SessionItem {
  date: string;
  slug: string;
  title: string;
  session_type: string;
  speaker?: string;
  affiliation?: string;
}

interface Props {
  sessions: SessionItem[];
  lang: string;
}

const { sessions, lang } = Astro.props;

const sorted = [...sessions].sort((a, b) => a.date.localeCompare(b.date));

const typeIcons: Record<string, string> = {
  kickoff: '🚀',
  lecture: '📖',
  discussion: '💬',
  recommendation: '✅',
  event: '📅',
  closing: '🎉',
};
---
<ol class="relative border-l border-gray-300 dark:border-gray-700 ml-4 space-y-6">
  {sorted.map((s) => (
    <li class="ml-6">
      <span class="absolute -left-3 flex h-6 w-6 items-center justify-center rounded-full bg-green-100 dark:bg-green-900 text-sm">
        {typeIcons[s.session_type] ?? '📌'}
      </span>
      <time class="text-xs text-gray-400">{s.date}</time>
      <a
        href={`/${lang}/session/${s.date}`}
        class="block mt-1 font-medium text-gray-900 dark:text-gray-100 hover:text-green-700 dark:hover:text-green-400"
      >
        {s.title}
      </a>
      {s.speaker && (
        <p class="text-xs text-gray-500">
          {s.speaker}{s.affiliation ? ` · ${s.affiliation}` : ''}
        </p>
      )}
    </li>
  ))}
</ol>
