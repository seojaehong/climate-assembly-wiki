---
/**
 * TranslationFallbackBanner.astro — B9
 * Shown when an EN page falls back to KO content via Astro i18n fallbackType:'rewrite'.
 * The URL remains at /en/... (not redirected), so this banner fires correctly (Design §1.3, §3.9).
 *
 * R-13: Enhanced from single-sentence to 3-element MDN-style banner:
 *   1. Policy explanation — why you see Korean (showcase policy, not a gap)
 *   2. Direct link to the Korean original of THIS page (not the home)
 *   3. Translation contribution CTA → GitHub issues
 *
 * Placement: above main content in page layouts, rendered only when targetLang !== 'ko'.
 */

const REPO = 'https://github.com/seojaehong/climate-assembly-wiki';

interface Props {
  /** The language that was requested but has no translation (e.g. 'en') */
  targetLang: string;
  /** The current page path (used to build the KO original link). */
  currentPath?: string;
}

const { targetLang, currentPath } = Astro.props;

// Build the KO equivalent of the current page
const koPath = currentPath
  ? currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/ko$1')
  : '/ko/';
---

<div
  role="alert"
  class="fallback-banner rounded-lg px-4 py-4 text-sm mb-6"
  style="background: var(--color-warn-bg); border: 1px solid var(--color-warn); color: var(--color-fg);"
>
  <div class="flex gap-3">
    <span aria-hidden="true" class="text-base shrink-0 mt-0.5">⚠</span>
    <div class="space-y-2">
      <!-- 1. Policy explanation -->
      <p>
        <strong>This page is not yet translated into English.</strong>
        {' '}You are viewing the Korean original — this is our
        <em>showcase policy</em>: real content is always better than an empty page.
      </p>

      <!-- 2. KO original direct link -->
      <p>
        Read the Korean original:
        {' '}
        <a
          href={koPath}
          class="font-semibold underline hover:opacity-80 transition-opacity"
          style="color: var(--color-accent);"
          lang="ko"
        >
          한국어 원문 보기 →
        </a>
      </p>

      <!-- 3. Translation contribution CTA -->
      <p class="text-xs" style="color: var(--color-fg-muted);">
        Want to contribute a translation?
        {' '}
        <a
          href={`${REPO}/issues/new`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:opacity-80 transition-opacity"
          style="color: var(--color-accent);"
        >
          Open a GitHub issue →
        </a>
      </p>
    </div>
  </div>
</div>
