---
/**
 * TranslationFallbackBanner.astro — B9
 * Shown when an EN page falls back to KO content via Astro i18n fallbackType:'rewrite'.
 * The URL remains at /en/... (not redirected), so this banner fires correctly (Design §1.3, §3.9).
 *
 * R-13: Enhanced from single-sentence to 3-element MDN-style banner:
 *   1. Policy explanation — why you see Korean (showcase policy, not a gap)
 *   2. Direct link to the Korean original of THIS page (not the home)
 *   3. Translation contribution CTA → GitHub issues
 *
 * Placement: above main content in page layouts, rendered only when targetLang !== 'ko'.
 */

const REPO = 'https://github.com/seojaehong/climate-assembly-wiki';

interface Props {
  /** The language that was requested but has no translation (e.g. 'en') */
  targetLang: string;
  /** The current page path (used to build the KO original link). */
  currentPath?: string;
}

const { targetLang, currentPath } = Astro.props;

// Build the KO equivalent of the current page
const koPath = currentPath
  ? currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/ko$1')
  : '/ko/';
// EN equivalent of the current page (used for ja/zh/es structural banner)
const enPath = currentPath
  ? currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/en$1')
  : '/en/';

// M4 (2026-06-01): ja/zh/es are structural-only locales.
// They serve EN/KO content but exist for SEO/hreflang/shared-link discoverability.
// Render a distinct promotional banner instead of the EN translation-fallback copy.
const isStructuralLocale = ['ja', 'zh', 'es'].includes(targetLang);

// Localized banner copy for structural locales (ja/zh/es).
// LLM 2-pass draft (2026-06-01). Native review pending.
type StructuralCopy = {
  title: string;
  body: string;
  viewIn: string;
  koLabel: string;
  enLabel: string;
  contribute: string;
  cta: string;
  dismiss: string;
};
const structuralCopy: Record<string, StructuralCopy> = {
  ja: {
    title: 'この言語版は構造のみの提供です。',
    body: '日本語への本文翻訳は進行中です。以下の本文は英語(または韓国語)でフォールバック表示されます。',
    viewIn: 'このページを次の言語で表示:',
    koLabel: '韓国語 (한국어)',
    enLabel: '英語 (English)',
    contribute: '翻訳にご協力いただけますか?',
    cta: 'GitHub Issue を作成 →',
    dismiss: '閉じる',
  },
  zh: {
    title: '本语言版本仅提供结构框架。',
    body: '中文正文翻译正在进行中。下方正文将以英文(或韩文)作为回退显示。',
    viewIn: '以其他语言查看本页:',
    koLabel: '韩文 (한국어)',
    enLabel: '英文 (English)',
    contribute: '希望协助翻译?',
    cta: '在 GitHub 上提交 Issue →',
    dismiss: '关闭',
  },
  es: {
    title: 'Esta versión de idioma es solo estructural.',
    body: 'La traducción completa al español está en curso. El texto del cuerpo se muestra a continuación en inglés (o coreano) como alternativa.',
    viewIn: 'Ver esta página en:',
    koLabel: 'coreano (한국어)',
    enLabel: 'inglés (English)',
    contribute: '¿Quiere ayudar con la traducción?',
    cta: 'Abrir un issue en GitHub →',
    dismiss: 'Cerrar',
  },
};
const copy: StructuralCopy = structuralCopy[targetLang] ?? structuralCopy.es;
---

{isStructuralLocale ? (
  <div
    role="alert"
    class="fallback-banner structural-locale-banner rounded-lg px-4 py-4 text-sm mb-6 flex items-start gap-3"
    style="background: var(--color-info-bg); border: 1px solid var(--color-info); color: var(--color-fg);"
    data-dismissable
  >
    <span aria-hidden="true" class="text-base shrink-0 mt-0.5">🌐</span>
    <div class="space-y-2 flex-1 min-w-0">
      <p>
        <strong>{copy.title}</strong>
        {' '}{copy.body}
      </p>
      <p class="text-xs" style="color: var(--color-fg-muted);">
        {copy.viewIn}
        {' '}<a href={koPath} class="font-semibold underline hover:opacity-80" style="color: var(--color-accent);" lang="ko">{copy.koLabel}</a>
        {' '} · {' '}
        <a href={enPath} class="font-semibold underline hover:opacity-80" style="color: var(--color-accent);" lang="en">{copy.enLabel}</a>
      </p>
      <p class="text-xs" style="color: var(--color-fg-muted);">
        {copy.contribute}
        {' '}
        <a href={`${REPO}/issues/new?labels=translation,${targetLang}`} target="_blank" rel="noopener noreferrer" class="underline hover:opacity-80" style="color: var(--color-accent);">
          {copy.cta}
        </a>
      </p>
    </div>
    <button
      type="button"
      aria-label={copy.dismiss}
      class="shrink-0 text-base opacity-60 hover:opacity-100 transition-opacity"
      onclick="this.parentElement?.remove()"
    >✕</button>
  </div>
) : (

<div
  role="alert"
  class="fallback-banner rounded-lg px-4 py-4 text-sm mb-6"
  style="background: var(--color-warn-bg); border: 1px solid var(--color-warn); color: var(--color-fg);"
>
  <div class="flex gap-3">
    <span aria-hidden="true" class="text-base shrink-0 mt-0.5">⚠</span>
    <div class="space-y-2">
      <!-- 1. Policy explanation -->
      <p>
        <strong>This page is not yet translated into English.</strong>
        {' '}You are viewing the Korean original — this is our
        <em>showcase policy</em>: real content is always better than an empty page.
      </p>

      <!-- 2. KO original direct link -->
      <p>
        Read the Korean original:
        {' '}
        <a
          href={koPath}
          class="font-semibold underline hover:opacity-80 transition-opacity"
          style="color: var(--color-accent);"
          lang="ko"
        >
          한국어 원문 보기 →
        </a>
      </p>

      <!-- 3. Translation contribution CTA -->
      <p class="text-xs" style="color: var(--color-fg-muted);">
        Want to contribute a translation?
        {' '}
        <a
          href={`${REPO}/issues/new`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:opacity-80 transition-opacity"
          style="color: var(--color-accent);"
        >
          Open a GitHub issue →
        </a>
      </p>
    </div>
  </div>
</div>
)}
