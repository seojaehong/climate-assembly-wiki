---
/**
 * TrustBadge.astro — B1
 * Renders a trust/translation-status badge (Design §3.1 + D5).
 *
 * 4-tier visual system:
 *   machine        → Amber  ⚠  "기계 초안 / Machine draft"
 *   reviewed       → Blue   ◉  "LLM 검토 / LLM-reviewed"
 *   native         → Emerald outline  ✓  "원어민 검증 / Native-verified"
 *   author-verified → Emerald filled  ✓✓ "저자 검증 / Author-verified"
 *
 * R-06: labelKo now uses proper Korean labels
 * R-07: native = outline style, author-verified = filled style (visually distinct)
 */

import { contentUiCopy, type TrustStatus } from '../lib/site-locales';

interface Props {
  status: TrustStatus;
  /** Display language for label text. Defaults to Astro's current locale. */
  lang?: string;
}

const { status, lang = 'ko' } = Astro.props;

// Tailwind classes MUST be complete literal strings (Tailwind v4 JIT cannot see interpolations)
const CONFIG = {
  machine: {
    // R-badge: bg=#fef3c7 fg=#92400e → 7.5:1 light; bg=#1c1400 fg=#fbbf24 → 7.3:1 dark
    classes: 'border',
    style: 'background-color:var(--color-warn-bg);color:var(--color-warn-fg);border-color:var(--color-warn);',
    icon: '⚠',
  },
  reviewed: {
    classes: 'bg-blue-100 text-blue-800 border border-blue-300 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-600',
    icon: '◉',
  },
  native: {
    // R-07: outline style — border-only, no fill background
    classes: 'bg-transparent text-emerald-700 border-2 border-emerald-600 dark:text-emerald-300 dark:border-emerald-500',
    icon: '✓',
  },
  'author-verified': {
    // R-07: filled style — solid emerald background
    classes: 'bg-emerald-600 text-white border border-emerald-600 font-semibold dark:bg-emerald-700 dark:border-emerald-500 dark:text-white',
    icon: '✓✓',
  },
} as const;

const cfg = CONFIG[status];
const copy = contentUiCopy(lang).trust[status];
const badgeStyle = 'style' in cfg ? (cfg as { style: string }).style : undefined;
---

<span
  class={`trust-badge trust-badge--${status} inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded ${cfg.classes}`}
  style={badgeStyle}
  role="img"
  aria-label={copy.ariaLabel}
>
  <span aria-hidden="true">{cfg.icon}</span>
  {copy.label}
</span>
