---
interface Props {
  currentLang: string;
}

import { SITE_LOCALES, isSiteLocale, replaceLocalePrefix } from '../lib/site-locales';

const { currentLang } = Astro.props;

const langs = SITE_LOCALES;

// Swap the lang segment in the URL while preserving the rest of the path.
// e.g. /ko/agenda/climate-dividend → /en/agenda/climate-dividend
const currentUrl = Astro.url.pathname;
function buildUrl(targetLang: string): string {
  if (!isSiteLocale(targetLang)) return currentUrl;
  return replaceLocalePrefix(currentUrl, targetLang);
}
---
<div class="relative group">
  <button class="text-xs px-2 py-1 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-800">
    {langs.find(l => l.code === currentLang)?.label ?? currentLang}
    ▾
  </button>
  <ul class="absolute right-0 top-full mt-1 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded shadow-lg hidden group-hover:block z-50 min-w-[8rem]">
    {langs.map((l) => (
      <li>
        <a
          href={buildUrl(l.code)}
          class={`block px-3 py-1.5 text-xs hover:bg-gray-100 dark:hover:bg-gray-800 ${l.code === currentLang ? 'font-bold text-green-700 dark:text-green-400' : ''}`}
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</div>
