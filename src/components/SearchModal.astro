---
/**
 * SearchModal.astro — M2-1
 * Modal search overlay built with native <dialog> element.
 * Wires to the existing `data-search-trigger` button in SiteHeader.
 *
 * Features:
 *   - Opens via SiteHeader's [data-search-trigger] button
 *   - `/` keyboard shortcut (globally, guarded against input fields)
 *   - Escape key / backdrop click → closes
 *   - Pagefind UI renders inside the dialog
 *   - Keyword highlight via Pagefind's built-in mark.mark-highlight
 *   - Category label chips shown from Pagefind's sub_results
 *
 * Props:
 *   lang — current page language
 */

interface Props {
  lang: string;
}

import { siteShellCopy } from '../lib/site-locales';

const { lang } = Astro.props;

const shellCopy = siteShellCopy(lang);
const placeholder = shellCopy.searchPlaceholder;
const closeLabel = shellCopy.searchClose;
const searchLabel = shellCopy.searchLabel;
const searchUnavailable = shellCopy.searchIndexUnavailable;
---

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

<!-- Search modal dialog -->
<dialog
  id="search-modal"
  class="search-modal fixed inset-0 z-50 m-auto w-full max-w-2xl rounded-xl border border-[var(--color-border)] bg-white dark:bg-gray-900 shadow-2xl p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  aria-label={searchLabel}
>
  <!-- Modal header -->
  <div class="flex items-center gap-3 border-b border-[var(--color-border)] px-4 py-3">
    <svg
      aria-hidden="true"
      class="w-4 h-4 shrink-0 text-[var(--color-muted)]"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>

    <!-- Pagefind search input is rendered inside #pagefind-modal-ui below -->
    <span class="text-sm text-[var(--color-muted)] flex-1">{placeholder}</span>

    <button
      id="search-modal-close"
      type="button"
      aria-label={closeLabel}
      class="p-1 rounded text-[var(--color-muted)] hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 transition-colors"
    >
      <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Pagefind UI mount point -->
  <div id="pagefind-modal-ui" class="px-4 py-3 min-h-[200px] max-h-[70vh] overflow-y-auto">
    <!-- Pagefind UI injected by script below -->
  </div>

  <!-- Footer hint -->
  <div class="flex items-center gap-4 border-t border-[var(--color-border)] px-4 py-2 text-xs text-[var(--color-muted)]">
    <span><kbd class="px-1.5 py-0.5 rounded border border-current font-mono">↑↓</kbd> {shellCopy.searchNavigate}</span>
    <span><kbd class="px-1.5 py-0.5 rounded border border-current font-mono">Enter</kbd> {shellCopy.searchOpen}</span>
    <span><kbd class="px-1.5 py-0.5 rounded border border-current font-mono">Esc</kbd> {shellCopy.searchClose}</span>
    <span class="ml-auto">
      <kbd class="px-1.5 py-0.5 rounded border border-current font-mono">/</kbd> {shellCopy.searchShortcut}
    </span>
  </div>
</dialog>

<script define:vars={{ lang, placeholder, searchUnavailable }}>
  (function () {
    const dialog = document.getElementById('search-modal');
    const closeBtn = document.getElementById('search-modal-close');
    const mountEl = document.getElementById('pagefind-modal-ui');

    if (!dialog || !mountEl) return;

    let pagefindLoaded = false;
    let pagefindLoadPromise = null;

    function loadPagefindBundle() {
      if (typeof window.PagefindUI === 'function') return Promise.resolve();
      if (pagefindLoadPromise) return pagefindLoadPromise;

      pagefindLoadPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-pagefind-ui]');
        existing?.remove();

        const script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.async = true;
        script.dataset.pagefindUi = 'true';
        script.addEventListener('load', () => resolve(), { once: true });
        script.addEventListener('error', () => {
          script.remove();
          reject(new Error('Pagefind UI bundle failed to load'));
        }, { once: true });
        document.head.appendChild(script);
      });

      return pagefindLoadPromise;
    }

    async function loadPagefind() {
      if (pagefindLoaded) return;

      try {
        await loadPagefindBundle();
        const PagefindUI = window.PagefindUI;
        if (typeof PagefindUI !== 'function') {
          throw new Error('PagefindUI global was not registered');
        }
        new PagefindUI({
          element: '#pagefind-modal-ui',
          showImages: false,
          excerptLength: 25,
          highlightParam: 'highlight',
          placeholder,
          translations: lang === 'ko' ? {
            placeholder: '검색어를 입력하세요',
            clear_search: '초기화',
            load_more: '더 보기',
            search_label: '이 사이트 검색',
            filters_label: '필터',
            zero_results: '"[SEARCH_TERM]"에 대한 결과 없음',
            many_results: '"[SEARCH_TERM]"에 대한 [COUNT]개 결과',
            one_result: '"[SEARCH_TERM]"에 대한 1개 결과',
            alt_search: '"[SEARCH_TERM]" 대신 "[DIFFERENT_TERM]" 검색됨',
            search_suggestion: '"[DIFFERENT_TERM]"을(를) 검색하겠습니까?',
            searching: '검색 중…',
          } : undefined,
        });
        pagefindLoaded = true;
      } catch (error) {
        pagefindLoadPromise = null;
        console.error('[search] Failed to load Pagefind UI', error);
        mountEl.innerHTML =
          '<p class="text-sm text-center py-8 text-gray-400">' +
          searchUnavailable +
          '</p>';
      }
    }

    function openModal() {
      loadPagefind();
      dialog.showModal();
      // Focus the pagefind input after a tick
      setTimeout(() => {
        const input = mountEl.querySelector('input[type="text"]');
        if (input instanceof HTMLElement) input.focus();
      }, 50);
    }

    function closeModal() {
      dialog.close();
    }

    // SiteHeader trigger button
    document.querySelectorAll('[data-search-trigger]').forEach((btn) => {
      btn.addEventListener('click', openModal);
    });

    // Close button
    closeBtn?.addEventListener('click', closeModal);

    // Backdrop click closes
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeModal();
    });

    // `/` global shortcut — guard against input/textarea/contenteditable
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/') return;
      const target = e.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement && target.isContentEditable) ||
        target instanceof HTMLSelectElement
      ) {
        return;
      }
      e.preventDefault();
      openModal();
    });
  })();
</script>

<style>
  /* Ensure backdrop renders — needed in some browsers */
  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(4px);
  }

  /* Override Pagefind UI to fit modal */
  #pagefind-modal-ui .pagefind-ui__search-input {
    border-radius: var(--radius-md);
    border-color: var(--color-border);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  #pagefind-modal-ui .pagefind-ui__result-link {
    color: var(--color-link);
  }

  mark.highlight,
  #pagefind-modal-ui mark {
    background-color: #fef08a;
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
