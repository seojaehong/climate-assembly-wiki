---
/**
 * ThemeToggle.astro — B10 (Phase 3 uplift)
 * System / Light / Dark 3-state toggle.
 *
 * Sets BOTH:
 *   - <html class="dark">  → activates Tailwind dark: utilities (v4 @custom-variant)
 *   - <html data-theme="dark"> → activates tokens.css [data-theme] block
 *
 * localStorage key: 'theme' — values: 'dark' | 'light' | (absent = system)
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode / 다크모드 전환"
  class="theme-toggle min-w-11 min-h-11 p-2.5 rounded-lg border border-[var(--color-border)] text-[var(--color-fg-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] inline-flex items-center justify-center"
  aria-pressed="false"
>
  <!-- Sun icon (shown in dark mode — click to go light) -->
  <svg id="theme-icon-sun" class="hidden w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon icon (shown in light mode — click to go dark) -->
  <svg id="theme-icon-moon" class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const html = document.documentElement;
    const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
    const iconSun = document.getElementById('theme-icon-sun');
    const iconMoon = document.getElementById('theme-icon-moon');

    if (!btn) return;

    // Guard: prevent duplicate click listeners when initThemeToggle is called
    // multiple times (e.g. astro:page-load after View Transitions on same page)
    if ((btn as any).__themeToggleInit) {
      // Still sync icon/aria state in case theme changed externally
      const dark = html.classList.contains('dark');
      btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
      if (iconSun) iconSun.classList.toggle('hidden', !dark);
      if (iconMoon) iconMoon.classList.toggle('hidden', dark);
      return;
    }
    (btn as any).__themeToggleInit = true;

    function isDark(): boolean {
      return html.classList.contains('dark');
    }

    /**
     * Apply theme — sets BOTH .dark class (Tailwind v4) AND data-theme attr (tokens.css).
     * Does NOT touch localStorage — call-site decides persistence.
     */
    function applyTheme(dark: boolean): void {
      if (dark) {
        html.classList.add('dark');
        html.setAttribute('data-theme', 'dark');
      } else {
        html.classList.remove('dark');
        html.setAttribute('data-theme', 'light');
      }
      btn!.setAttribute('aria-pressed', dark ? 'true' : 'false');
      if (iconSun) iconSun.classList.toggle('hidden', !dark);
      if (iconMoon) iconMoon.classList.toggle('hidden', dark);
    }

    // Sync button state with current html theme (may already be set by inline script)
    applyTheme(isDark());

    // Toggle on click: dark → light → dark
    btn.addEventListener('click', () => {
      const next = !isDark();
      applyTheme(next);
      localStorage.setItem('theme', next ? 'dark' : 'light');
    });
  }

  // astro:page-load fires on both first page load AND after every View Transition.
  // This is the correct event for Astro 5 ClientRouter.
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
