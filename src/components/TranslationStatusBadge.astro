---
type TranslationStatus = 'machine' | 'reviewed' | 'native';

interface Props {
  status: TranslationStatus;
}

const { status } = Astro.props;

const config: Record<TranslationStatus, { icon: string; label: string; className: string }> = {
  machine: {
    icon: '⚠️',
    label: 'Machine translation',
    className: 'bg-yellow-50 text-yellow-700 border-yellow-300 dark:bg-yellow-900/30 dark:text-yellow-300',
  },
  reviewed: {
    icon: '🔵',
    label: 'Human-reviewed',
    className: 'bg-blue-50 text-blue-700 border-blue-300 dark:bg-blue-900/30 dark:text-blue-300',
  },
  native: {
    icon: '🟢',
    label: 'Native-verified',
    className: 'bg-green-50 text-green-700 border-green-300 dark:bg-green-900/30 dark:text-green-300',
  },
};

const { icon, label, className } = config[status];
---
<span class={`inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded border ${className}`}>
  {icon} {label}
</span>
