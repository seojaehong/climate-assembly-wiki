---
/**
 * LanguageToggle.astro — B3
 * Switches between ko and en using <a> tags (no-JS fallback, Design §3.3).
 *
 * Renders every locale from the central registry.
 * The active language is highlighted with aria-current="true".
 *
 * client:load note: this is a pure .astro component using <a> tags.
 * No framework island is needed; the links resolve with zero JS.
 */

import { SITE_LOCALES, isSiteLocale, replaceLocalePrefix } from '../lib/site-locales';

// Detect the current lang from the URL path segment
const currentUrl = Astro.url.pathname;
const segments = currentUrl.split('/').filter(Boolean);
const currentLang = isSiteLocale(segments[0]) ? segments[0] : 'ko';

function buildUrl(targetLang: string): string {
  if (!isSiteLocale(targetLang)) return currentUrl;
  const replaced = replaceLocalePrefix(currentUrl, targetLang);
  return replaced.endsWith('/') ? replaced : `${replaced}/`;
}

const langs = SITE_LOCALES;
---

<nav aria-label="Language / 언어" class="language-toggle flex items-center gap-1">
  {langs.map((l) => (
    <a
      href={buildUrl(l.code)}
      hreflang={l.code}
      aria-current={l.code === currentLang ? 'true' : undefined}
      class={[
        'text-xs px-3 py-2.5 min-h-11 rounded border transition-colors inline-flex items-center',
        l.code === currentLang
          ? 'border-green-600 bg-green-600 text-white dark:border-green-400 dark:bg-green-700 dark:text-white font-semibold'
          : 'border-gray-300 text-gray-700 hover:border-green-500 hover:text-green-700 dark:border-gray-600 dark:text-gray-300 dark:hover:border-green-400 dark:hover:text-green-300',
      ].join(' ')}
    >
      {l.label}
    </a>
  ))}
</nav>

<style>
  @media (max-width: 640px) {
    .language-toggle a:not([aria-current="true"]) {
      display: none;
    }
  }
</style>
