---
/**
 * SiteFooter.astro — B8 (Phase 3 uplift)
 * Site footer with CC notice, links, and language toggle.
 */

import LanguageToggle from './LanguageToggle.astro';
import LicenseBadge from './LicenseBadge.astro';

const REPO = 'https://github.com/seojaehong/climate-assembly-wiki';

const currentUrl = Astro.url.pathname;
const segments = currentUrl.split('/').filter(Boolean);
const currentLang = (['ko', 'en'].includes(segments[0])) ? segments[0] : 'ko';
const isKo = currentLang === 'ko';
---

<footer class="site-footer border-t border-[var(--color-border)] bg-[var(--color-bg-subtle)] mt-16">
  <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Top row: logo + CC notice -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-6">
      <div>
        <p class="text-sm font-bold text-[var(--color-fg)] mb-1" style="letter-spacing: var(--tracking-snug);">
          {isKo ? '기후시민회의 Wiki' : 'Korea Climate Assembly Wiki'}
        </p>
        <div class="flex items-center gap-3">
          <LicenseBadge license="CC-BY-SA-4.0" />
          <p class="text-xs text-[var(--color-fg-muted)]">
            Korea Climate Assembly Wiki, 2026.
            {isKo ? ' 모더레이터: 서재홍.' : ' Moderator: Jaehong Seo.'}
          </p>
        </div>
      </div>
      <LanguageToggle />
    </div>

    <!-- Disclaimer -->
    <p class="text-xs text-[var(--color-fg-subtle)] mb-6" style="line-height: var(--leading-relaxed);">
      {isKo
        ? '이 사이트는 독립 아카이브로 정부 공식 발간물이 아닙니다.'
        : 'This is an independent archive, not an official government publication.'}
    </p>

    <!-- Footer nav -->
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      <a
        href={REPO}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        aria-label={isKo ? 'GitHub (새 탭)' : 'GitHub (new tab)'}
      >
        GitHub
      </a>
      {/* 2026-06-02: temporarily hidden, content private as of 2026-06-02 */}
      {/* <a href={`/${currentLang}/doc/about/`} class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors">{isKo ? '소개' : 'About'}</a> */}
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        aria-label={isKo ? 'CC BY-SA 4.0 라이선스 (새 탭)' : 'CC BY-SA 4.0 License (new tab)'}
      >
        {isKo ? '라이선스' : 'License'}
      </a>
      {/* 2026-06-02: temporarily hidden, content private as of 2026-06-02 */}
      {/* <a href={`/${currentLang}/doc/related-sites/`} class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors">{isKo ? '관련 사이트' : 'Related Sites'}</a> */}
      <a
        href={`${REPO}/issues/new`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] transition-colors"
        aria-label={isKo ? '문의 (GitHub 이슈, 새 탭)' : 'Contact via GitHub issue (new tab)'}
      >
        {isKo ? '문의' : 'Contact'}
      </a>
    </div>

  </div>
</footer>
