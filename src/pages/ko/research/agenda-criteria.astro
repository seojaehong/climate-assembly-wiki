---
/**
 * /ko/research/agenda-criteria/
 * 의제선정 기준 — 근거 기반 리서치 보고서 + 운영규정 초안 (DRAFT v1.0)
 *
 * Architecture: standalone page (not doc collection) — gives full layout control
 * for the DRAFT badge, §0 warning box, custom download sidebar, and 24px+ body text.
 * noindex=true until 은재호 자문위원 확인 완료.
 */

import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';

// ---------------------------------------------------------------------------
// Read the integrated report markdown
// ---------------------------------------------------------------------------
const reportPath = path.resolve(
  process.cwd(),
  'src', 'content-data', 'agenda-criteria-report.md'
);

let reportHtml = '';
if (fs.existsSync(reportPath)) {
  const raw = fs.readFileSync(reportPath, 'utf-8');
  reportHtml = await marked.parse(raw);
} else {
  reportHtml = '<p class="text-red-600">보고서 파일을 찾을 수 없습니다: ' + reportPath + '</p>';
}

// ---------------------------------------------------------------------------
// Source files manifest (PDFs + track .mds)
// ---------------------------------------------------------------------------
const pdfSources = [
  {
    slug: 'eunjaeho-climate-assembly-overview.pdf',
    labelKo: '기후시민회의 의의와 쟁점 (은재호)',
    labelEn: 'Climate Assembly — Significance & Issues (Eun Jaeho)',
    pages: '22p',
    ext: 'PDF',
  },
  {
    slug: 'kim-mingyeong-climate-adaptation.pdf',
    labelKo: '기후적응 주요이슈 (김민경)',
    labelEn: 'Climate Adaptation — Key Issues (Kim Mingyeong)',
    pages: '34p',
    ext: 'PDF',
  },
  {
    slug: 'yoo-jongmin-workshop-slides.pptx',
    labelKo: '기후시민회의 워크숍 발제 (유종민)',
    labelEn: 'Workshop Slides (Yoo Jongmin)',
    pages: 'PPTX',
    ext: 'PPTX',
  },
  {
    slug: 'expert-agenda-analysis-0604.pdf',
    labelKo: '전문가 의제 분석 및 세부 내용 (6.4)',
    labelEn: 'Expert Agenda Analysis & Details (Jun 4)',
    pages: '101p',
    ext: 'PDF',
  },
  {
    slug: 'planning-group-workshop-plan-0605.pdf',
    labelKo: '기획참여단 의제선정 워크숍 계획안 (6.5)',
    labelEn: 'Planning Group Workshop Plan (Jun 5)',
    pages: '5p',
    ext: 'PDF',
  },
  {
    slug: 'dongnampkwon-npo-agenda-formation-2021.pdf',
    labelKo: '동남권 NPO 의제형성 참여관찰 연구보고서 (2021)',
    labelEn: 'Dongnampkwon NPO Agenda Formation Research (2021)',
    pages: 'PDF',
    ext: 'PDF',
  },
];

const trackSources = [
  { slug: 'R1-overseas-citizen-assembly.md', labelKo: 'R1 — 해외 시민의회 의제선정', desc: '6 사례 비교 (UK·FR·IE·BE·OECD·KNOCA)' },
  { slug: 'R2-domestic-deliberation-cases.md', labelKo: 'R2 — 국내 공론화 사례', desc: '신고리·연금·대입·기후특위 5 사례' },
  { slug: 'R3-theoretical-academic-basis.md', labelKo: 'R3 — 이론·학술 근거', desc: 'Cobb&Ross·Habermas·Buchanan-Tullock 외' },
  { slug: 'R4-law-key-findings.md', labelKo: 'R4 — 법령 조항 핵심 발견', desc: '§19의2 부재 확인·§51 운영 근거' },
  { slug: 'R5-five-criteria-audit.md', labelKo: 'R5 — 5 기준 감사', desc: '15 후보 × 8 사례 매트릭스·누락 발견' },
];

const baseSrc = '/research/agenda-criteria/sources/';
const baseTracks = '/research/agenda-criteria/tracks/';

const lang = 'ko';
const title = '의제선정 기준 — 근거 기반 리서치 (DRAFT v1.1)';
const description = '해외·국내 사례·이론·법령 33 출처 기반 운영규정 조항 초안. §19의2 명문 확정 반영. 기후시민회의 기획참여단·외부자문단·KCRC 사무국 대상.';
---

<BaseLayout
  title={title}
  lang={lang}
  description={description}
  alternateLangs={['ko']}
  canonicalPath="/ko/research/agenda-criteria/"
  noindex={true}
>
  <div class="research-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- ── DRAFT / status banner ──────────────────────────────────────────── -->
    <div
      role="alert"
      class="draft-banner rounded-xl px-5 py-4 mb-8 flex flex-wrap items-start gap-4"
      style="background: var(--color-warn-bg); border: 2px solid var(--color-warn); color: var(--color-fg);"
    >
      <span
        class="draft-badge shrink-0 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-black tracking-wide"
        style="background: #b45309; color: #fffbeb; font-size: 0.95rem;"
      >
        DRAFT v1.1 (§19의2 명문 확정 반영)
      </span>
      <div style="flex: 1; min-width: 200px;">
        <p style="font-size: 1.05rem; font-weight: 600; margin: 0 0 0.3rem;">
          은재호 자문위원 확인 전 — 내부 검토용
        </p>
        <p style="font-size: 0.9rem; color: var(--color-fg-muted); margin: 0;">
          본 보고서는 외부자문단 1차 검토 완료 전이며, 인용·공개 배포 금지.
          확정 버전은 자문위원 검토 후 이 배지가 제거됩니다.
        </p>
      </div>
    </div>

    <!-- ── §0 법적 근거 — 확정 안내 (정정 v1.1) ──────────────────────────── -->
    <div
      role="note"
      class="legal-notice rounded-xl px-5 py-5 mb-6"
      style="background: #f0fdf4; border: 2px solid #16a34a; color: var(--color-fg);"
    >
      <div class="flex items-center gap-2 mb-3">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <h2 style="font-size: 1.2rem; font-weight: 800; color: #15803d; margin: 0;">
          §0. 법적 근거 — 확정 (정정 v1.1 / 2026-06-07)
        </h2>
      </div>
      <p style="font-size: 1rem; margin: 0 0 0.75rem; line-height: 1.6;">
        「기후위기 대응을 위한 탄소중립ㆍ녹색성장 기본법」 <strong>§19의2 (기후시민회의의 설치 등)</strong>
        <strong style="color: #15803d;">2026.04.07 본조신설, 시행일 2026.10.08</strong>.
      </p>
      <table class="legal-table w-full text-sm" style="border-collapse: collapse; margin-bottom: 0.75rem;">
        <thead>
          <tr style="background: rgba(22,163,74,0.08);">
            <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.3); font-size: 1rem; font-weight: 700;">일자</th>
            <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.3); font-size: 1rem; font-weight: 700;">사건</th>
            <th style="text-align: left; padding: 0.5rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.3); font-size: 1rem; font-weight: 700;">운영 근거</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top; white-space: nowrap;">2026.06.02</td>
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top;">본법 시행 (21738호 타법개정)</td>
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top;">§1-§85</td>
          </tr>
          <tr style="background: rgba(251,191,36,0.12);">
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top; white-space: nowrap; font-weight: 700;">2026.06.13</td>
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top; font-weight: 700;">1차 워크숍 (현재)</td>
            <td style="padding: 0.6rem 0.75rem; border-bottom: 1px solid rgba(22,163,74,0.15); font-size: 0.95rem; vertical-align: top;">§19의2 미시행 → <strong>§51 + §15 + §19 잠정 근거</strong></td>
          </tr>
          <tr>
            <td style="padding: 0.6rem 0.75rem; font-size: 0.95rem; vertical-align: top; white-space: nowrap; font-weight: 700; color: #15803d;">2026.10.08</td>
            <td style="padding: 0.6rem 0.75rem; font-size: 0.95rem; vertical-align: top; font-weight: 700; color: #15803d;">§19의2 정식 시행</td>
            <td style="padding: 0.6rem 0.75rem; font-size: 0.95rem; vertical-align: top; color: #15803d;">법률 명문 발효 — 본 운영규정 적용</td>
          </tr>
        </tbody>
      </table>
      <p style="margin: 0; font-size: 0.9rem; color: #166534; font-weight: 600;">
        본 운영규정은 §19의2 시행일 2026.10.08 이후 적용. 6.13 워크숍은 §19의2 시행 <em>전</em> — §51·§15·§19 잠정 근거 (부속서 [잠정 운영 규칙]).
      </p>
    </div>

    <!-- ── §19의2 본문 5항 인용 박스 ────────────────────────────────────────── -->
    <div
      role="note"
      class="law-quote-box rounded-xl px-5 py-5 mb-8"
      style="background: #fffbeb; border: 2px solid #d97706; color: var(--color-fg);"
    >
      <div class="flex items-center gap-2 mb-3">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        <h3 style="font-size: 1.05rem; font-weight: 800; color: #92400e; margin: 0;">
          탄소중립기본법 §19의2 전문 — 2026.04.07 본조신설, 시행일 2026.10.08
        </h3>
      </div>
      <ol style="margin: 0; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <li style="font-size: 1rem; line-height: 1.6;">
          위원회는 시민들이 기후위기 대응 등 국가정책과 관련한 사항을 학습하고 토론하여 모아진 의견을 정부에 제안하는 <strong>기후시민회의</strong>를 둔다.
        </li>
        <li style="font-size: 1rem; line-height: 1.6;">
          기후시민회의는 <strong>전국민 대표성</strong> 확보를 위하여 지역, 성, 연령 등을 고려하여 구성한다.
        </li>
        <li style="font-size: 1rem; line-height: 1.6;">
          기후시민회의는 <strong>토론 결과를 위원회에 보고</strong>하여야 한다.
        </li>
        <li style="font-size: 1rem; line-height: 1.6; background: rgba(217,119,6,0.1); border-radius: 6px; padding: 0.4rem 0.6rem; margin-left: -0.6rem;">
          <strong>위원회는 [...] 기후시민회의의 의견을 최대한 반영하도록 하여야 한다.</strong>
          <span style="display: inline-block; margin-left: 0.5rem; font-size: 0.82rem; background: #b45309; color: #fffbeb; padding: 0.1rem 0.45rem; border-radius: 3px; font-weight: 700; vertical-align: middle;">Macron CCC급 강력 권한</span>
        </li>
        <li style="font-size: 1rem; line-height: 1.6;">
          기후시민회의의 구성과 운영 등에 필요한 사항은 <strong>대통령령으로 정한다</strong>. <span style="font-size: 0.85rem; color: #92400e;">(본 운영규정이 시행령 입법 정보 입력 가능)</span>
        </li>
      </ol>
    </div>

    <!-- ── Two-column layout: main content + right sidebar ────────────────── -->
    <div class="research-layout" style="display: flex; gap: 2.5rem; align-items: flex-start;">

      <!-- ── Main content ─────────────────────────────────────────────────── -->
      <article class="research-body" style="flex: 1; min-width: 0;">
        <div class="research-prose" set:html={reportHtml} />
      </article>

      <!-- ── Right sidebar: downloads ────────────────────────────────────── -->
      <aside
        class="research-sidebar"
        aria-label="다운로드 자료"
        style="width: 280px; flex-shrink: 0; position: sticky; top: 5rem;"
      >

        <!-- 5 tracks -->
        <div class="sidebar-section" style="margin-bottom: 1.5rem;">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--color-fg); margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-accent);">
            5 트랙 리서치
          </h3>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {trackSources.map((t) => (
              <li>
                <a
                  href={baseTracks + t.slug}
                  download
                  class="track-link"
                  style="display: flex; flex-direction: column; gap: 0.2rem; padding: 0.6rem 0.75rem; border-radius: var(--radius-sm); background: var(--color-bg-subtle); border: 1px solid var(--color-border); text-decoration: none; transition: background var(--transition-fast);"
                >
                  <span style="font-size: 0.9rem; font-weight: 600; color: var(--color-accent);">{t.labelKo}</span>
                  <span style="font-size: 0.78rem; color: var(--color-fg-muted);">{t.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 6 PDFs -->
        <div class="sidebar-section">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--color-fg); margin: 0 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-accent);">
            원본 참고자료
          </h3>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem;">
            {pdfSources.map((p) => (
              <li>
                <a
                  href={baseSrc + p.slug}
                  download
                  class="pdf-link"
                  style="display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.6rem 0.75rem; border-radius: var(--radius-sm); background: var(--color-bg-subtle); border: 1px solid var(--color-border); text-decoration: none; transition: background var(--transition-fast);"
                >
                  <span
                    style={`flex-shrink: 0; font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.4rem; border-radius: 3px; margin-top: 1px; ${p.ext === 'PDF' ? 'background: #dc2626; color: #fff;' : 'background: #1d4ed8; color: #fff;'}`}
                  >{p.ext}</span>
                  <div>
                    <span style="font-size: 0.85rem; font-weight: 500; color: var(--color-fg); display: block; line-height: 1.3;">{p.labelKo}</span>
                    {p.pages && p.pages !== p.ext && (
                      <span style="font-size: 0.75rem; color: var(--color-fg-muted);">{p.pages}</span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- metadata -->
        <div style="margin-top: 1.25rem; padding: 0.75rem; background: var(--color-bg-subtle); border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
          <p style="font-size: 0.78rem; color: var(--color-fg-muted); margin: 0 0 0.3rem;">작성일: 2026-06-07</p>
          <p style="font-size: 0.78rem; color: var(--color-fg-muted); margin: 0 0 0.3rem;">출처: 33건 1차 사료 기반</p>
          <p style="font-size: 0.78rem; color: var(--color-fg-muted); margin: 0;">
            라이선스: 내부 검토용 (확정 후 CC-BY-SA-4.0)
          </p>
        </div>

      </aside>

    </div>
  </div>
</BaseLayout>

<style>
/* ── Research body typography — 200명 가시성 기준 ──────────────────────────── */
.research-prose {
  font-family: var(--font-body);
  color: var(--color-fg);
  line-height: 1.7;
}

/* All body text minimum 20px */
.research-prose p,
.research-prose li,
.research-prose td,
.research-prose th {
  font-size: 1.125rem; /* 18px — prose base */
  line-height: 1.7;
}

/* H1 — suppressed from Markdown render (title is shown in banner) */
.research-prose h1:first-child {
  display: none;
}

/* Section headings */
.research-prose h1 {
  font-size: 2.25rem;  /* 36px */
  font-weight: 800;
  color: var(--color-fg);
  margin: 2.5rem 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--color-border);
  line-height: 1.2;
}
.research-prose h2 {
  font-size: 1.875rem; /* 30px */
  font-weight: 700;
  color: var(--color-fg);
  margin: 2rem 0 0.875rem;
  line-height: 1.25;
}
.research-prose h3 {
  font-size: 1.5rem;   /* 24px */
  font-weight: 700;
  color: var(--color-fg);
  margin: 1.5rem 0 0.75rem;
}
.research-prose h4 {
  font-size: 1.25rem;  /* 20px */
  font-weight: 600;
  color: var(--color-fg);
  margin: 1.25rem 0 0.5rem;
}

/* Table */
.research-prose table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5rem 0;
  font-size: 1rem; /* 16px min for tables — 200명 view, table rows at viewing distance */
  overflow-x: auto;
  display: block;
}
.research-prose thead tr {
  background: var(--color-bg-subtle);
}
.research-prose th {
  font-size: 1rem;
  font-weight: 700;
  text-align: left;
  padding: 0.65rem 0.9rem;
  border: 1px solid var(--color-border);
}
.research-prose td {
  font-size: 1rem;
  padding: 0.6rem 0.9rem;
  border: 1px solid var(--color-border);
  vertical-align: top;
}
.research-prose tr:nth-child(even) {
  background: var(--color-bg-subtle);
}

/* Links */
.research-prose a {
  color: var(--color-link);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Code blocks (procedure steps) */
.research-prose pre {
  background: var(--color-code-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 1.25rem;
  overflow-x: auto;
  font-size: 0.95rem;
  line-height: 1.6;
  margin: 1.25rem 0;
}
.research-prose code {
  font-family: var(--font-mono);
  font-size: 0.92em;
  background: var(--color-code-bg);
  border-radius: 3px;
  padding: 0.1em 0.3em;
}
.research-prose pre code {
  background: none;
  padding: 0;
}

/* Blockquote */
.research-prose blockquote {
  border-left: 4px solid var(--color-accent);
  background: var(--color-accent-subtle);
  padding: 0.75rem 1.25rem;
  margin: 1.25rem 0;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-style: italic;
  color: var(--color-fg-muted);
}

/* hr */
.research-prose hr {
  border: none;
  border-top: 1px solid var(--color-border);
  margin: 2rem 0;
}

/* Sidebar hover states — no hover on thin borders */
.track-link:hover,
.pdf-link:hover {
  background: var(--color-card-hover) !important;
  border-color: var(--color-accent) !important;
}

/* ── Mobile: stack sidebar below content ───────────────────────────────── */
@media (max-width: 900px) {
  .research-layout {
    flex-direction: column !important;
  }
  .research-sidebar {
    width: 100% !important;
    position: static !important;
  }
  .research-prose p,
  .research-prose li,
  .research-prose td,
  .research-prose th {
    font-size: 1rem;
  }
  .research-prose h2 { font-size: 1.5rem; }
