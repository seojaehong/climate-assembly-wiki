---
/**
 * /ko/doc/related-sites/
 * Korean version — static route (no dynamic params needed).
 * Placed in src/pages/ko/ (not [lang]/) to guarantee static build emission.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedSites from '../../../components/RelatedSites.astro';

const lang = 'ko';
const isKo = true;

const pageTitle = '관련 사이트';
const pageDescription =
  '기후시민회의 위키가 인용·참조하는 외부 1차자료, 도구, 기관, 선례 사이트 목록.';
---

<BaseLayout title={pageTitle} lang={lang} description={pageDescription}>
  <article id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3 text-xs" style="color: var(--color-fg-muted);">
        <a href="/ko/" style="color: var(--color-fg-muted); text-decoration: none;" class="hover:underline">홈</a>
        <span aria-hidden="true">/</span>
        <span>{pageTitle}</span>
      </div>

      <h1
        class="text-3xl font-bold tracking-tight mb-3"
        style="color: var(--color-fg); letter-spacing: var(--tracking-snug);"
      >
        {pageTitle}
      </h1>

      <p class="text-base" style="color: var(--color-fg-muted); max-width: 60ch; line-height: var(--leading-relaxed);">
        본 위키가 인용·참조하는 외부 1차자료 및 도구·기관·선례 사이트입니다. 각 카드를 클릭하면 새 탭에서 열립니다.
      </p>
    </header>

    {/* ── 시뮬레이터·도구 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #2563eb;"
          aria-hidden="true"
        >T</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">시뮬레이터·도구</h2>
      </div>
      <RelatedSites category="tool" title="" />
    </section>

    {/* ── 공식 기관·정부 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #16a34a;"
          aria-hidden="true"
        >O</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">공식 기관·정부</h2>
      </div>
      <RelatedSites category="official" title="" />
    </section>

    {/* ── 방법론·표준 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #7c3aed;"
          aria-hidden="true"
        >M</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">방법론·표준</h2>
      </div>
      <RelatedSites category="methodology" title="" />
    </section>

    {/* ── 학술·과학 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #059669;"
          aria-hidden="true"
        >A</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">학술·과학</h2>
      </div>
      <RelatedSites category="academic" title="" />
    </section>

    {/* ── 미디어·매체 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #d97706;"
          aria-hidden="true"
        >M</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">미디어·매체</h2>
      </div>
      <RelatedSites category="media" title="" />
    </section>

    {/* ── 선례 사이트 ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #6b7280;"
          aria-hidden="true"
        >P</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">선례 시민의회</h2>
      </div>
      <RelatedSites category="precedent" title="" />
    </section>

    <footer class="pt-8 border-t" style="border-color: var(--color-border);">
      <p class="text-xs" style="color: var(--color-fg-subtle);">
        목록 오류·누락 제보: GitHub Issues 또는{' '}
        <a href="mailto:iceamericano9@gmail.com" style="color: var(--color-link);" class="hover:underline">
          iceamericano9@gmail.com
        </a>
        . 최종 업데이트: 2026-06-01 · CC-BY-SA-4.0
      </p>
    </footer>
  </article>
</BaseLayout>
