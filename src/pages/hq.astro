---
import '../styles/global.css';
import HqGate from '../islands/mod/HqGate';
---
<!doctype html>
<html lang="ko" class="light" data-theme="light"><head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="color-scheme" content="light" />
  <title>기후시민회의 운영 현황 [/hq]</title>
  <style is:global>
    body { font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif; }
    .tr-num { letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    /* 인쇄 전용 문서 — 화면에서는 감춰 두고 종이에만 낸다.
       예전에는 보고 있던 화면을 그대로 찍어 작성 안내·빈 입력칸·버튼까지 종이에 나왔다. */
    .print-root { display: none; }
    @media print {
      /* 화면의 모든 것을 감추고 인쇄 문서만 보이게 한다.
         요소별로 하나씩 숨기면 새 UI가 생길 때마다 빠뜨린다. */
      body * { visibility: hidden !important; }
      .print-root, .print-root * { visibility: visible !important; }
      .print-root {
        display: block !important;
        position: absolute; left: 0; top: 0; width: 100%;
        color: #000; background: #fff;
      }
      body { background: #fff !important; }
      a[href]:after { content: ""; }
      @page { margin: 14mm; }
    }
  </style>
</head><body>
  <!-- 본부 비밀번호 게이트가 내부에서 HqGrid를 렌더한다(아일랜드 중첩 회피). -->
  <HqGate client:only="react" />
</body></html>
