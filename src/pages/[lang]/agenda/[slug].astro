---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TranslationStatusBadge from '../../../components/TranslationStatusBadge.astro';

export async function getStaticPaths() {
  const langs = ['ko', 'en', 'ja', 'zh', 'es'];
  const agendaEntries = await getCollection('agenda');

  return langs.flatMap((lang) =>
    agendaEntries.map((entry) => ({
      params: { lang, slug: entry.data.slug },
      props: { entry },
    }))
  );
}

const { lang } = Astro.params;
const { entry } = Astro.props;
const { Content } = await render(entry);

const transStatus = lang !== 'ko' && entry.data.translations
  ? (entry.data.translations as Record<string, { status: 'machine' | 'reviewed' | 'native' } | undefined>)[lang]?.status
  : undefined;
---
<Base title={entry.data.title} lang={lang}>
  <article>
    <header class="mb-6">
      <div class="flex items-center gap-2 mb-2 text-xs text-gray-500">
        <span>#{entry.data.id.toString().padStart(2, '0')}</span>
        <span>·</span>
        <span>{entry.data.category}</span>
        <span>·</span>
        <span class="capitalize">{entry.data.status}</span>
        {transStatus && (
          <>
            <span>·</span>
            <TranslationStatusBadge status={transStatus} />
          </>
        )}
      </div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{entry.data.title}</h1>

      {entry.data.ministries.length > 0 && (
        <div class="mt-2 flex flex-wrap gap-1">
          {entry.data.ministries.map((m: string) => (
            <span class="text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-800 rounded">{m}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>

    {entry.data.related_agendas.length > 0 && (
      <footer class="mt-8 pt-4 border-t border-gray-200 dark:border-gray-700">
        <p class="text-sm text-gray-500">
          관련 의제: {entry.data.related_agendas.map((id: number) => `#${id}`).join(', ')}
        </p>
      </footer>
    )}

    <p class="mt-4 text-xs text-gray-400">
      최종 업데이트: {entry.data.last_updated} · {entry.data.license}
    </p>
  </article>
</Base>
