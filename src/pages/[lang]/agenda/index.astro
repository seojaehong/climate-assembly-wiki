---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../layouts/Base.astro';
import AgendaCard from '../../../components/AgendaCard.astro';
import TranslationFallbackBanner from '../../../components/TranslationFallbackBanner.astro';
import { SITE_LOCALE_CODES, STRUCTURAL_LOCALE_CODES, isSiteLocale } from '../../../lib/site-locales';

export async function getStaticPaths() {
  return SITE_LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const isKo = lang === 'ko';
const isStructuralLocale = isSiteLocale(lang) && STRUCTURAL_LOCALE_CODES.includes(lang);

interface AgendaSurfaceSummary {
  source?: {
    record_count?: number;
    by_source?: Record<string, number>;
    ocr_matched_count?: number;
  };
  records?: unknown[];
}

function readSurfaceSummary(fileName: string): AgendaSurfaceSummary {
  const filePath = path.join(process.cwd(), 'public', 'workshop-graph', 'data', fileName);
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf-8')) as AgendaSurfaceSummary;
  } catch (error) {
    console.warn(`[agenda-index] Failed to read ${fileName}:`, error);
    return {};
  }
}

const kbSurface = readSurfaceSummary('kb-agenda-surface.json');
const gyeonggiSurface = readSurfaceSummary('gyeonggi-agenda-surface.json');
const kbRecordCount = kbSurface.source?.record_count ?? kbSurface.records?.length ?? 0;
const gyeonggiRecordCount = gyeonggiSurface.source?.record_count ?? gyeonggiSurface.records?.length ?? 0;
const overseasCount = kbSurface.source?.by_source?.['overseas-cases'] ?? 0;
const expertCount = kbSurface.source?.by_source?.['kei-expert-agenda'] ?? 0;
const citizenCount = kbSurface.source?.by_source?.['citizen-domestic'] ?? 0;

// R-01: Filter out dummy agenda (#00, id = 0)
const agendaEntries = await getCollection('agenda');
const sorted = agendaEntries
  .filter((entry) => entry.data.id > 0)
  .sort((a, b) => a.data.id - b.data.id);
---
<Base title={isKo ? '의제 자료실' : 'Agenda Library'} lang={lang}>
  {isStructuralLocale && <TranslationFallbackBanner targetLang={lang} currentPath={Astro.url.pathname} />}
  <div class="agenda-library-page min-w-0 max-w-full overflow-hidden">
  <section class="mb-8 min-w-0">
    <p class="text-sm font-semibold text-[var(--color-accent)] mb-2">
      {isKo ? '원천 기반 자료와 내부 해설을 분리합니다' : 'Source-backed records are separated from internal briefs'}
    </p>
    <h1 class="text-2xl font-bold mb-3 text-gray-900 dark:text-gray-100">
      {isKo ? '의제 자료실' : 'Agenda Library'}
    </h1>
    <p class="max-w-3xl break-words text-sm leading-6 text-[var(--color-fg-muted)]">
      {isKo
        ? '이 화면의 하단 15개 카드는 워크숍 운영을 위해 작성한 내부 해설 초안입니다. 공식 원천 DB처럼 보지 않고, 실제 근거 확인은 보호 KB export, 경기도 OCR, Supabase 원천 페이지에서 합니다.'
        : 'The 15 cards below are internal working brief drafts. Treat source-backed KB export, Gyeonggi OCR, and Supabase records as the evidence surfaces.'}
    </p>
  </section>

  <section class="mb-8 min-w-0 rounded-lg border border-amber-300/70 bg-amber-50/80 p-4 text-sm text-amber-950 dark:border-amber-500/50 dark:bg-amber-950/30 dark:text-amber-100">
    <div class="font-semibold mb-1">
      {isKo ? '주의: 기존 의제 카드는 공신력 있는 DB가 아닙니다' : 'Note: legacy agenda cards are not authoritative records'}
    </div>
    <p class="break-words leading-6">
      {isKo
        ? '이전 “의제 목록”은 내부 가안 성격이 강해, 발표나 검토에서는 원문 출처가 붙은 자료로 교차 확인해야 합니다. 링크는 유지하되 화면 전체에서 내부 초안으로 표시합니다.'
        : 'The previous agenda list is retained for navigation, but it is labeled as internal draft material and should be cross-checked against source-backed records.'}
    </p>
  </section>

  <section class="mb-10 min-w-0" aria-labelledby="source-backed-heading">
    <div class="flex items-end justify-between gap-4 mb-4">
      <div>
        <h2 id="source-backed-heading" class="text-lg font-bold text-[var(--color-fg)]">
          {isKo ? '원천 기반 의제 자료' : 'Source-Backed Agenda Records'}
        </h2>
        <p class="mt-1 break-words text-sm text-[var(--color-fg-muted)]">
          {isKo
            ? '검수 전 자료는 “참고용”으로 표기하고, 원문 발췌와 출처를 함께 보여줍니다.'
            : 'Unreviewed records are labeled as reference material and shown with excerpts and source metadata.'}
        </p>
      </div>
      {/* 2026-08-29: 「숙의 온톨로지 보기」 링크 숨김 — 상단 탭과 같은 이유. */}
    </div>

    <div class="grid min-w-0 gap-4 md:grid-cols-2">
      <a
        href={`/${lang}/agenda-source/kb/000002-청소년-기후-교육-시민권/`}
        class="block min-w-0 rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-4 no-underline hover:border-[var(--color-accent)] transition-colors"
      >
        <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-accent)]">
          {isKo ? '보호 KB export' : 'Protected KB export'}
        </div>
        <div class="mt-2 text-2xl font-bold text-[var(--color-fg)]">{kbRecordCount.toLocaleString()}</div>
        <p class="mt-2 break-words text-sm leading-6 text-[var(--color-fg-muted)]">
          {isKo
            ? `해외 사례 ${overseasCount.toLocaleString()}건, 전문가 의제 ${expertCount.toLocaleString()}건, 시민 국내 자료 ${citizenCount.toLocaleString()}건을 포함한 보호 지식베이스 export입니다.`
            : `Protected knowledge-base export including ${overseasCount.toLocaleString()} overseas records, ${expertCount.toLocaleString()} expert agenda rows, and ${citizenCount.toLocaleString()} citizen records.`}
        </p>
        <span class="mt-3 inline-flex text-xs font-semibold text-amber-700 dark:text-amber-200">
          {isKo ? '검수 필요 · 참고용' : 'Needs review · reference only'}
        </span>
      </a>

      <a
        href={`/${lang}/agenda-source/gyeonggi/001-경기도형-탄소-포인트-기부-나눔/`}
        class="block min-w-0 rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-4 no-underline hover:border-[var(--color-accent)] transition-colors"
      >
        <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-accent)]">
          {isKo ? '경기도 OCR 원천' : 'Gyeonggi OCR source'}
        </div>
        <div class="mt-2 text-2xl font-bold text-[var(--color-fg)]">{gyeonggiRecordCount.toLocaleString()}</div>
        <p class="mt-2 break-words text-sm leading-6 text-[var(--color-fg-muted)]">
          {isKo
            ? '경기도 기후도민총회 자료에서 추출한 OCR 기반 의제입니다. 페이지 참조와 원문 발췌를 우선 보여줍니다.'
            : 'OCR-backed agenda records from Gyeonggi climate citizen assembly materials, shown with page references and excerpts.'}
        </p>
        <span class="mt-3 inline-flex text-xs font-semibold text-[var(--color-accent)]">
          {isKo ? '원문 발췌 보기' : 'Open source excerpt'}
        </span>
      </a>

      {/* 2026-08-29: 「숙의 온톨로지 / Graph」 카드 숨김 — 상단 탭과 같은 이유.
          카드가 셋에서 둘로 줄었으므로 위 격자를 md:grid-cols-2 로 함께 낮췄다.
          3열로 두면 마지막 칸이 비어 「자료가 빠졌나」로 읽힌다. */}
    </div>
  </section>

  <section class="min-w-0" aria-labelledby="internal-drafts-heading">
    <div class="mb-4">
      <h2 id="internal-drafts-heading" class="text-lg font-bold text-[var(--color-fg)]">
        {isKo ? '내부 의제 해설 초안 15건' : 'Internal Agenda Brief Drafts'}
      </h2>
      <p class="mt-1 break-words text-sm text-[var(--color-fg-muted)]">
        {isKo
          ? '아래 카드는 설명 구조를 잡기 위한 가안입니다. 원천 자료가 필요한 경우 위 원천 기반 자료를 우선 확인하세요.'
          : 'These cards are working drafts for explanatory structure. Use the source-backed records above for evidence checks.'}
      </p>
    </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {sorted.map((entry) => (
      <AgendaCard
        id={entry.data.id}
        title={entry.data.title}
        category={entry.data.category}
        status={entry.data.status}
        slug={entry.data.slug}
        lang={lang}
        contentStatus={lang === 'ko' ? 'reviewed' : (entry.data.translations?.en?.status ?? 'machine')}
        enAvailable={!!entry.data.translations?.en}
        sourceMode="internal-draft"
      />
    ))}
  </div>
  </section>
  </div>
</Base>

<style>
  .agenda-library-page,
  .agenda-library-page * {
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .agenda-library-page,
    .agenda-library-page * {
      max-width: 100%;
      word-break: break-all;
    }
  }
</style>
