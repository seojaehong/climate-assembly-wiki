---
/**
 * D5-p — /[lang]/glossary/
 *
 * Reads terms from src/data/terms.yaml (already exists with 12 entries).
 * terms.yaml is a flat YAML array with fields: key, ko, en, ja, zh, es.
 *
 * Groups terms alphabetically by the display language key.
 * For lang='en', uses `en` field. For 'ko', uses `ko` field.
 * Falls back to `ko` value when `en` is absent.
 *
 * No translation fallback banner needed: the glossary page always renders
 * (both term text and UI labels switch per lang).
 */
import Base from '../../../layouts/Base.astro';
import termsRaw from '../../../data/terms.yaml';

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------
interface GlossaryTerm {
  key: string;
  ko: string;
  en?: string;
  ja?: string;
  zh?: string;
  es?: string;
}

// ---------------------------------------------------------------------------
// getStaticPaths
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
    // M4: add ja, zh, es
  ];
}

const { lang } = Astro.params;
const terms = termsRaw as GlossaryTerm[];

// Get display label for each term based on current lang
function termLabel(t: GlossaryTerm): string {
  if (lang === 'en') return t.en ?? t.ko;
  return t.ko;
}

// Sort alphabetically by display label
const sorted = [...terms].sort((a, b) =>
  termLabel(a).localeCompare(termLabel(b), lang === 'ko' ? 'ko' : 'en')
);

// Group by first letter (uppercase)
const grouped: Map<string, GlossaryTerm[]> = new Map();
for (const term of sorted) {
  const label = termLabel(term);
  const letter = label[0]?.toUpperCase() ?? '#';
  if (!grouped.has(letter)) grouped.set(letter, []);
  grouped.get(letter)!.push(term);
}

const pageTitle = lang === 'ko' ? '용어집' : 'Glossary';
const letters = [...grouped.keys()];
---
<Base title={pageTitle} lang={lang}>
  <article id="main-content">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{pageTitle}</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {lang === 'ko'
        ? `${terms.length}개 용어 · 알파벳순 정렬`
        : `${terms.length} terms · sorted alphabetically`}
    </p>

    {/* Jump links */}
    <nav aria-label={lang === 'ko' ? '알파벳 바로가기' : 'Alphabet jump links'} class="mb-8">
      <ol class="flex flex-wrap gap-2">
        {letters.map((letter) => (
          <li>
            <a
              href={`#letter-${letter}`}
              class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded hover:bg-green-100 dark:hover:bg-green-900 text-gray-700 dark:text-gray-300"
            >
              {letter}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {/* Term groups */}
    {letters.map((letter) => (
      <section aria-labelledby={`letter-${letter}`} class="mb-8">
        <h2
          id={`letter-${letter}`}
          class="text-lg font-semibold text-gray-700 dark:text-gray-300 border-b border-gray-200 dark:border-gray-700 pb-1 mb-4"
        >
          {letter}
        </h2>
        <dl class="space-y-3">
          {grouped.get(letter)!.map((term) => (
            <div class="grid sm:grid-cols-[1fr_2fr] gap-1 sm:gap-4">
              <dt>
                <span class="font-medium text-gray-900 dark:text-gray-100">
                  {termLabel(term)}
                </span>
                {/* Show key abbreviation if different from display label */}
                {term.key !== termLabel(term) && (
                  <span class="ml-2 text-xs text-gray-400 font-mono">({term.key})</span>
                )}
              </dt>
              <dd class="text-sm text-gray-600 dark:text-gray-400">
                {/* Show the other language as cross-reference */}
                {lang === 'ko' && term.en && (
                  <span class="italic">{term.en}</span>
                )}
                {lang === 'en' && (
                  <span class="italic">{term.ko}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    <p class="mt-8 text-xs text-gray-400">
      {lang === 'ko'
        ? '용어집은 지속적으로 확장됩니다. Climate Interactive 용어는 CC BY 4.0.'
        : 'Glossary is continuously expanding. Climate Interactive terms under CC BY 4.0.'}
    </p>
  </article>
</Base>
