      });
      // initial fade out
      setTimeout(function () { document.body.classList.add('hint-hidden'); }, 4000);
    })();
  </script>

  <script is:inline>
    (function () {
      /* ---- Read build-time env ---- */
      var dataEl = document.getElementById('sheet-url-data');
      var sheetUrl = dataEl ? JSON.parse(dataEl.textContent || '""') : '';

      if (!sheetUrl) {
        document.getElementById('env-error-banner').style.display = 'block';
      }

      var POLL_INTERVAL = 10000;   // 10s
      var ROTATE_INTERVAL = 8000; // 8s per card
      /* WINDOW_SIZE=1: 한 장씩 크게 (강당 8-15m 가시성 최우선)
         카드 > 1장이면 auto-rotate */

      /* ---- Demo data (?demo=1) ---- */
      var DEMO_DATA = {
        'A조': {
          ts: '데모 · A조',
          adopted: [
            '탄소세 도입 시 서민 부담 완화 방안 마련',
            '재생에너지 전환 가속화 로드맵 법제화',
            '기후위기 취약계층 우선 지원 제도',
            '건물 에너지 효율 기준 강화',
            '탄소중립 교육 의무화'
          ],
          remaining: [
            '핵에너지 역할 재검토',
            '탄소 포집 기술 투자',
            '해상풍력 규제 완화',
            '대중교통 무상화',
            '육식 소비 감축 인센티브',
            '녹색 공공조달 의무화'
          ]
        },
        'B조': {
          ts: '데모 · B조',
          adopted: [
            '기후 적응 도시 인프라 투자 확대',
            '농업 분야 기후 피해 보상 제도화',
            '해수면 상승 대응 연안 정비',
            '폭염 취약계층 냉방 지원 확대'
          ],
          remaining: [
            '홍수 예보 시스템 고도화',
            '산불 대응 인력 확충',
            '기후 이주민 지원 법제화',
            '가뭄 대비 저수 시설 확대',
            '생태계 복원 펀드 조성'
          ]
        }
      };

      function isDemoMode() {
        try {
          var p = new URLSearchParams(window.location.search);
          return p.get('demo') === '1' || !sheetUrl;
        } catch (e) {
          return !sheetUrl;
        }
      }

      /* ---- RFC 4180 quoted-CSV parser (regulation.astro 동일) ---- */
      function parseCSV(text) {
        var rows = [];
        var row = [];
        var field = '';
        var inQuotes = false;
        var i = 0;
        var len = text.length;

        while (i < len) {
          var ch = text[i];
          if (inQuotes) {
            if (ch === '"') {
              if (i + 1 < len && text[i + 1] === '"') {
                field += '"'; i += 2;
              } else {
                inQuotes = false; i++;
              }
            } else {
              field += ch; i++;
            }
          } else {
            if (ch === '"') {
              inQuotes = true; i++;
            } else if (ch === ',') {
              row.push(field); field = ''; i++;
            } else if (ch === '\r') {
              row.push(field); field = '';
              rows.push(row); row = [];
              i++;
              if (i < len && text[i] === '\n') i++;
            } else if (ch === '\n') {
              row.push(field); field = '';
              rows.push(row); row = [];
              i++;
            } else {
              field += ch; i++;
            }
          }
        }
        if (field !== '' || row.length > 0) { row.push(field); rows.push(row); }
        if (rows.length > 0) {
          var last = rows[rows.length - 1];
          if (last.length === 1 && last[0] === '') rows.pop();
        }
        return rows;
      }

      /* ---- Parse Sheet into { A조: { adopted:[...], remaining:[...], ts }, B조: ... } ---- */
      function extractLatest(rows) {
        if (rows.length < 2) return {};
        // Row 0 = header
        // cols: 0=ts, 1=그룹, 2-6=채택1-5, 7-14=나머지1-8
        var byGroup = {};
        for (var r = 1; r < rows.length; r++) {
          var row = rows[r];
          if (!row || row.length < 2) continue;
          var ts = (row[0] || '').trim();
          var group = (row[1] || '').trim();
          if (!group) continue;
          if (!byGroup[group] || ts > byGroup[group].ts) {
            byGroup[group] = { ts: ts, row: row };
          }
        }
        var result = {};
        for (var g in byGroup) {
          var rowData = byGroup[g].row;
          // 실제 폼 스키마: cols 2~6 = 채택 5개 (의제1~5), cols 7~ = 나머지 가변 (의제6~의제17)
          var adopted = [];
          for (var k = 0; k < 5; k++) {
            var v = (rowData[2 + k] || '').trim();
            if (v) adopted.push(v);
          }
          var remaining = [];
          for (var m = 7; m < rowData.length; m++) {
            var rv = (rowData[m] || '').trim();
            if (rv) remaining.push(rv);
          }
          result[g] = { adopted: adopted, remaining: remaining, ts: byGroup[g].ts };
        }
        return result;
      }

      function escHtml(s) {
        return s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function fmtTs(ts) {
        if (!ts) return '';
        try {
          var d = new Date(ts.replace(/\//g, '-'));
          if (isNaN(d)) return ts;
          return d.toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        } catch (e) { return ts; }
      }

      /* ---- Auto-rotate state (A·B 독립) ---- */
      // rotators[panelId] = { idx, timer, total, panelId }
      var rotators = {};
      var globalPaused = false;

      /*
       * createRotator: 패널당 독립 로테이터.
       * - total <= 1이면 타이머 없음 (회전 불필요)
       * - poll 시 타임스탬프가 바뀌지 않으면 rotator를 재생성하지 않음
       *   → lastTs 캐시로 체크 (Blocker #1 fix)
       */
      var lastTs = { a: null, b: null };

      function startRotator(panelId, total) {
        // Clear existing
        if (rotators[panelId] && rotators[panelId].timer) {
          clearInterval(rotators[panelId].timer);
        }
        var rot = { idx: 0, timer: null, total: total, panelId: panelId };
        rotators[panelId] = rot;
        if (total <= 1) return rot; // no rotation needed
        rot.timer = setInterval(function () {
          if (globalPaused) return;
          advanceCard(rot);
        }, ROTATE_INTERVAL);
        return rot;
      }

      function advanceCard(rot) {
        var viewport = document.getElementById('adopted-' + rot.panelId);
        var dotsEl = document.getElementById('dots-' + rot.panelId);
        if (!viewport) return;

        var card = viewport.querySelector('.adopted-card');
        if (card) card.classList.add('fading');

        var nextIdx = (rot.idx + 1) % rot.total;
        setTimeout(function () {
          rot.idx = nextIdx;
          renderAdoptedCard(rot.panelId, rot.idx);
          updateDots(dotsEl, rot);
        }, 400);
      }

      /* ---- Render single adopted card (1장 at idx) ---- */
      function renderAdoptedCard(panelId, idx) {
        var viewport = document.getElementById('adopted-' + panelId);
        if (!viewport) return;
        var panelData = currentData[panelId];
        var adopted = panelData ? panelData.adopted : [];

        var html = '';
        var rotClass = (idx % 2 === 1) ? ' alt-rotate' : '';
        if (adopted.length === 0) {
          html = buildPlaceholderCard('');
        } else {
          html = buildAdoptedCard(adopted[idx % adopted.length], rotClass);
        }
        viewport.innerHTML = html;
      }

      function buildAdoptedCard(text, rotClass) {
        return '<div class="adopted-card' + (rotClass || '') + '">'
          + '<span class="star-mark" aria-hidden="true">★</span>'
          + '<div class="adopted-card-body">'
          + '<div class="adopted-text">' + escHtml(text) + '</div>'
          + '</div>'
          + '</div>';
      }

      function buildPlaceholderCard() {
        return '<div class="adopted-card placeholder">'
          + '<span class="star-mark" aria-hidden="true">★</span>'
          + '<div class="adopted-card-body">'
          + '<div class="adopted-text">응답 대기 중</div>'
          + '</div>'
          + '</div>';
      }

      function updateDots(dotsEl, rot) {
        if (!dotsEl) return;
        var total = rot.total;
        if (total <= 1) {
          dotsEl.innerHTML = '';
          return;
        }
        var html = '';
        for (var i = 0; i < total; i++) {
          html += '<div class="dot' + (i === rot.idx ? ' active' : '') + '"></div>';
        }
        dotsEl.innerHTML = html;
      }

      /* ---- Render remaining chips ---- */
      function renderRemaining(panelId, remainingArr) {
        var el = document.getElementById('remaining-' + panelId);
        if (!el) return;
        if (!remainingArr || remainingArr.length === 0) {
          el.innerHTML = '<div class="remaining-chip placeholder">나머지 의제 없음</div>';
          return;
        }
        var html = '';
        for (var i = 0; i < remainingArr.length; i++) {
          html += '<div class="remaining-chip">' + escHtml(remainingArr[i]) + '</div>';
        }
        el.innerHTML = html;
      }

      /* ============================================================
         BOARD STATE — DnD persistent reorder (localStorage)
         ============================================================
         Semantics: Trello/Insert style
           - 카드 X → Y 상단 절반 드롭: X가 Y 자리, Y와 아래 한 칸씩 밀림
           - 카드 X → Y 하단 절반 드롭: X가 Y 다음 자리, 그 아래만 밀림
           - 카드 X → 빈 영역 드롭: 해당 패널 맨 끝에 추가
           - 자기 자신/같은 자리: no-op
           - 패널 교차 (A→B): A에서 제거, B에 삽입 (5/5 → 4/6 등 허용)
         Persistence:
           - localStorage key 'agenda-board-state-v1'
           - sig = "A타임스탬프|||B타임스탬프"
           - 시트 ts 변경 시 자동 폐기 → 시트 원본 순서로 복귀
         Polling 안전:
           - isDragging=true 동안 fetchAndRender skip → 드래그 중 DOM 폭파 방지
      */
      var STORAGE_KEY = 'agenda-board-state-v1';
      var boardState = null;
      var latestSheetData = null;
      var isDragging = false;
      var draggedId = null;
      var draggedFromPanel = null;

      function uid() {
        return 'p_' + Math.random().toString(36).slice(2, 10) + '_' + Date.now().toString(36);
      }

      function buildSig(data) {
        var aTs = (data && data['A조']) ? data['A조'].ts : '';
        var bTs = (data && data['B조']) ? data['B조'].ts : '';
        return aTs + '|||' + bTs;
      }

      function loadBoardState() {
        try {
          var raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return null;
          var p = JSON.parse(raw);
          if (!p || !p.sig || !p.items || !p.items.a || !p.items.b) return null;
          return p;
        } catch (e) { return null; }
      }

      function saveBoardState() {
        try {
          if (boardState) localStorage.setItem(STORAGE_KEY, JSON.stringify(boardState));
        } catch (e) {}
      }

      function freshBoardStateFromSheet(data, sig) {
        var aArr = (data && data['A조'] && data['A조'].adopted) ? data['A조'].adopted : [];
        var bArr = (data && data['B조'] && data['B조'].adopted) ? data['B조'].adopted : [];
        return {
          sig: sig,
          sheetSnapshot: { a: aArr.slice(), b: bArr.slice() },
          items: {
            a: aArr.map(function (t) { return { id: uid(), text: t }; }),
            b: bArr.map(function (t) { return { id: uid(), text: t }; })
          },
          links: []
        };
      }

      function syncWithSheet(data) {
        latestSheetData = data;
        var sig = buildSig(data);
        var saved = loadBoardState();
        if (saved && saved.sig === sig) {
          boardState = saved;
          if (!boardState.links) boardState.links = [];
        } else {
          boardState = freshBoardStateFromSheet(data, sig);
          saveBoardState();
        }
      }

      function isDirty() {
        if (!boardState) return false;
        var snap = boardState.sheetSnapshot;
        var panels = ['a', 'b'];
        for (var k = 0; k < panels.length; k++) {
          var p = panels[k];
          var items = boardState.items[p] || [];
          var src = snap[p] || [];
          if (items.length !== src.length) return true;
          for (var i = 0; i < items.length; i++) {
            if (items[i].text !== src[i]) return true;
          }
        }
        return false;
      }

      function updateResetButton() {
        var btn = document.getElementById('reset-btn');
        if (!btn) return;
        btn.hidden = !isDirty();
      }

      /* ---- 양 패널 줄(층위) 정렬 — max(A,B) 행 분할로 1번째 줄 높이 통일 ---- */
      function syncRowAlignment() {
        if (!boardState) return;
        var aLen = (boardState.items.a || []).length;
        var bLen = (boardState.items.b || []).length;
        var max = Math.max(aLen, bLen, 1);
        var spec = 'repeat(' + max + ', minmax(0, 1fr))';
        var gridA = document.getElementById('adopted-a');
        var gridB = document.getElementById('adopted-b');
        if (gridA) { gridA.style.gridTemplateRows = spec; gridA.style.gridAutoRows = 'minmax(0, 1fr)'; }
        if (gridB) { gridB.style.gridTemplateRows = spec; gridB.style.gridAutoRows = 'minmax(0, 1fr)'; }
      }

      /* ---- Render single panel from boardState ---- */
      function renderPanel(panelId, groupData) {
        var items = boardState ? (boardState.items[panelId] || []) : [];
        renderAdoptedGrid(panelId, items);
        renderRemaining(panelId, groupData ? groupData.remaining : null);
      }

      /* ---- postit-grid 렌더 (items: [{id,text}]) — draggable + data-* ---- */
      function renderAdoptedGrid(panelId, items) {
        var el = document.getElementById('adopted-' + panelId);
        if (!el) return;
        var dragAttr = document.body.classList.contains('link-mode') ? 'false' : 'true';
        if (!items || items.length === 0) {
          el.innerHTML = '<div class="postit placeholder" data-panel="' + panelId
            + '" style="background:#f5f0e6;color:#9c8d75;cursor:default;">'
            + '<span class="postit-star">★</span>'
            + '<div class="postit-text" style="font-style:italic;">응답 대기 중</div></div>';
          return;
        }
        var html = '';
        for (var i = 0; i < items.length; i++) {
          var it = items[i];
          html += '<div class="postit" draggable="' + dragAttr + '"'
            + ' data-postit-id="' + it.id + '"'
            + ' data-panel="' + panelId + '">'
            + '<span class="postit-star" aria-hidden="true">★</span>'
            + '<div class="postit-text">' + escHtml(it.text) + '</div>'
            + '</div>';
        }
        el.innerHTML = html;
      }

      /* ---- Update UI state ---- */
      function updateStatus(state, detail) {
        var dot = document.getElementById('status-dot');
        var txt = document.getElementById('status-text');
        if (!dot || !txt) return;
        dot.className = 'status-dot' + (state === 'live' ? ' live' : state === 'demo' ? ' demo' : '');
        txt.textContent = detail || '대기 중';
      }

      function showPanels() {
        document.getElementById('loading-overlay').style.display = 'none';
        document.getElementById('split-wrapper').style.display = 'flex';
      }

      /* ---- Render with data ---- */
      function applyData(data) {
        syncWithSheet(data);
        var groupA = data['A조'];
        var groupB = data['B조'];
        renderPanel('a', groupA || null);
        renderPanel('b', groupB || null);

        var timeA = document.getElementById('time-a');
        var timeB = document.getElementById('time-b');
        if (timeA) timeA.textContent = groupA ? ('최신: ' + fmtTs(groupA.ts)) : '응답 없음';
        if (timeB) timeB.textContent = groupB ? ('최신: ' + fmtTs(groupB.ts)) : '응답 없음';

        syncRowAlignment();
        redrawLinks();
        updateResetButton();
        showPanels();
      }

      function renderDemo() {
        applyData(DEMO_DATA);
        updateStatus('demo', 'DEMO 모드 — 더미 데이터');
      }

      /* ---- Fetch & render ---- */
      function fetchAndRender() {
        if (isDragging) return;     // 드래그 중 폴링 결과 적용 보류
        if (isDemoMode()) {
          renderDemo();
          return;
        }

        fetch(sheetUrl + '&t=' + Date.now(), { cache: 'no-store' })
          .then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.text();
          })
          .then(function (text) {
            if (isDragging) return; // race: 시작 후 drag
            var rows = parseCSV(text);
            var data = extractLatest(rows);
            applyData(data);
            updateStatus('live', '라이브 · 10초 폴링');
          })
          .catch(function (err) {
            console.error('[agenda] fetch error:', err);
            updateStatus('error', '연결 오류 — 재시도 중');
            showPanels();
          });
      }

      /* ============================================================
         DnD HANDLERS (HTML5 native drag)
         ============================================================ */
      function clearDropIndicators() {
        var nodes = document.querySelectorAll('.drop-target-before, .drop-target-after');
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].classList.remove('drop-target-before');
          nodes[i].classList.remove('drop-target-after');
        }
        var grids = document.querySelectorAll('.postit-grid');
        for (var j = 0; j < grids.length; j++) grids[j].classList.remove('drop-empty');
      }

      function findIndexById(arr, id) {
        for (var i = 0; i < arr.length; i++) if (arr[i].id === id) return i;
        return -1;
      }

      function handleDrop(dstPanel, targetEl, clientY) {
        if (!boardState) return;
        var srcPanel = draggedFromPanel;
        var srcId = draggedId;
        if (!srcPanel || !srcId) return;
        var srcArr = boardState.items[srcPanel];
        var dstArr = boardState.items[dstPanel];
        if (!srcArr || !dstArr) return;
        var srcIdx = findIndexById(srcArr, srcId);
        if (srcIdx === -1) return;

        // Determine destination index BEFORE removal
        var dstIdx;
        var targetId = targetEl ? targetEl.getAttribute('data-postit-id') : null;
        if (!targetEl || !targetId || targetId === srcId) {
          dstIdx = dstArr.length;   // empty area or self → append
        } else {
          var targetIdx = findIndexById(dstArr, targetId);
          if (targetIdx === -1) {
            dstIdx = dstArr.length;
          } else {
            var rect = targetEl.getBoundingClientRect();
            var midY = rect.top + rect.height / 2;
            dstIdx = (clientY < midY) ? targetIdx : targetIdx + 1;
          }
        }

        var srcItem = srcArr[srcIdx];
        srcArr.splice(srcIdx, 1);

        // Same-panel adjust: removal shifts indexes
        if (srcPanel === dstPanel && srcIdx < dstIdx) dstIdx -= 1;
        if (dstIdx < 0) dstIdx = 0;
        if (dstIdx > dstArr.length) dstIdx = dstArr.length;

        dstArr.splice(dstIdx, 0, srcItem);

        clearDropIndicators();
        saveBoardState();
        renderAdoptedGrid('a', boardState.items.a);
        renderAdoptedGrid('b', boardState.items.b);
        syncRowAlignment();
        redrawLinks();
        updateResetButton();
      }

      function attachGridDnD(panelId) {
        var grid = document.getElementById('adopted-' + panelId);
        if (!grid) return;
        grid.addEventListener('dragover', function (e) {
          if (!draggedId) return;
          e.preventDefault();
          try { e.dataTransfer.dropEffect = 'move'; } catch (_) {}
          clearDropIndicators();
          var target = e.target.closest && e.target.closest('.postit[data-postit-id]');
          if (!target) { grid.classList.add('drop-empty'); return; }
          var tid = target.getAttribute('data-postit-id');
          if (!tid || tid === draggedId) { grid.classList.add('drop-empty'); return; }
          var rect = target.getBoundingClientRect();
          var midY = rect.top + rect.height / 2;
          if (e.clientY < midY) target.classList.add('drop-target-before');
          else target.classList.add('drop-target-after');
        });
        grid.addEventListener('dragleave', function (e) {
          if (!grid.contains(e.relatedTarget)) clearDropIndicators();
        });
        grid.addEventListener('drop', function (e) {
          if (!draggedId) return;
          e.preventDefault();
          var dstPanel = (grid.id === 'adopted-a') ? 'a' : 'b';
          var target = e.target.closest && e.target.closest('.postit[data-postit-id]');
          handleDrop(dstPanel, target, e.clientY);
        });
      }

      document.addEventListener('dragstart', function (e) {
        var p = e.target && e.target.closest && e.target.closest('.postit[data-postit-id]');
        if (!p) return;
        var id = p.getAttribute('data-postit-id');
        if (!id) return;
        draggedId = id;
        draggedFromPanel = p.getAttribute('data-panel');
        isDragging = true;
        try {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', id);
        } catch (_) {}
        p.classList.add('dragging');
      });

      document.addEventListener('dragend', function (e) {
        var p = e.target && e.target.closest && e.target.closest('.postit');
        if (p) p.classList.remove('dragging');
        clearDropIndicators();
        isDragging = false;
        draggedId = null;
        draggedFromPanel = null;
      });

      attachGridDnD('a');
      attachGridDnD('b');

      /* ---- Reset button ---- */
      var resetBtn = document.getElementById('reset-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
          if (latestSheetData) {
            boardState = freshBoardStateFromSheet(latestSheetData, buildSig(latestSheetData));
            saveBoardState();
            renderAdoptedGrid('a', boardState.items.a);
            renderAdoptedGrid('b', boardState.items.b);
            syncRowAlignment();
            redrawLinks();
            updateResetButton();
          }
        });
      }

      /* ============================================================
         LINK MODE — 카드 두 개 클릭 → 곡선 연결 (SVG overlay)
         ============================================================
         - 헤더 "🔗 연결" 토글 → linkMode on/off
         - linkMode 중: 카드 클릭 = 1차 source, 두 번째 카드 클릭 = 연결 생성
         - 같은 카드 다시 클릭 = 취소
         - 연결선 클릭 = 삭제
         - linkMode 중에는 DnD 비활성
         - 리사이즈/렌더 시 자동 재계산
      */
      var pendingLink = null;

      function clearPendingLink() {
        pendingLink = null;
        var nodes = document.querySelectorAll('.postit.link-pending');
        for (var i = 0; i < nodes.length; i++) nodes[i].classList.remove('link-pending');
      }

      function setLinkMode(on) {
        if (on) document.body.classList.add('link-mode');
        else document.body.classList.remove('link-mode');
        var nodes = document.querySelectorAll('.postit[data-postit-id]');
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].setAttribute('draggable', on ? 'false' : 'true');
        }
        if (!on) clearPendingLink();
      }

      function getCenterRel(el, container) {
        var r = el.getBoundingClientRect();
        var cr = container.getBoundingClientRect();
        return { x: r.left + r.width / 2 - cr.left, y: r.top + r.height / 2 - cr.top, w: r.width, h: r.height };
      }

      function redrawLinks() {
        var svg = document.getElementById('link-overlay');
        var wrap = document.getElementById('split-wrapper');
        if (!svg || !wrap || !boardState) return;
        var wRect = wrap.getBoundingClientRect();
        svg.setAttribute('viewBox', '0 0 ' + wRect.width + ' ' + wRect.height);
        svg.setAttribute('width', wRect.width);
        svg.setAttribute('height', wRect.height);
        var links = boardState.links || [];
        var html = '';
        for (var i = 0; i < links.length; i++) {
          var l = links[i];
          if (!l || !l.from || !l.to) continue;
          var elA = document.querySelector('.postit[data-postit-id="' + l.from.id + '"]');
          var elB = document.querySelector('.postit[data-postit-id="' + l.to.id + '"]');
          if (!elA || !elB) continue;
          var pa = getCenterRel(elA, wrap);
          var pb = getCenterRel(elB, wrap);
          var d;
          if (l.from.panel === l.to.panel) {
            // 같은 패널 — 옆으로 휘는 활
            var side = (l.from.panel === 'a') ? -1 : 1;
            var bow = (l.from.panel === 'a') ? Math.min(pa.x, pb.x) - 70 : Math.max(pa.x, pb.x) + 70;
            d = 'M ' + pa.x + ' ' + pa.y + ' C ' + bow + ' ' + pa.y + ', ' + bow + ' ' + pb.y + ', ' + pb.x + ' ' + pb.y;
          } else {
            // 패널 교차 — 가운데 부드러운 베지에
            var midX = (pa.x + pb.x) / 2;
            d = 'M ' + pa.x + ' ' + pa.y + ' C ' + midX + ' ' + pa.y + ', ' + midX + ' ' + pb.y + ', ' + pb.x + ' ' + pb.y;
          }
          html += '<path d="' + d + '" data-link-id="' + i + '"></path>';
          html += '<circle cx="' + pa.x + '" cy="' + pa.y + '" r="7"></circle>';
          html += '<circle cx="' + pb.x + '" cy="' + pb.y + '" r="7"></circle>';
        }
        svg.innerHTML = html;
      }

      /* 연결선 클릭 → 삭제 */
      document.getElementById('link-overlay').addEventListener('click', function (e) {
        var path = e.target.closest && e.target.closest('path[data-link-id]');
        if (!path || !boardState) return;
        var idx = parseInt(path.getAttribute('data-link-id'), 10);
        if (isNaN(idx)) return;
        boardState.links.splice(idx, 1);
        saveBoardState();
        redrawLinks();
      });

      /* 카드 클릭 → 연결 만들기 (linkMode일 때만) */
      document.addEventListener('click', function (e) {
        if (!document.body.classList.contains('link-mode')) return;
        var p = e.target.closest && e.target.closest('.postit[data-postit-id]');
        if (!p) return;
        var id = p.getAttribute('data-postit-id');
        var panel = p.getAttribute('data-panel');
        if (!id) return;
        if (pendingLink && pendingLink.id === id) { clearPendingLink(); return; }
        if (!pendingLink) {
          pendingLink = { id: id, panel: panel };
          p.classList.add('link-pending');
          return;
        }
        if (!boardState.links) boardState.links = [];
        // 중복 방지 (양방향 동일 취급)
        var dup = false;
        for (var j = 0; j < boardState.links.length; j++) {
          var L = boardState.links[j];
          if ((L.from.id === pendingLink.id && L.to.id === id) ||
              (L.from.id === id && L.to.id === pendingLink.id)) { dup = true; break; }
        }
        if (!dup) {
          boardState.links.push({
            from: { panel: pendingLink.panel, id: pendingLink.id },
            to:   { panel: panel, id: id }
          });
        }
        clearPendingLink();
        saveBoardState();
        redrawLinks();
      });

      /* Toggle button */
      var linkBtn = document.getElementById('link-btn');
      if (linkBtn) {
        linkBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          setLinkMode(!document.body.classList.contains('link-mode'));
        });
      }

      /* 리사이즈 시 재계산 */
      window.addEventListener('resize', redrawLinks);

      /* ---- Space-bar pause ---- */
      document.addEventListener('keydown', function (e) {
        if (e.code === 'Space' || e.key === ' ') {
          e.preventDefault();
          globalPaused = !globalPaused;
          var hint = document.getElementById('pause-hint');
          if (hint) {
            if (globalPaused) {
              hint.textContent = '[스페이스] 회전 재개 (일시정지 중)';
              hint.classList.add('paused');
            } else {
              hint.textContent = '[스페이스] 회전 일시정지';
              hint.classList.remove('paused');
            }
          }
        }
      });

      /* ---- Init ---- */
      fetchAndRender();
      if (sheetUrl) {
        setInterval(fetchAndRender, POLL_INTERVAL);
      }
    })();
  </script>
</body>
</html>
