---
// @ts-nocheck
/**
 * /ko/moderator/agenda/ — 4교시 의제선정 라이브 시각화 (다크 배경 · 프로젝터용)
 *
 * PRIVACY:
 *   - KO-only route (getStaticPaths emits only 'ko')
 *   - robots noindex,nofollow
 *   - NOT in sitemap (whitelist filter excludes /moderator/*)
 *   - NOT in pagefind (no data-pagefind-body)
 *   - No nav links to this page from public pages
 *
 * DATA SOURCE:
 *   - PUBLIC_AGENDA_SHEET_CSV_URL → Google Sheet (Form 응답 자동 적재)
 *   - Sheet 컬럼: 타임스탬프 | 우리 조 | 채택1 | 채택2 | 채택3 | 채택4 | 채택5 | 나머지1..8
 *   - Client-side fetch, poll every 10s
 *   - 동일 조 복수 응답 시 타임스탬프 최신 행 1개만 렌더
 *
 * LAYOUT:
 *   - 좌(A조) / 우(B조) 50:50 분할
 *   - 각 패널 상하 70:30 — 위 70% 채택 큰 카드 / 아래 30% 나머지 chip
 *   - 200명 가시성: 채택 본문 120px(1920px), ⭐ 200px, 나머지 chip 40px
 *
 * AUTO-ROTATE:
 *   - 채택 카드 > 3장이면 3장씩 슬라이딩 윈도우 (step=1, 8초 간격)
 *   - A·B 패널 독립 rotator
 *   - 스페이스로 전역 일시정지/재개
 *
 * DESIGN:
 *   - 다크 배경 #0f1419 (강당 형광등 가시성)
 *   - 채택 카드: 형광 노란 포스트잇 #fde047, 미세 회전, 강한 그림자
 *   - 나머지 chip: 다크 회색 #3f4248, 흰 글씨
 *   - A조 상단 strip: 청록 #06b6d4 / B조: 주황 #f97316
 *
 * CSV PARSING:
 *   - RFC 4180 quoted-CSV state machine (regulation.astro 동일 파서 재사용)
 *   - vanilla JS client-side only (rolldown .tsx 트랩 회피)
 */

import '../../../styles/global.css';

export async function getStaticPaths() {
  return [{ params: { lang: 'ko' } }];
}

const sheetCsvUrl = (import.meta.env.PUBLIC_AGENDA_SHEET_CSV_URL ?? '').trim();
---
<!doctype html>
<html lang="ko" dir="ltr" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>의제선정 결과 — 조별 채택 의제 [모더레이터]</title>
  <meta name="robots" content="noindex,nofollow" />
  <!-- No canonical, no hreflang, no OG — private page -->
  <style>
    /* ============================================================
       AGENDA SELECTION PAGE — 다크 배경 · 200명 강당 가시성
       ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #f8f6f0;                /* 화이트(살짝 따뜻한 종이톤) */
      --bg-panel: #fdfcf7;
      --bg-card-adopted: #fde047;
      --bg-card-remaining: #e7e2d6;
      --color-a: #0e7490;
      --color-b: #c2410c;
      --text-on-adopted: #1c1917;
      --text-on-remaining: #1c1917;
      --text-header: #1c1917;
      --text-muted: #6b6560;
      --border-divider: #d6cfbf;
      --font: 'Pretendard Variable', 'Pretendard', 'Noto Sans KR', sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text-header);
      font-family: var(--font);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ---- Privacy banner ---- */
    .privacy-banner {
      background: #4a1010;
      color: #fca5a5;
      text-align: center;
      padding: 5px 16px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      border-bottom: 1px solid #7f1d1d;
      flex-shrink: 0;
    }

    /* ---- Sub-nav (다크 테마) ---- */
    .subnav {
      background: #1a2130;
      border-bottom: 1px solid var(--border-divider);
      padding: 5px 14px;
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      color: var(--text-muted);
      flex-shrink: 0;
      flex-wrap: wrap;
    }
    .subnav-label { font-weight: 700; margin-right: 4px; color: #a0aec0; }
    .subnav a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid transparent;
    }
    .subnav a:hover { color: #e2e8f0; border-color: #4a5568; }
    .subnav a.current { color: var(--color-b); border-color: var(--color-b); font-weight: 600; }
    .subnav-sep { color: #4a5568; }

    /* ---- Env error banner ---- */
    .env-error-banner {
      background: #1a0a0a;
      border: 1px solid #7f1d1d;
      color: #fca5a5;
      padding: 16px 20px;
      margin: 16px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      line-height: 1.6;
    }

    /* ---- Page header ---- */
    .page-header {
      padding: 10px 20px 8px;
      display: flex;
      align-items: baseline;
      gap: 12px;
      border-bottom: 1px solid var(--border-divider);
      background: #161c24;
      flex-shrink: 0;
    }
    .page-header h1 {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-header);
    }
    .page-header .status {
      font-size: 12px;
      color: var(--text-muted);
      margin-left: auto;
    }
    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #4a5568;
      margin-right: 4px;
      vertical-align: middle;
    }
    .status-dot.live { background: #22c55e; animation: pulse 2s infinite; }
    .status-dot.demo { background: #f59e0b; }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* ---- Space-pause hint ---- */
    .pause-hint {
      font-size: 11px;
      color: var(--text-muted);
      margin-left: 16px;
      opacity: 0.7;
    }
    .pause-hint.paused { color: #f59e0b; opacity: 1; }

    /* ---- Main split layout ---- */
    .split-wrapper {
      flex: 1;
      display: flex;
      flex-direction: row;
      gap: 28px;                       /* 가운데 드래그 통로 */
      min-height: 0;
      overflow: hidden;
      background: var(--border-divider);
    }

    /* ---- Panel (A조 or B조) ---- */
    .panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-width: 0;
      background: var(--bg-panel);
    }

    /* ---- DnD styles ---- */
    .postit { cursor: grab; user-select: none; }
    .postit:active { cursor: grabbing; }
    .postit.dragging { opacity: 0.35; transform: scale(0.97) !important; }
    .postit.drop-target-before { box-shadow: 0 -6px 0 0 #06b6d4, 4px 7px 18px rgba(0,0,0,0.18); }
    .postit.drop-target-after  { box-shadow: 0 6px 0 0 #06b6d4, 4px 7px 18px rgba(0,0,0,0.18); }
    .postit-grid.drop-empty { outline: 4px dashed #06b6d4; outline-offset: -10px; }

    /* ---- Reset button (small, top-right of page header) ---- */
    .reset-btn {
      margin-left: 14px;
      background: transparent;
      border: 1px solid var(--border-divider);
      color: var(--text-muted);
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      letter-spacing: 0.04em;
    }
    .reset-btn:hover { background: #ece6d6; color: var(--text-header); }
    .reset-btn[hidden] { display: none; }

    /* ---- Link mode ---- */
    .link-btn {
      margin-left: 10px;
      background: transparent;
      border: 1px solid var(--border-divider);
      color: var(--text-muted);
      padding: 4px 12px;
      font-size: 11px;
      font-weight: 700;
      border-radius: 4px;
      cursor: pointer;
      letter-spacing: 0.04em;
    }
    .link-btn:hover { background: #ece6d6; color: var(--text-header); }
    body.link-mode .link-btn { background: #0e7490; color: #fff; border-color: #0e7490; }
    body.link-mode .postit { cursor: crosshair; }
    body.link-mode .postit.link-pending { outline: 4px solid #0e7490; outline-offset: 4px; }
    body.link-mode .postit.link-pending::after {
      content: '연결 대상 선택...';
      position: absolute; top: 4px; right: 8px;
      font-size: 12px; color: #0e7490; font-weight: 700;
      background: rgba(255,255,255,0.85); padding: 2px 6px; border-radius: 3px;
    }

    /* ---- SVG link overlay ---- */
    .link-overlay {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      pointer-events: none;
      z-index: 5;
    }
    .link-overlay path {
      fill: none;
      stroke: #0e7490;
      stroke-width: 4;
      stroke-linecap: round;
      pointer-events: stroke;
      cursor: pointer;
      opacity: 0.78;
      filter: drop-shadow(0 1px 2px rgba(0,0,0,0.18));
    }
    .link-overlay path:hover { stroke: #c2410c; stroke-width: 6; opacity: 1; }
    .link-overlay circle {
      fill: #0e7490;
      pointer-events: none;
    }
    .split-wrapper { position: relative; }

    /* ---- Panel header ---- */
    .panel-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 20px 8px;
      border-bottom: 3px solid;
      flex-shrink: 0;
      background: #0f1419;
    }
    .panel-a .panel-header { border-color: var(--color-a); }
    .panel-b .panel-header { border-color: var(--color-b); }

    .panel-label {
      font-size: 36px;
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .panel-a .panel-label { color: var(--color-a); }
    .panel-b .panel-label { color: var(--color-b); }

    .panel-sublabel {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .response-time {
      margin-left: auto;
      font-size: 11px;
      color: var(--text-muted);
    }

    /* ---- ADOPTED ZONE (상단 70%) ---- */
    .adopted-zone {
      flex: 1 1 auto;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: 20px 24px 28px;
      position: relative;
    }
    .remaining-zone { display: none !important; }

    .adopted-zone-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 10px;
      flex-shrink: 0;
    }

    /* ============================================================
       NEW POSTIT GRID — 어제 regulation-feedback 톤
       (작은 종이 포스트잇 여러 개를 grid로 흩뿌리기)
       ============================================================ */
    .postit-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(0, 1fr);
      gap: 36px;
      padding: 20px 18px 28px;
      min-height: 0;
      overflow: hidden;
      align-content: stretch;
    }
    body[data-view="a"] .postit-grid,
    body[data-view="b"] .postit-grid {
      gap: 52px;
      padding: 28px 32px 40px;
    }
    .postit {
      position: relative;
      padding: 18px 26px 22px 22px;
      border-radius: 4px;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 22px;
      font-family: var(--font);
      box-shadow:
        4px 7px 18px rgba(0, 0, 0, 0.45),
        inset 0 -3px 8px rgba(0, 0, 0, 0.08),
        inset 0 2px 0 rgba(255, 255, 255, 0.5);
      transition: transform 0.25s ease;
      min-height: 0;
      overflow: hidden;
    }
    /* "테이프" 상단 strip */
    .postit::before {
      content: '';
      position: absolute;
      top: -8px;
      left: 50%;
      transform: translateX(-50%) rotate(-3deg);
      width: 70px;
      height: 22px;
      background: rgba(255, 255, 255, 0.35);
      box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    }
    /* 색상 5종 — A조는 노란계열, B조는 주황계열 위주 */
    .panel-a .postit:nth-child(5n+1) { background: #fef08a; color: #1a1a00; }
    .panel-a .postit:nth-child(5n+2) { background: #fde047; color: #1a1a00; }
    .panel-a .postit:nth-child(5n+3) { background: #fbbf24; color: #1a1000; }
    .panel-a .postit:nth-child(5n+4) { background: #a7f3d0; color: #052e16; }
    .panel-a .postit:nth-child(5n)   { background: #bae6fd; color: #001a26; }
    .panel-b .postit:nth-child(5n+1) { background: #fed7aa; color: #1a0a00; }
    .panel-b .postit:nth-child(5n+2) { background: #fdba74; color: #1a0a00; }
    .panel-b .postit:nth-child(5n+3) { background: #fda4af; color: #1a0006; }
    .panel-b .postit:nth-child(5n+4) { background: #fef08a; color: #1a1a00; }
    .panel-b .postit:nth-child(5n)   { background: #c4b5fd; color: #0c0420; }
    /* 회전 다양화 */
    .postit:nth-child(odd)  { transform: rotate(-1.8deg); }
    .postit:nth-child(even) { transform: rotate(1.5deg); }
    .postit:nth-child(3n)   { transform: rotate(-0.6deg); }
    .postit:nth-child(5n)   { transform: rotate(2deg); }
    .postit:nth-child(7n)   { transform: rotate(-2.3deg); }

    .postit-star {
      align-self: center;
      flex-shrink: 0;
      font-size: 56px;
      line-height: 1;
      color: #b45309;
      text-shadow: 0 0 10px rgba(245, 158, 11, 0.7);
      font-family: 'Segoe UI Symbol', 'Apple Color Emoji', sans-serif;
    }
    .postit-text {
      flex: 1;
      min-width: 0;
      font-size: 30px;
      font-weight: 800;
      line-height: 1.28;
      word-break: keep-all;
      overflow-wrap: break-word;
      letter-spacing: -0.01em;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      white-space: pre-line;
    }
    @media (min-width: 1280px) {
      .postit-star { font-size: 54px; }
      .postit-text { font-size: 34px; }
    }
    @media (min-width: 1600px) {
      .postit-star { font-size: 64px; }
      .postit-text { font-size: 40px; }
    }
    @media (min-width: 1920px) {
      .postit-star { font-size: 76px; }
      .postit-text { font-size: 48px; line-height: 1.26; }
    }
    @media (min-width: 2400px) {
      .postit-star { font-size: 92px; }
      .postit-text { font-size: 60px; }
    }
    /* 단일 조 뷰: 1.4x */
    body[data-view="a"] .postit-star,
    body[data-view="b"] .postit-star { font-size: 84px; }
    body[data-view="a"] .postit-text,
    body[data-view="b"] .postit-text { font-size: 56px; }
    @media (min-width: 1600px) {
      body[data-view="a"] .postit-star, body[data-view="b"] .postit-star { font-size: 100px; }
      body[data-view="a"] .postit-text, body[data-view="b"] .postit-text { font-size: 68px; }
    }
    @media (min-width: 1920px) {
      body[data-view="a"] .postit-star, body[data-view="b"] .postit-star { font-size: 120px; }
      body[data-view="a"] .postit-text, body[data-view="b"] .postit-text { font-size: 82px; }
    }

    /* legacy 1장 모드 (사용 안 함) */
    .adopted-cards-viewport {
      flex: 1;
      position: relative;
      overflow: hidden;
      min-height: 0;
    }

    /* ---- Adopted card (형광 노란 포스트잇) — 1장씩 전체 영역 차지 ---- */
    .adopted-card {
      position: absolute;
      inset: 12px;
      border-radius: 6px;
      background: var(--bg-card-adopted);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow:
        8px 14px 40px rgba(0, 0, 0, 0.7),
        2px 4px 10px rgba(0, 0, 0, 0.5),
        inset 0 2px 0 rgba(255, 255, 255, 0.5);
      opacity: 1;
      transition: opacity 0.4s ease, transform 0.3s ease;
      transform: rotate(-1.6deg);
    }
    .adopted-card.alt-rotate { transform: rotate(1.4deg); }

    /* A vs B strip at top of card */
    .adopted-card::before {
      content: '';
      display: block;
      height: 10px;
      flex-shrink: 0;
    }
    .panel-a .adopted-card::before { background: var(--color-a); }
    .panel-b .adopted-card::before { background: var(--color-b); }

    .adopted-card.fading { opacity: 0; }

    /* ---- Star mark (CSS only for cross-OS consistency at 200px) ---- */
    .star-mark {
      position: absolute;
      top: 16px;
      left: 20px;
      font-size: 100px;
      line-height: 1;
      color: #f59e0b;
      text-shadow:
        0 0 12px rgba(245, 158, 11, 0.9),
        0 0 28px rgba(245, 158, 11, 0.6),
        0 0 50px rgba(245, 158, 11, 0.3);
      user-select: none;
      pointer-events: none;
      font-family: 'Segoe UI Symbol', 'Apple Color Emoji', sans-serif;
    }

    .adopted-card-body {
      flex: 1;
      padding: 20px 28px 24px 28px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
    }

    .adopted-text {
      font-size: 60px;
      font-weight: 900;
      line-height: 1.3;
      letter-spacing: -0.02em;
      color: var(--text-on-adopted);
      word-break: keep-all;
      overflow-wrap: break-word;
      font-family: var(--font);
    }

    /* ---- 해상도별 자동 확대 — 채택 카드 (양조 모드) ---- */
    @media (min-width: 1280px) {
      .star-mark { font-size: 120px; }
      .adopted-text { font-size: 84px; }
      .panel-label { font-size: 48px; }
    }
    @media (min-width: 1600px) {
      .star-mark { font-size: 160px; }
      .adopted-text { font-size: 108px; }
      .panel-label { font-size: 60px; }
    }
    @media (min-width: 1920px) {
      .star-mark { font-size: 200px; }
      .adopted-text { font-size: 132px; line-height: 1.22; }
      .panel-label { font-size: 72px; }
    }
    @media (min-width: 2400px) {
      .star-mark { font-size: 240px; }
      .adopted-text { font-size: 156px; }
      .panel-label { font-size: 88px; }
    }

    /* ---- 단일 조 모드: 한 조가 전체 화면 차지하면 폰트 1.5x ---- */
    body[data-view="a"] .panel-b,
    body[data-view="b"] .panel-a { display: none !important; }
    body[data-view="a"] .panel-a,
    body[data-view="b"] .panel-b { flex: 1 1 100%; border-right: none; }
    body[data-view="a"] .adopted-text,
    body[data-view="b"] .adopted-text { font-size: 132px; }
    body[data-view="a"] .star-mark,
    body[data-view="b"] .star-mark { font-size: 200px; }
    body[data-view="a"] .panel-label,
    body[data-view="b"] .panel-label { font-size: 96px; }
    body[data-view="a"] .remaining-chip,
    body[data-view="b"] .remaining-chip { font-size: 48px; padding: 10px 24px 12px; }
    @media (min-width: 1600px) {
      body[data-view="a"] .adopted-text,
      body[data-view="b"] .adopted-text { font-size: 168px; }
      body[data-view="a"] .star-mark,
      body[data-view="b"] .star-mark { font-size: 260px; }
      body[data-view="a"] .panel-label,
      body[data-view="b"] .panel-label { font-size: 120px; }
      body[data-view="a"] .remaining-chip,
      body[data-view="b"] .remaining-chip { font-size: 60px; }
    }
    @media (min-width: 1920px) {
      body[data-view="a"] .adopted-text,
      body[data-view="b"] .adopted-text { font-size: 200px; line-height: 1.18; }
      body[data-view="a"] .star-mark,
      body[data-view="b"] .star-mark { font-size: 320px; }
      body[data-view="a"] .panel-label,
      body[data-view="b"] .panel-label { font-size: 140px; }
      body[data-view="a"] .remaining-chip,
      body[data-view="b"] .remaining-chip { font-size: 72px; }
    }

    /* ---- 포스트잇 강화: 약간 회전 + corner curl + 미세 결 ---- */
    .adopted-card {
      background-image:
        linear-gradient(135deg, rgba(255,255,255,0.18) 0%, transparent 30%),
        linear-gradient(180deg, var(--bg-card-adopted), #fcd34d 100%);
    }
    .adopted-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
