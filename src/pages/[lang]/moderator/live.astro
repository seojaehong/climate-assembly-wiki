---
// @ts-nocheck
/**
 * /ko/moderator/live/ — 모더레이터 라이브 대시보드 (시뮬레이션 + Google Sheet)
 *
 * PRIVACY:
 *   - KO-only route (getStaticPaths emits only 'ko')
 *   - robots noindex,nofollow
 *   - NOT in sitemap (sitemap filter is whitelist: only /agenda + locale home)
 *   - NOT in pagefind (no data-pagefind-body)
 *   - No nav links to this page anywhere
 *
 * DATA SOURCES (user-selectable):
 *   - "더미 데이터 (104행)" → sim-questions.json (shipped at build time)
 *   - "의제 샘플 (5행)"  → sample-agenda-questions.json (5 agenda-derived rows)
 *   - "Google Sheet"     → fetch(PUBLIC_LIVE_SHEET_CSV_URL), poll every 30s
 *
 * SIMULATION ENGINE:
 *   - Play/pause/next/prev controls
 *   - Day+channel selector
 *   - Speed: 1x (10s), 2x (5s), 5x (2s)
 *   - State persisted in sessionStorage
 */

import simQuestions from '../../../data/sim-questions.json';
import sampleQuestions from '../../../data/sample-agenda-questions.json';
import sample15Groups from '../../../data/sample-agenda-15groups.json';
import '../../../styles/global.css';

export async function getStaticPaths() {
  // KO-only: this is a Korean workshop tool; one consumer; minimises leakage surface.
  // Delta from build: +1 page.
  return [{ params: { lang: 'ko' } }];
}

// Compute unique experts for tally (sim dataset)
const experts = [...new Set(
  simQuestions
    .map(q => q.expert)
    .filter(e => e && e !== '' && e !== '공통')
)];

// Google Sheet CSV URL from build-time env (may be undefined → shows guide)
const sheetCsvUrl = import.meta.env.PUBLIC_LIVE_SHEET_CSV_URL ?? '';
---
<!doctype html>
<html lang="ko" dir="ltr" data-theme="dark" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>모더레이터 라이브 대시보드 [SIM]</title>
  <meta name="robots" content="noindex,nofollow" />
  <meta name="description" content="모더레이터 운영 전용 페이지 — 시뮬레이션 데이터" />
  <!-- No canonical, no hreflang, no OG — private page -->
  <style>
    /* ============================================================
       MODERATOR LIVE DASHBOARD — dark-first, projector-optimised
       Uses design tokens from global.css (imported above).
       ============================================================ */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--color-bg, #0d1117);
      color: var(--color-fg, #f3f4f6);
      font-family: var(--font-body, 'Pretendard Variable', sans-serif);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* ---- Privacy banner ---- */
    .privacy-banner {
      background: #7c2d12;
      color: #fed7aa;
      text-align: center;
      padding: var(--space-2) var(--space-4);
      font-size: var(--text-sm);
      font-weight: 600;
      letter-spacing: var(--tracking-wide);
      border-bottom: 2px solid #ea580c;
      flex-shrink: 0;
    }

    /* ---- Sub-nav ---- */
    .subnav {
      background: var(--color-bg-subtle, #161b22);
      border-bottom: 1px solid var(--color-border, #30363d);
      padding: 6px 16px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--color-fg-muted, #8b949e);
      flex-shrink: 0;
    }
    .subnav-label { font-weight: 700; margin-right: 4px; }
    .subnav a {
      color: var(--color-fg-muted, #8b949e);
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid transparent;
      transition: color 0.1s, border-color 0.1s;
    }
    .subnav a:hover { color: var(--color-fg, #f3f4f6); border-color: var(--color-border, #30363d); }
    .subnav a.current { color: #58a6ff; border-color: #58a6ff; font-weight: 600; }
    .subnav-sep { color: var(--color-border, #30363d); }

    /* ---- Data source selector bar ---- */
    .source-bar {
      background: var(--color-bg, #0d1117);
      border-bottom: 1px solid var(--color-border, #30363d);
      padding: 8px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      flex-shrink: 0;
    }
    .source-label {
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      font-weight: 600;
      white-space: nowrap;
    }
    .source-btn {
      background: var(--color-card-bg, #161b22);
      border: 1px solid var(--color-border, #30363d);
      color: var(--color-fg-muted, #9ca3af);
      border-radius: var(--radius-sm);
      padding: 4px 10px;
      cursor: pointer;
      font-size: var(--text-xs);
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .source-btn:hover { color: var(--color-fg, #f3f4f6); border-color: var(--color-fg-muted, #9ca3af); }
    .source-btn.active {
      background: #1e3a5f;
      color: #60a5fa;
      border-color: #60a5fa;
      font-weight: 600;
    }
    .source-btn.active.sheet {
      background: #1a3028;
      color: #34d399;
      border-color: #34d399;
    }
    .sheet-status {
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      margin-left: 4px;
    }
    .sheet-status.live { color: #34d399; }

    /* ---- Sheet guide panel ---- */
    .sheet-guide {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: var(--radius-md);
      padding: var(--space-4);
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      line-height: 1.7;
      display: none;
      margin: var(--space-3) var(--space-4);
    }
    .sheet-guide.visible { display: block; }
    .sheet-guide code {
      background: #0d1117;
      padding: 1px 5px;
      border-radius: 3px;
      font-family: monospace;
      color: #e6edf3;
    }

    /* ---- Layout grid ---- */
    .dashboard {
      display: grid;
      grid-template-columns: 220px 1fr 220px;
      grid-template-rows: auto 1fr auto;
      gap: 0;
      flex: 1;
      min-height: 0;
    }

    @media (max-width: 900px) {
      .dashboard {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
      }
      .sidebar { display: none; }
    }

    /* ---- Controls bar ---- */
    .controls-bar {
      grid-column: 1 / -1;
      background: var(--color-bg-subtle, #161b22);
      border-bottom: 1px solid var(--color-border, #30363d);
      padding: var(--space-3) var(--space-4);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
    }

    .sim-badge {
      background: var(--color-warn, #fbbf24);
      color: #000;
      font-size: var(--text-xs);
      font-weight: 700;
      padding: 2px var(--space-2);
      border-radius: var(--radius-full);
      letter-spacing: var(--tracking-wide);
      flex-shrink: 0;
    }
    .sim-badge.sheet-live {
      background: #34d399;
      color: #064e3b;
    }

    .controls-group {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .ctrl-btn {
      background: var(--color-card-bg, #161b22);
      border: 1px solid var(--color-border, #30363d);
      color: var(--color-fg, #f3f4f6);
      border-radius: var(--radius-sm);
      padding: var(--space-2) var(--space-3);
      cursor: pointer;
      font-size: var(--text-lg);
      line-height: 1;
      transition: background var(--transition-fast);
    }
    .ctrl-btn:hover { background: var(--color-card-hover, #1c2230); }
    .ctrl-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .ctrl-btn.active {
      background: var(--color-accent, #34d399);
      color: var(--color-accent-fg, #064e3b);
      border-color: var(--color-accent, #34d399);
    }

    select.ctrl-select {
      background: var(--color-card-bg, #161b22);
      border: 1px solid var(--color-border, #30363d);
      color: var(--color-fg, #f3f4f6);
      border-radius: var(--radius-sm);
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-sm);
      cursor: pointer;
    }

    .ctrl-label {
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
    }

    .pos-counter {
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
      margin-left: auto;
      white-space: nowrap;
    }

    /* ---- Sidebar (process flow) ---- */
    .sidebar {
      background: var(--color-bg-subtle, #161b22);
      border-right: 1px solid var(--color-border, #30363d);
      padding: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .sidebar-right {
      border-right: none;
      border-left: 1px solid var(--color-border, #30363d);
    }

    .sidebar-title {
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      margin-bottom: var(--space-1);
    }

    /* Process flow SVG step */
    .flow-steps {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .flow-step {
      display: flex;
      align-items: flex-start;
      gap: var(--space-2);
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      line-height: 1.4;
    }
    .flow-step.active {
      color: var(--color-accent, #34d399);
      font-weight: 600;
    }
    .flow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-border, #30363d);
      flex-shrink: 0;
      margin-top: 3px;
    }
    .flow-step.active .flow-dot {
      background: var(--color-accent, #34d399);
      box-shadow: 0 0 6px var(--color-accent, #34d399);
    }
    .flow-connector {
      width: 1px;
      height: 12px;
      background: var(--color-border, #30363d);
      margin-left: 3px;
    }

    /* ---- Main content ---- */
    .main-content {
      padding: var(--space-6) var(--space-8);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      min-height: 0;
      overflow-y: auto;
    }

    /* ---- Current card ---- */
    .current-card {
      border: 2px solid var(--color-accent, #34d399);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      background: var(--color-card-bg, #161b22);
      position: relative;
      overflow: hidden;
    }

    @keyframes pulse-border {
      0%, 100% { border-color: var(--color-accent, #34d399); opacity: 1; }
      50% { border-color: var(--color-accent-hover, #6ee7b7); opacity: 0.7; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .current-card.playing {
        animation: pulse-border 2.5s ease-in-out infinite;
      }
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
      flex-wrap: wrap;
    }

    .card-label {
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      color: var(--color-accent, #34d399);
    }

    .meta-pill {
      background: var(--color-accent-subtle, #022c22);
      color: var(--color-accent, #34d399);
      font-size: var(--text-xs);
      padding: 2px var(--space-2);
      border-radius: var(--radius-full);
      font-weight: 600;
    }

    .meta-pill.expert {
      background: var(--color-info-bg, #0c1a2e);
      color: var(--color-info, #60a5fa);
    }

    .meta-pill.time {
      background: var(--color-bg, #0d1117);
      color: var(--color-fg-muted, #9ca3af);
    }

    .content-text {
      font-size: clamp(1.25rem, 2.5vw, 1.875rem);
      line-height: var(--leading-relaxed);
      letter-spacing: var(--tracking-korean);
      color: var(--color-fg, #f3f4f6);
      word-break: keep-all;
    }

    .speaker-line {
      margin-top: var(--space-4);
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
    }

    .empty-state {
      text-align: center;
      padding: var(--space-12) 0;
      color: var(--color-fg-muted, #9ca3af);
      font-size: var(--text-xl);
    }

    /* ---- Next queue ---- */
    .next-section-title {
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-fg-muted, #9ca3af);
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .next-queue {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .next-item {
      border: 1px solid var(--color-border, #30363d);
      border-radius: var(--radius-md);
      padding: var(--space-3) var(--space-4);
      background: var(--color-card-bg, #161b22);
      display: flex;
      gap: var(--space-3);
      align-items: flex-start;
      transition: opacity var(--transition-fast);
    }
    .next-item:nth-child(2) { opacity: 0.7; }
    .next-item:nth-child(3) { opacity: 0.45; }

    .next-item-meta {
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
      flex-shrink: 0;
    }

    .next-item-content {
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ---- Progress bar ---- */
    .progress-bar-section {
      border-top: 1px solid var(--color-border, #30363d);
      padding-top: var(--space-4);
    }

    .progress-row {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-3);
    }

    .progress-label {
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
      white-space: nowrap;
    }

    .progress-track {
      flex: 1;
      height: 8px;
      background: var(--color-border, #30363d);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--color-accent, #34d399);
      border-radius: var(--radius-full);
      transition: width var(--transition-slow);
    }

    .progress-pct {
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-accent, #34d399);
      white-space: nowrap;
    }

    /* Expert tally */
    .tally-section {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .tally-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .tally-name {
      font-size: var(--text-sm);
      color: var(--color-fg-muted, #9ca3af);
      width: 80px;
      flex-shrink: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tally-bar-track {
      flex: 1;
      height: 6px;
      background: var(--color-border, #30363d);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .tally-bar-fill {
      height: 100%;
      background: var(--color-info, #60a5fa);
      border-radius: var(--radius-full);
      transition: width var(--transition-slow);
    }

    .tally-bar-fill.common {
      background: var(--color-fg-muted, #9ca3af);
    }

    .tally-count {
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--color-fg, #f3f4f6);
      width: 24px;
      text-align: right;
      flex-shrink: 0;
    }

    /* ---- Right sidebar: timer + eta ---- */
    .timer-display {
      font-size: var(--text-4xl);
      font-variant-numeric: tabular-nums;
      color: var(--color-accent, #34d399);
      font-weight: 700;
      letter-spacing: var(--tracking-tight);
    }

    .eta-info {
      font-size: var(--text-xs);
      color: var(--color-fg-muted, #9ca3af);
      line-height: 1.6;
    }

    .status-dots {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: var(--space-2);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-border, #30363d);
    }
    .status-dot.done { background: var(--color-accent, #34d399); }
    .status-dot.current { background: var(--color-warn, #fbbf24); }

    /* ============================================================
       STATUS TRANSITIONS — 선정 / 발표완료 / 발표중
       Applied via data-status="…" on .question-card, .next-item,
       and .current-card. Computed from effectiveStatus() which
       bridges sim state (current/done) ↔ sheet 한국어 values.
       ============================================================ */

    /* ── 선정 (highlighted — the "남기는 효과") ─────────────────── */
    .current-card[data-status="선정"],
    .next-item[data-status="선정"] {
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent, #34d399) 8%, var(--color-card-bg, #161b22)) 0%,
        var(--color-card-bg, #161b22) 100%
      );
      border-left: 4px solid var(--color-accent, #34d399);
      box-shadow:
        0 0 20px color-mix(in srgb, var(--color-accent, #34d399) 30%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--color-accent, #34d399) 15%, transparent);
      transform: scale(1.02);
      transition: transform 0.4s ease-out, box-shadow 0.4s ease-out, background 0.4s ease-out;
    }

    .current-card[data-status="선정"] .content-text,
    .next-item[data-status="선정"] .next-item-content {
      text-shadow: 0 0 12px color-mix(in srgb, var(--color-accent, #34d399) 25%, transparent);
    }

    @keyframes pulse-selected {
      0%, 100% {
        background: linear-gradient(
          135deg,
          color-mix(in srgb, var(--color-accent, #34d399) 8%, var(--color-card-bg, #161b22)) 0%,
          var(--color-card-bg, #161b22) 100%
        );
      }
      50% {
        background: linear-gradient(
          135deg,
          color-mix(in srgb, var(--color-accent, #34d399) 14%, var(--color-card-bg, #161b22)) 0%,
          color-mix(in srgb, var(--color-accent, #34d399) 4%, var(--color-card-bg, #161b22)) 100%
        );
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      .current-card[data-status="선정"],
      .next-item[data-status="선정"] {
        animation: pulse-selected 2.5s ease-in-out infinite;
      }
    }

    /* ── 발표완료 (done — fades away) ───────────────────────────── */
    .current-card[data-status="발표완료"],
    .next-item[data-status="발표완료"] {
      opacity: 0.35;
      filter: grayscale(0.5);
      transform: scale(0.97);
      transition: opacity 0.6s ease-in, filter 0.6s ease-in, transform 0.6s ease-in;
      box-shadow: none;
    }

    .current-card[data-status="발표완료"] .content-text,
    .next-item[data-status="발표완료"] .next-item-content {
      text-decoration: line-through;
      text-decoration-color: color-mix(in srgb, var(--color-fg-muted, #9ca3af) 50%, transparent);
    }

    /* ── 발표중 (선정 + extra emphasis) ─────────────────────────── */
    .current-card[data-status="발표중"],
    .next-item[data-status="발표중"] {
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent, #34d399) 12%, var(--color-card-bg, #161b22)) 0%,
        var(--color-card-bg, #161b22) 100%
      );
      border-left: 4px solid var(--color-accent, #34d399);
      box-shadow:
        0 0 32px color-mix(in srgb, var(--color-accent, #34d399) 60%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--color-accent, #34d399) 20%, transparent);
      transform: scale(1.02);
      transition: transform 0.4s ease-out, box-shadow 0.4s ease-out;
    }

    .current-card[data-status="발표중"] .content-text {
      font-size: 1.15em;
    }

    @keyframes bounce-announcing {
      0%, 100% { transform: scale(1.02) translateY(0); }
      50% { transform: scale(1.02) translateY(-2px); }
    }

    @media (prefers-reduced-motion: no-preference) {
      .current-card[data-status="발표중"],
      .next-item[data-status="발표중"] {
        animation: bounce-announcing 1.5s ease-in-out infinite;
      }
    }

    /* ── 대기 (default — explicit reset) ────────────────────────── */
    .current-card[data-status="대기"],
    .next-item[data-status="대기"] {
      opacity: 1;
      filter: none;
      transform: scale(1);
      box-shadow: none;
      background: var(--color-card-bg, #161b22);
      border-left: none;
      animation: none;
      transition: transform 0.4s ease-out, opacity 0.4s ease-out;
    }

    /* ── Next-up flash: green flash on queue cards when 선정 advances ── */
    @keyframes next-up-flash {
      0%   { box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent, #34d399) 80%, transparent); }
      60%  { box-shadow: 0 0 12px 4px color-mix(in srgb, var(--color-accent, #34d399) 50%, transparent); }
      100% { box-shadow: none; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .next-item.next-up-flash {
        animation: next-up-flash 1.5s ease-out forwards;
      }
    }
  </style>
</head>
<body>
