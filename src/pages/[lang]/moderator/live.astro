  </div>

  <!-- Embedded build-time data — avoids Vite define:vars serialisation issues -->
  <script id="sim-data" type="application/json" set:html={JSON.stringify(simQuestions)}></script>
  <script id="sample-data" type="application/json" set:html={JSON.stringify(sampleQuestions)}></script>
  <script id="sample-15-data" type="application/json" set:html={JSON.stringify(sample15Groups)}></script>
  <script id="sim-experts" type="application/json" set:html={JSON.stringify(experts)}></script>
  <script id="sheet-csv-url" type="application/json" set:html={JSON.stringify(sheetCsvUrl)}></script>

  <script is:inline>
    // ============================================================================
    // DATA SOURCES
    // 'sim'    → 104-row dummy dataset (shipped JSON)
    // 'sample' → 5-row agenda-derived sample (shipped JSON)
    // 'sheet'  → Google Sheets CSV (client-side fetch, poll every 30s)
    //
    // Column mapping (CSV Korean → JS engine keys):
    //   순번     → id       (integer, used as sessionStorage key)
    //   일자     → date
    //   채널     → channel
    //   지역     → region
    //   분임     → group    (strip "조" suffix)
    //   답변자   → expert
    //   내용     → content
    //   예정시간 → scheduled_time (appended ":00" for HH:MM:SS)
    //   상태     → status
    //   day is synthesised as 1 for sample/sheet rows (day filter shows "1일차")
    // ============================================================================

    const SIM_DATA       = JSON.parse(document.getElementById('sim-data').textContent);
    const SAMPLE_DATA    = JSON.parse(document.getElementById('sample-data').textContent);
    const SAMPLE_15_DATA = JSON.parse(document.getElementById('sample-15-data').textContent);
    const SIM_EXPERTS    = JSON.parse(document.getElementById('sim-experts').textContent);
    const SHEET_CSV_URL  = JSON.parse(document.getElementById('sheet-csv-url').textContent);

    // Compute expert list for 15-group sample (유종민·김민경·은재호, excluding 공통)
    const SAMPLE_15_EXPERTS = [...new Set(
      SAMPLE_15_DATA.map(q => q.expert).filter(e => e && e !== '공통')
    )];

    // ── CSV parser (state-machine, handles quoted fields with embedded commas/newlines) ──
    function parseCSV(text) {
      const rows = [];
      let col = '', row = [], inQuote = false;

      const flush = () => { row.push(col); col = ''; };
      const pushRow = () => { if (row.length > 0) rows.push(row); row = []; };

      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        const next = text[i + 1];

        if (inQuote) {
          if (ch === '"' && next === '"') { col += '"'; i++; }         // escaped quote
          else if (ch === '"') { inQuote = false; }                    // close quote
          else { col += ch; }
        } else {
          if (ch === '"') { inQuote = true; }
          else if (ch === ',') { flush(); }
          else if (ch === '\r' && next === '\n') { flush(); pushRow(); i++; }
          else if (ch === '\n' || ch === '\r') { flush(); pushRow(); }
          else { col += ch; }
        }
      }
      if (col || row.length > 0) { flush(); pushRow(); }
      return rows;
    }

    // Map CSV Korean headers → JS engine shape
    const COL_MAP = {
      '순번':     'id',
      '일자':     'date',
      '채널':     'channel',
      '지역':     'region',
      '분임':     'group',
      '답변자':   'expert',
      '내용':     'content',
      '예정시간': 'scheduled_time',
      '상태':     'status',
    };

    function csvToRows(text) {
      const parsed = parseCSV(text.trim());
      if (parsed.length < 2) return [];

      const headers = parsed[0].map(h => h.trim());
      const result = [];

      for (let r = 1; r < parsed.length; r++) {
        const cells = parsed[r];
        if (cells.every(c => !c.trim())) continue;    // skip empty rows
        const obj = {};
        headers.forEach((h, i) => {
          const key = COL_MAP[h] || h;
          obj[key] = (cells[i] || '').trim();
        });
        // Normalise types
        obj.id = parseInt(obj.id, 10) || r;
        obj.day = 1;                                   // synthetic workshop day for filter
        if (obj.group) obj.group = obj.group.replace('조', '');
        if (obj.scheduled_time && !obj.scheduled_time.includes(':00', 4)) {
          obj.scheduled_time = obj.scheduled_time + ':00';
        }
        result.push(obj);
      }
      return result;
    }

    // ── App data state ────────────────────────────────────────────────────────
    let currentSource = 'sample-15';
    let data = SAMPLE_15_DATA;
    let experts = SAMPLE_15_EXPERTS;
    let sheetPollTimer = null;

    const SPEEDS = { 1: 10000, 2: 5000, 5: 2000 };
    const POLL_INTERVAL_MS = 30000;

    // ── Sim state ─────────────────────────────────────────────────────────────
    let state = {
      playing: false,
      speed: 1,
      currentIndex: -1,
      filterDay: 'all',
      filterChannel: 'all',
      statuses: {},
      dataSource: 'sample-15',
    };

    function saveState() {
      try { sessionStorage.setItem('mod-sim-state', JSON.stringify(state)); } catch (_) {}
    }

    function loadState() {
      try {
        const s = sessionStorage.getItem('mod-sim-state');
        if (s) state = { ...state, ...JSON.parse(s) };
      } catch (_) {}
    }

    function getFiltered() {
      return data.filter(q => {
        if (state.filterDay !== 'all' && String(q.day) !== state.filterDay) return false;
        if (state.filterChannel !== 'all' && q.channel !== state.filterChannel) return false;
        return true;
      });
    }

    // ── DOM refs ──────────────────────────────────────────────────────────────
    const btnPlay    = document.getElementById('btn-play');
    const btnPrev    = document.getElementById('btn-prev');
    const btnNext    = document.getElementById('btn-next');
    const selDay     = document.getElementById('sel-day');
    const selChannel = document.getElementById('sel-channel');
    const posCounter = document.getElementById('pos-counter');
    const currentCard    = document.getElementById('current-card');
    const emptyState     = document.getElementById('empty-state');
    const currentContent = document.getElementById('current-content');
    const cardMeta       = document.getElementById('card-meta');
    const contentText    = document.getElementById('content-text');
    const speakerLine    = document.getElementById('speaker-line');
    const nextTitle      = document.getElementById('next-title');
    const nextCount      = document.getElementById('next-count');
    const nextQueue      = document.getElementById('next-queue');
    const progressLabel  = document.getElementById('progress-label');
    const progressFill   = document.getElementById('progress-fill');
    const progressPct    = document.getElementById('progress-pct');
    const tallySection   = document.getElementById('tally-section');
    const statusDots     = document.getElementById('status-dots');
    const clock          = document.getElementById('clock');
    const etaInfo        = document.getElementById('eta-info');
    const simStatus      = document.getElementById('sim-status');
    const flowSteps      = document.querySelectorAll('.flow-step');
    const simBadge       = document.getElementById('sim-badge');
    const sheetStatus    = document.getElementById('sheet-status');
    const sheetGuide     = document.getElementById('sheet-guide');

    // ── Source selector ───────────────────────────────────────────────────────
    function switchSource(src) {
      if (currentSource === src) return;
      pause();
      currentSource = src;
      state.dataSource = src;
      state.currentIndex = -1;
      state.statuses = {};

      document.querySelectorAll('.source-btn').forEach(btn => {
        const active = btn.dataset.source === src;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });

      sheetGuide.classList.remove('visible');
      stopSheetPoll();

      if (src === 'sim') {
        data = SIM_DATA;
        experts = SIM_EXPERTS;
        simBadge.textContent = 'SIM';
        simBadge.classList.remove('sheet-live');
        sheetStatus.textContent = '';
        sheetStatus.classList.remove('live');
      } else if (src === 'sample') {
        data = SAMPLE_DATA;
        experts = [];
        simBadge.textContent = 'SAMPLE';
        simBadge.classList.remove('sheet-live');
        sheetStatus.textContent = '';
        sheetStatus.classList.remove('live');
      } else if (src === 'sample-15') {
        data = SAMPLE_15_DATA;
        experts = SAMPLE_15_EXPERTS;
        simBadge.textContent = 'SIM-15';
        simBadge.classList.remove('sheet-live');
        sheetStatus.textContent = '';
        sheetStatus.classList.remove('live');
      } else if (src === 'sheet') {
        simBadge.textContent = 'LIVE';
        simBadge.classList.add('sheet-live');
        if (!SHEET_CSV_URL) {
          sheetGuide.classList.add('visible');
          sheetStatus.textContent = '⚠ URL 미설정';
          sheetStatus.classList.remove('live');
          data = [];
          experts = [];
        } else {
          sheetStatus.textContent = '연결 중…';
          sheetStatus.classList.remove('live');
          fetchSheet().then(() => startSheetPoll());
        }
      }

      saveState();
      render();
    }

    async function fetchSheet() {
      if (!SHEET_CSV_URL) return;
      try {
        const text = await fetch(SHEET_CSV_URL).then(r => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.text();
        });
        const rows = csvToRows(text);
        if (rows.length > 0) {
          data = rows;
          experts = [...new Set(rows.map(r => r.expert).filter(e => e && e !== '공통'))];
          const now = new Date();
          sheetStatus.textContent = `마지막 갱신: ${now.toLocaleTimeString('ko-KR', {hour12: false})}`;
          sheetStatus.classList.add('live');
          render();
        }
      } catch (err) {
        sheetStatus.textContent = `오류: ${err.message}`;
        sheetStatus.classList.remove('live');
      }
    }

    function startSheetPoll() {
      stopSheetPoll();
      sheetPollTimer = setInterval(() => fetchSheet(), POLL_INTERVAL_MS);
    }

    function stopSheetPoll() {
      if (sheetPollTimer) { clearInterval(sheetPollTimer); sheetPollTimer = null; }
    }

    document.querySelectorAll('.source-btn').forEach(btn => {
      btn.addEventListener('click', () => switchSource(btn.dataset.source));
    });

    // ── Effective status bridge ───────────────────────────────────────────────
    // Merges sim internal state (current/done) with sheet 한국어 status column.
    // Sim mode never mutates q.status — so we derive display state from
    // state.statuses[q.id] first, falling back to the raw sheet value.
    function effectiveStatus(q) {
      const simSt = state.statuses[q.id];
      if (simSt === 'current') return '선정';
      if (simSt === 'done') return '발표완료';
      // Sheet mode: use raw status if present, else default
      if (q.status && q.status !== '') return q.status;
      return '대기';
    }

    // Track previous index for next-up flash
    let prevRenderIndex = -1;

    // ── Render ─────────────────────────────────────────────────────────────────
    function render() {
      const filtered = getFiltered();
      const idx = state.currentIndex;
      const total = filtered.length;

      posCounter.textContent = `행 ${Math.max(idx + 1, 0)} / ${total}`;
      btnPrev.disabled = idx <= 0;
      btnNext.disabled = idx >= total - 1;
      btnPlay.textContent = state.playing ? '⏸' : '▶';
      btnPlay.classList.toggle('active', state.playing);

      document.querySelectorAll('.speed-btn').forEach(btn => {
        btn.classList.toggle('active', Number(btn.dataset.speed) === state.speed);
      });

      if (idx < 0 || total === 0) {
        emptyState.style.display = '';
        currentContent.style.display = 'none';
        nextTitle.style.display = 'none';
        currentCard.classList.remove('playing');
        currentCard.removeAttribute('data-status');
      } else {
        const q = filtered[idx];
        emptyState.style.display = 'none';
        currentContent.style.display = '';
        currentCard.classList.toggle('playing', state.playing);
        nextTitle.style.display = '';
        currentCard.setAttribute('data-status', effectiveStatus(q));

        cardMeta.innerHTML = `
          <span class="card-label">지금 발언</span>
          <span class="meta-pill">${q.region || '—'} ${q.group ? q.group + '조' : ''}</span>
          ${q.expert ? `<span class="meta-pill expert">답변: ${q.expert}</span>` : ''}
          ${q.scheduled_time ? `<span class="meta-pill time">⏰ ${formatTime(q.scheduled_time)}</span>` : ''}
          <span class="meta-pill">${q.channel || ''}</span>
        `;
        contentText.textContent = q.content;
        speakerLine.textContent = `Day ${q.day} · ${q.channel || ''}`;
      }

      // Next-up flash: fire when index advances forward
      const didAdvance = idx > prevRenderIndex && prevRenderIndex >= 0;
      prevRenderIndex = idx;

      nextQueue.innerHTML = '';
      const upcoming = filtered.slice(Math.max(idx + 1, 0), Math.max(idx + 1, 0) + 3);
      nextCount.textContent = String(Math.max(0, total - idx - 1));

      upcoming.forEach((q, queuePos) => {
        const div = document.createElement('div');
        div.className = 'next-item';
        div.setAttribute('data-status', effectiveStatus(q));
        div.innerHTML = `
          <div class="next-item-meta">
            <span class="meta-pill">${q.region || '—'}</span>
            ${q.expert ? `<span class="meta-pill expert">${q.expert}</span>` : ''}
          </div>
          <div class="next-item-content">${q.content}</div>
        `;
        // Stagger the next-up flash by queue position
        if (didAdvance) {
          setTimeout(() => {
            div.classList.add('next-up-flash');
            // Remove class after animation completes so it can re-trigger
            div.addEventListener('animationend', () => div.classList.remove('next-up-flash'), { once: true });
          }, queuePos * 120);
        }
        nextQueue.appendChild(div);
      });

      const done = filtered.filter(q => state.statuses[q.id] === 'done').length;
      const pct = total ? Math.round((done / total) * 100) : 0;
      progressLabel.textContent = `진행 ${done} / ${total} · ${pct}%`;
      progressFill.style.width = `${pct}%`;
      progressPct.textContent = `${pct}%`;

      const expertCounts = {};
      filtered.forEach(q => {
        if (state.statuses[q.id] === 'done' && q.expert) {
          expertCounts[q.expert] = (expertCounts[q.expert] || 0) + 1;
        }
      });
      const maxCount = Math.max(...Object.values(expertCounts), 1);
      tallySection.innerHTML = '';
      const tallyExperts = [...experts, '공통'].filter(e => e);
      tallyExperts.forEach(name => {
        const count = expertCounts[name] || 0;
        if (count === 0 && !experts.includes(name)) return;
        const row = document.createElement('div');
        row.className = 'tally-row';
        const isCommon = name === '공통';
        row.innerHTML = `
          <span class="tally-name" title="${name}">${name}</span>
          <div class="tally-bar-track">
            <div class="tally-bar-fill ${isCommon ? 'common' : ''}" style="width:${count ? Math.round((count/maxCount)*100) : 0}%"></div>
          </div>
          <span class="tally-count">${count}</span>
        `;
        tallySection.appendChild(row);
      });

      statusDots.innerHTML = '';
      filtered.forEach(q => {
        const dot = document.createElement('div');
        dot.className = 'status-dot';
        const st = state.statuses[q.id];
        if (st === 'done') dot.classList.add('done');
        if (st === 'current') dot.classList.add('current');
        dot.setAttribute('data-status', effectiveStatus(q));
        statusDots.appendChild(dot);
      });

      const stageIndex = total > 0 ? Math.floor(((idx + 1) / total) * 6) % 8 : 4;
      flowSteps.forEach((step, i) => {
        step.classList.toggle('active', i === stageIndex);
      });

      const speedMs = SPEEDS[state.speed];
      const remaining = total - done;
      etaInfo.innerHTML = `
        전체: ${formatDuration(total * speedMs)}<br>
        현재: ${idx + 1} / ${total}<br>
        잔여: ${formatDuration(remaining * speedMs)}
      `;

      simStatus.textContent = state.playing ? '▶ 진행 중' : (idx >= 0 ? '⏸ 일시정지' : '대기 중');
    }

    function formatTime(t) {
      if (!t || t === 'None') return '';
      return t.split('.')[0].slice(0, 5);
    }

    function formatDuration(ms) {
      const s = Math.floor(ms / 1000);
      const m = Math.floor(s / 60);
      const h = Math.floor(m / 60);
      if (h > 0) return `${h}h ${m % 60}m`;
      return `${m}분 ${s % 60}초`;
    }

    // ── Sim engine ────────────────────────────────────────────────────────────
    let timer = null;

    function advance() {
      const filtered = getFiltered();
      const total = filtered.length;
      if (state.currentIndex >= total - 1) { pause(); return; }
      if (state.currentIndex >= 0) {
        state.statuses[filtered[state.currentIndex].id] = 'done';
      }
      state.currentIndex++;
      state.statuses[filtered[state.currentIndex].id] = 'current';
      saveState();
      render();
    }

    function play() {
      if (state.playing) return;
      state.playing = true;
      const filtered = getFiltered();
      if (state.currentIndex < 0 && filtered.length > 0) advance();
      timer = setInterval(() => advance(), SPEEDS[state.speed]);
      saveState();
      render();
    }

    function pause() {
      state.playing = false;
      if (timer) { clearInterval(timer); timer = null; }
      saveState();
      render();
    }

    function resetTimer() {
      if (timer) { clearInterval(timer); timer = null; }
      if (state.playing) timer = setInterval(() => advance(), SPEEDS[state.speed]);
    }

    // ── Controls ──────────────────────────────────────────────────────────────
    btnPlay.addEventListener('click', () => { state.playing ? pause() : play(); });

    btnNext.addEventListener('click', () => { advance(); resetTimer(); });

    btnPrev.addEventListener('click', () => {
      const filtered = getFiltered();
      if (state.currentIndex <= 0) return;
      state.statuses[filtered[state.currentIndex].id] = 'pending';
      state.currentIndex--;
      if (state.currentIndex >= 0) state.statuses[filtered[state.currentIndex].id] = 'current';
      resetTimer();
      saveState();
      render();
    });

    document.querySelectorAll('.speed-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.speed = Number(btn.dataset.speed);
        resetTimer();
        saveState();
        render();
      });
    });

    selDay.addEventListener('change', () => {
      pause();
      state.filterDay = selDay.value;
      state.currentIndex = -1;
      saveState();
      render();
    });

    selChannel.addEventListener('change', () => {
      pause();
      state.filterChannel = selChannel.value;
      state.currentIndex = -1;
      saveState();
      render();
    });

    // ── Clock ─────────────────────────────────────────────────────────────────
    function updateClock() {
      clock.textContent = new Date().toLocaleTimeString('ko-KR', { hour12: false });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // ── Keyboard shortcuts ────────────────────────────────────────────────────
    document.addEventListener('keydown', e => {
      if (e.target.tagName === 'SELECT' || e.target.tagName === 'INPUT') return;
      if (e.key === ' ' || e.key === 'k') { e.preventDefault(); state.playing ? pause() : play(); }
      if (e.key === 'ArrowRight' || e.key === 'l') { e.preventDefault(); advance(); resetTimer(); }
      if (e.key === 'ArrowLeft' || e.key === 'h') { btnPrev.click(); }
    });

    // ── Init ──────────────────────────────────────────────────────────────────
    loadState();

    // Restore source from sessionStorage
    const restoredSource = state.dataSource || 'sample-15';
    currentSource = 'sample-15'; // force re-initialise even if same
    switchSource(restoredSource);

    selDay.value = state.filterDay;
    selChannel.value = state.filterChannel;
    state.playing = false;
    render();
  </script>
</body>
</html>
