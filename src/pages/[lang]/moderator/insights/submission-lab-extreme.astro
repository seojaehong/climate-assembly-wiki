---
/**
 * /ko/moderator/insights/submission-lab-extreme — 발표 모드 극단값 미리보기 (모더레이터 전용)
 *
 * 왜 있는가
 *   실제 본부 보드(/hq)는 본부 비밀번호 게이트 뒤라 브라우저 자동 검증이 불가능하다.
 *   그래서 같은 컴포넌트(HqSubmissionBoard)를 고정 픽스처로 띄우는 라우트를 따로 둔다.
 *   L1~L4 화면 작업은 여기서 눈으로 확인한 뒤 /hq로 나간다.
 *
 * PRIVACY
 *   - ko 단일 라우트(getStaticPaths가 'ko'만 낸다)
 *   - robots noindex,nofollow · 사이트맵 화이트리스트(/agenda + locale home) 밖 · pagefind 대상 아님
 *
 * DATA
 *   - automation/fixtures/0829-submissions-extreme.json (극단값만 모은 입력)
 *   - 행 모양은 src/lib/hq-submissions.ts 의 HqSubmissionRow 와 같다
 *   - Supabase를 부르지 않는다 — fixtureRows를 주면 컴포넌트가 fetch·구독·폴링을 모두 건너뛴다
 */
import type { HqSubmissionRow } from '../../../../lib/hq-submissions';
import HqSubmissionBoard from '../../../../islands/mod/HqSubmissionBoard';
import fixtureRaw from '../../../../../automation/fixtures/0829-submissions-extreme.json';
import '../../../../styles/global.css';

export function getStaticPaths() {
  return [{ params: { lang: 'ko' } }];
}

const fixtureRows = fixtureRaw as HqSubmissionRow[];
const teamCount = new Set(fixtureRows.map((row) => row.team_name)).size;
const topicCount = new Set(fixtureRows.map((row) => row.topic_id)).size;
---
<!doctype html>
<html lang="ko" class="light" data-theme="light"><head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="color-scheme" content="light" />
  <title>발표 모드 극단값 미리보기 [모더레이터 인사이트]</title>
  <style is:global>
    body { font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif; }
    .tr-num { letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  </style>
</head><body>
  <div style="background:#6e2020;color:#ffdcd7;text-align:center;padding:6px 16px;font-size:12px;font-weight:600;letter-spacing:.04em;border-bottom:2px solid #b22a2a;">
    극단값 미리보기 — 픽스처 {teamCount}개 조 · 꼭지 {topicCount}개. 실제 조별 산출물이 아닙니다 · 외부 공개 금지
  </div>
  <HqSubmissionBoard fixtureRows={fixtureRows} client:only="react" />
</body></html>
