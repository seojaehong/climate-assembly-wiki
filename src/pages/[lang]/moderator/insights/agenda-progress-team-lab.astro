---
/** Offline record-moderator fixture. No Supabase request is made. */
import { AGENDA_CATALOG_0912 } from '../../../../data/0912-agenda-catalog';
import type { AgendaBoardPayload, AgendaTeam } from '../../../../lib/agenda-progress';
import AgendaProgressBoard from '../../../../islands/mod/AgendaProgressBoard';
import globalCss from '../../../../styles/global.css?inline';

export function getStaticPaths() {
  return [{ params: { lang: 'ko' } }];
}

const team: AgendaTeam = {
  id: '00000000-0000-4000-8100-000000000001',
  name: '1분과 1조',
  subgroup: '1분과',
  tableNo: '1-1',
};

const fixture: AgendaBoardPayload = {
  version: 3,
  sessionSlug: '0912-deliberation',
  scope: 'team',
  teamId: team.id,
  teamSubgroup: team.subgroup,
  activeStage: {
    id: '00000000-0000-4000-8000-000000000003',
    ordinal: 3,
    prompt: '의제별 조별 숙의 및 공유문안 작성',
    status: 'open',
  },
  stageIntegrity: { openStageCount: 1, writable: true },
  stages: Array.from({ length: 8 }, (_, index) => ({
    id: `00000000-0000-4000-8000-00000000000${index + 1}`,
    ordinal: index + 1,
    prompt: `${index + 1}단계 작업`,
    status: index === 2 ? 'open' as const : 'closed' as const,
  })),
  teams: [team],
  agendas: AGENDA_CATALOG_0912.slice(0, 2).map((agenda, index) => ({
    ...agenda,
    archived: false,
    createdAt: '2026-09-12T05:00:00.000Z',
    sourceUtterances: [...agenda.sourceUtterances],
    assignments: [{
      teamId: team.id,
      teamName: team.name,
      assignedAt: '2026-09-12T05:10:00.000Z',
    }],
    recommendations: index === 0 ? [{
      id: `20000000-0000-4000-8000-00000000000${index + 1}`,
      authorTeamId: team.id,
      authorTeamName: team.name,
      sortOrder: 1,
      title: '생활권 대중교통 연결 강화',
      problemRecognition: '대중교통이 부족한 지역은 이동 선택지가 제한됩니다.',
      recommendationContent: '수요응답형 교통과 주요 환승 거점을 연결하고 운영 정보를 공개합니다.',
      expectedEffect: '지역에 관계없이 기본 이동권을 누릴 수 있습니다.',
      status: 'drafting' as const,
      feedback: '실행 주체를 조금 더 분명히 적어 주세요.',
      updatedAt: '2026-09-12T05:30:00.000Z',
      archived: false,
      revisionVersion: 2,
      revisionCount: 2,
      progressCount: 3,
    }, {
      id: `30000000-0000-4000-8000-00000000000${index + 1}`,
      authorTeamId: team.id,
      authorTeamName: team.name,
      sortOrder: 2,
      title: '교통 취약계층 지원',
      problemRecognition: '고령자와 장애인의 이동비용 부담이 큽니다.',
      recommendationContent: '교통비와 동행 이동 지원을 생활권 단위로 제공합니다.',
      expectedEffect: null,
      status: 'waiting' as const,
      feedback: null,
      updatedAt: '2026-09-12T05:35:00.000Z',
      archived: false,
      revisionVersion: 1,
      revisionCount: 1,
      progressCount: 0,
    }] : [],
  })),
};
---
<!doctype html>
<html lang="ko" class="light" data-theme="light"><head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>기록모더레이터 진행상황판 검증 화면</title>
  <style is:global set:html={globalCss}></style>
  <style is:global>
    body { font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif; }
  </style>
</head><body>
  <div style="background:#6e2020;color:#fff;text-align:center;padding:8px;font-weight:700;">
    검증용 fixture · 운영 DB 요청 없음 · 기록모더레이터 배정 의제와 복수 권고안 작성
  </div>
  <AgendaProgressBoard
    mode="team"
    teamId={team.id}
    subgroup={team.subgroup}
    fixturePayload={fixture}
    client:only="react"
  />
</body></html>
