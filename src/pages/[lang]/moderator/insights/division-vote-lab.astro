---
/**
 * /ko/moderator/insights/division-vote-lab — 10/17 분과 의결 탭(DivisionVotePanel) 미리보기
 *
 * 왜 있는가
 *   /mod 는 조 접속코드 뒤라 자동 검증·시연 화면 확인이 막힌다. 같은 컴포넌트를
 *   가상 데이터로 띄운다. access 를 주지 않으므로 Supabase 를 부르지 않는다. 투표는 메모리 안
 *   가짜 서버(division-vote-lab-fake.ts)로 시작·마감·결과까지 돈다. ?ops=1 = 운영팀 현황판 시연.
 *
 * PRIVACY
 *   - ko 단일 라우트 · robots noindex,nofollow
 *   - 데이터는 division-vote-fixture.ts 의 가상 문장뿐이다. 실제 권고안은 「JSON 가져오기」로만 싣는다
 *   - 저장 키는 /mod 와 따로 쓴다(`lab:` 접두사)
 */
import DivisionVoteLab from '../../../../islands/mod/DivisionVoteLab';
import '../../../../styles/global.css';

export function getStaticPaths() {
  return [{ params: { lang: 'ko' } }];
}
---
<!doctype html>
<html lang="ko" class="light" data-theme="light"><head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="color-scheme" content="light" />
  <title>10/17 의결 미리보기 [모더레이터 인사이트]</title>
  <style is:global>
    body { font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif; background: #F5F8FB; }
    .tr-num { letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  </style>
</head><body>
  <div style="background:#6e2020;color:#ffdcd7;text-align:center;padding:6px 16px;font-size:12px;font-weight:600;letter-spacing:.04em;border-bottom:2px solid #b22a2a;">
    미리보기 — 가상 데이터. 서버로 나가는 요청이 없습니다 · 외부 공개 금지
  </div>
  <div style="max-width:1024px;margin:0 auto;padding:16px;">
    <DivisionVoteLab client:only="react" />
  </div>
</body></html>
