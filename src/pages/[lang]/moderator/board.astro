---
// @ts-nocheck
/**
 * /ko/moderator/board/ — 의제 보드 (감축↔적응 양단 · 프로젝터용)
 *
 * PRIVACY:
 *   - KO-only route (getStaticPaths emits only 'ko')
 *   - robots noindex,nofollow
 *   - NOT in sitemap (whitelist filter excludes /moderator/*)
 *   - NOT in pagefind (no data-pagefind-body)
 *   - No nav links to this page from public pages
 *
 * DATA SOURCE (read):
 *   - PUBLIC_LIVE_SHEET_CSV_URL → Google Sheet master
 *   - Schema: 순번|일자|조|발언자|안건|상태|도메인|타임스탬프|키워드|override_양단
 *   - Client-side fetch, poll every 10s
 *
 * DATA WRITEBACK:
 *   - PUBLIC_BOARD_WRITEBACK_URL → Apps Script webhook
 *   - Payload: { row, override_양단, token, ts }
 *   - Content-Type: text/plain;charset=utf-8 (CORS constraint)
 *
 * MODES:
 *   - /ko/moderator/board         — 일반 (폴링·읽기 전용)
 *   - /ko/moderator/board?mode=control — 본부 (드래그 가능)
 *   - f 키                        — Present 모드 (UI 최소화·폰트 1.4x)
 */

import '../../../styles/global.css';
import BoardCanvas from '../../../islands/BoardCanvas';
import BoardToast from '../../../components/BoardToast.astro';
import domainMap from '../../../data/domain-yangdan-map.json';

export async function getStaticPaths() {
  return [{ params: { lang: 'ko' } }];
}

// Board 전용 시트 env 우선, 미설정 시 레거시 PUBLIC_LIVE_SHEET_CSV_URL 폴백.
// (live.astro의 LiveQA 시트와 스키마가 다르므로 운영 시 반드시 분리 설정)
// .trim(): Cloudflare env 값에 공백이 섞여 들어가는 사고 방지
const sheetCsvUrl = (
  import.meta.env.PUBLIC_BOARD_SHEET_CSV_URL
  ?? import.meta.env.PUBLIC_LIVE_SHEET_CSV_URL
  ?? ''
).trim();
const writebackUrl = (import.meta.env.PUBLIC_BOARD_WRITEBACK_URL ?? '').trim();
---
<!doctype html>
<html lang="ko" dir="ltr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>기후시민회의 의제 보드 [보드]</title>
  <meta name="robots" content="noindex,nofollow" />
  <!-- No canonical, no hreflang, no OG — private page -->
  <style>
    /* ============================================================
       MODERATOR BOARD — Miro-tone canvas, 200명 가시성 기준
       ============================================================ */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #f0ece4;
      color: #1c1917;
      font-family: 'Pretendard Variable', 'Pretendard', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ---- Privacy banner ---- */
    .privacy-banner {
      background: #7c2d12;
      color: #fed7aa;
      text-align: center;
      padding: 6px 16px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      border-bottom: 2px solid #ea580c;
      flex-shrink: 0;
    }

    /* ---- Sub-nav ---- */
    .subnav {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 6px 16px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #6b7280;
      flex-shrink: 0;
    }
    .subnav-label { font-weight: 700; margin-right: 4px; color: #374151; }
    .subnav a {
      color: #6b7280;
      text-decoration: none;
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid transparent;
      transition: color 0.1s, border-color 0.1s;
    }
    .subnav a:hover { color: #111827; border-color: #d1d5db; }
    .subnav a.current { color: #d97706; border-color: #d97706; font-weight: 600; }
    .subnav-sep { color: #d1d5db; }

    /* ---- Board wrapper ---- */
    .board-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    /* ---- Present mode overlay — hides chrome ---- */
    body.present-mode .privacy-banner,
    body.present-mode .subnav {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.6s ease;
    }

    /* ---- Control mode blocked (no writeback URL) ---- */
    .env-error-banner {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      color: #dc2626;
      padding: 20px 24px;
      margin: 20px;
      border-radius: 8px;
      font-size: 18px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <!-- Privacy banner -->
  <div class="privacy-banner">
    🔒 모더레이터 운영 페이지 · 외부 공개 금지
  </div>

  <!-- Sub-nav -->
  <nav class="subnav" aria-label="모더레이터 도구 네비게이션">
    <span class="subnav-label">[모더레이터 도구]</span>
    <a href="/ko/moderator/live">라이브</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/board" class="current">보드</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/insights/heatmap">히트맵</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/insights/clusters">클러스터</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/insights/agenda-network">의제연결</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/insights/groups">조별</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/regulation">운영규정</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/agenda">의제선정</a>
    <span class="subnav-sep">·</span>
    <a href="/ko/moderator/agenda-race">투표버블</a>
  </nav>

  <!-- Board wrapper — contains the React island -->
  <div class="board-wrapper">
    <!-- Control mode writeback URL check — fail closed -->
    <script is:inline>
      (function () {
        const params = new URLSearchParams(window.location.search);
        const isControl = params.get('mode') === 'control';
        const writebackUrl = document.getElementById('writeback-url-data')
          ? JSON.parse(document.getElementById('writeback-url-data').textContent)
          : '';
        if (isControl && !writebackUrl) {
          const banner = document.getElementById('env-error-banner');
          if (banner) banner.style.display = 'block';
        }
      })();
    </script>

    <div id="env-error-banner" class="env-error-banner" style="display:none;" role="alert">
      ⚠️ PUBLIC_BOARD_WRITEBACK_URL 환경변수가 설정되지 않았습니다.<br>
      본부 모드 드래그는 비활성 상태입니다. Cloudflare 환경변수 설정 후 재배포하세요.
    </div>

    <!-- Build-time data islands -->
    <script id="writeback-url-data" type="application/json" set:html={JSON.stringify(writebackUrl)}></script>

    <!-- BoardCanvas React island -->
    <BoardCanvas
      client:load
      sheetCsvUrl={sheetCsvUrl}
      writebackUrl={writebackUrl}
      domainMap={domainMap}
      isControlMode={false}
    />
  </div>

  <!-- Toast -->
  <BoardToast />

  <!-- Runtime: read ?mode=control from URL and re-hydrate if needed -->
  <script is:inline>
    // Note: Astro client:load islands receive props at build time.
    // For mode=control, we signal the island via a custom event after load.
    (function () {
      const params = new URLSearchParams(window.location.search);
      const isControl = params.get('mode') === 'control';

      if (isControl) {
        // Dispatch after island hydrates (100ms buffer)
        window.addEventListener('load', function () {
          setTimeout(function () {
            window.dispatchEvent(new CustomEvent('board:set-control-mode', { detail: { isControl: true } }));
          }, 100);
        });
      }
    })();
  </script>
</body>
</html>
