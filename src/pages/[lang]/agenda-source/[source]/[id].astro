---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../../layouts/Base.astro';
import TranslationFallbackBanner from '../../../../components/TranslationFallbackBanner.astro';
import { SITE_LOCALE_CODES, STRUCTURAL_LOCALE_CODES, isSiteLocale } from '../../../../lib/site-locales';

interface PageRef {
  doc: string;
  json: string;
  page: number;
  ocr_status: string;
  text_chars: number;
  excerpt: string;
}

interface AgendaSourceRecord {
  id: string;
  slug: string;
  title: string;
  source: string;
  source_label: string;
  source_kind?: string;
  source_table?: string;
  doc?: string;
  ref_id?: string;
  category?: string;
  working_group?: string;
  stage?: string;
  status?: string;
  status_label?: string;
  review_status?: string;
  publication_status?: string;
  summary: string;
  original_excerpt?: string;
  page_refs?: PageRef[];
  ocr_found?: boolean;
}

export async function getStaticPaths() {
  const sources = [
    { routeSource: 'gyeonggi', file: 'gyeonggi-agenda-surface.json' },
    { routeSource: 'supabase', file: 'supabase-agenda-surface.json' },
    { routeSource: 'kb', file: 'kb-agenda-surface.json' },
  ];
  const allRecords = sources.flatMap(({ routeSource, file }) => {
    const dataPath = path.join(process.cwd(), 'public', 'workshop-graph', 'data', file);
    if (!fs.existsSync(dataPath)) return [];
    const data = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
    const records: AgendaSourceRecord[] = Array.isArray(data.records) ? data.records : [];
    return records.map((record) => ({ routeSource, record }));
  });
  return SITE_LOCALE_CODES.flatMap((lang) =>
    allRecords.map(({ routeSource, record }) => ({
      params: { lang, source: routeSource, id: record.slug },
      props: { record, lang },
    }))
  );
}

interface Props {
  record: AgendaSourceRecord;
  lang: string;
}

const { record, lang } = Astro.props;
const isKo = lang === 'ko';
const isStructuralLocale = isSiteLocale(lang) && STRUCTURAL_LOCALE_CODES.includes(lang);
const pageRefs = Array.isArray(record.page_refs) ? record.page_refs : [];
const isGyeonggi = record.source === 'gyeonggi-citizens-ocr';
const isKb = record.source === 'kb-agenda-corpus';
const sourceDescription = isGyeonggi
  ? '이 페이지는 내부 가안 위키가 아니라 경기도 기후도민총회 OCR/텍스트 원천에서 만든 source-backed 의제 자료입니다. OCR 발췌는 원문 확인을 돕기 위한 것이며, 최종 인용 전에는 문서 페이지를 재확인해야 합니다.'
  : isKb
    ? '이 페이지는 내부 가안 위키가 아니라 보호된 Supabase KB에서 service role export로 만든 source-backed 의제 자료입니다. 원천 기반 자료이지만 공개 문구와 분류는 추가 검수 대상입니다.'
    : '이 페이지는 내부 가안 위키가 아니라 Supabase 공개 의제 코퍼스에서 만든 source-backed 의제 자료입니다. 현재 공개 읽기 경로의 검수 데이터만 표시하며, 해외의제 전체 DB와 동일하다고 단정하지 않습니다.';
const sourceDescriptionEn = isGyeonggi
  ? 'This page is generated from source-backed Gyeonggi climate assembly OCR/text materials, not from the internal draft agenda wiki.'
  : isKb
    ? 'This page is generated from a protected Supabase KB service-role export, not from the internal draft agenda wiki. Public wording and categorisation still require review.'
    : 'This page is generated from the Supabase public agenda corpus, not from the internal draft agenda wiki. It does not prove that the full overseas agenda database is connected.';
const statusTone: Record<string, string> = {
  final_selected: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200',
  third_adopted: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200',
  third_rejected: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
  public_corpus: 'bg-sky-100 text-sky-800 dark:bg-sky-900/40 dark:text-sky-200',
  source_backed_unreviewed: 'bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-200',
};
const sourceMatchText = isGyeonggi
  ? (record.ocr_found ? (isKo ? 'OCR/텍스트 페이지 발견' : 'OCR/text pages found') : (isKo ? '검토 필요' : 'Needs review'))
  : isKb
    ? (isKo ? '보호 KB export · 검수 필요' : 'Protected KB export · needs review')
    : (isKo ? 'Supabase 공개 행' : 'Supabase public row');
const sourceIdText = isGyeonggi
  ? `${pageRefs.length}${isKo ? '건' : ''}`
  : [record.doc, record.ref_id || record.id].filter(Boolean).join(' · ');
const title = isKo ? record.title : `${record.title} | Source-backed agenda`;
---

<Base title={title} lang={lang}>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    {isStructuralLocale && <TranslationFallbackBanner targetLang={lang} currentPath={Astro.url.pathname} />}
    {/* 2026-08-29: 「숙의 온톨로지로 돌아가기」 숨김 — 상단 탭과 같은 이유.
        원천 자료를 보러 온 사람을 6월 워크숍 그래프로 되돌릴 이유가 오늘은 없다. */}

    <header class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 font-mono text-[var(--color-fg-muted)]">{record.id}</span>
        <span class={`rounded-full px-2 py-1 font-semibold ${statusTone[record.status || ''] ?? 'border border-[var(--color-border)] text-[var(--color-fg-muted)]'}`}>
          {record.status_label || record.status || 'source-backed'}
        </span>
        {record.review_status ? (
          <span class="rounded-full border border-[var(--color-border)] px-2 py-1 text-[var(--color-fg-muted)]">
            {isKo ? '검수상태' : 'Review'} · {record.review_status}
          </span>
        ) : null}
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 text-[var(--color-fg-muted)]">{record.working_group || record.category || record.source_kind || '분류 미상'}</span>
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 text-[var(--color-fg-muted)]">{record.source_label}</span>
      </div>
      <h1 class="text-2xl font-bold leading-snug text-[var(--color-fg)]">{record.title}</h1>
      <p class="mt-3 text-sm leading-6 text-[var(--color-fg-muted)]">
        {isKo
          ? sourceDescription
          : sourceDescriptionEn}
      </p>
    </header>

    <section class="mb-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isKo ? '단계' : 'Stage'}</h2>
        <p class="text-sm font-semibold text-[var(--color-fg)]">{record.stage || record.source_kind || record.source}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isKo ? '원천 매칭' : 'Source match'}</h2>
        <p class="text-sm font-semibold text-[var(--color-fg)]">{sourceMatchText}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isGyeonggi ? (isKo ? '페이지 참조' : 'Page refs') : (isKo ? '원천 ID' : 'Source ID')}</h2>
        <p class="break-words text-sm font-semibold text-[var(--color-fg)]">{sourceIdText || (isKo ? '원천 ID 없음' : 'No source ID')}</p>
      </div>
    </section>

    {isKb ? (
      <section class="mb-6 rounded-2xl border border-violet-200 bg-violet-50 p-5 text-sm leading-7 text-violet-950 dark:border-violet-800/70 dark:bg-violet-950/30 dark:text-violet-100">
        <h2 class="mb-2 text-base font-bold">{isKo ? '공개 전 검수 메모' : 'Pre-publication review note'}</h2>
        <p>
          {isKo
            ? '이 항목은 보호된 지식베이스에서 추출한 원천 기반 자료입니다. 시민회의 결론이나 공식 권고안이 아니며, 공개 문구·분류·요약은 별도 검수 후 승격해야 합니다.'
            : 'This item is source-backed material exported from a protected knowledge base. It is not an official assembly conclusion; public wording, categorisation, and summary require review before promotion.'}
        </p>
      </section>
    ) : null}

    <section class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
      <h2 class="mb-3 text-lg font-bold text-[var(--color-fg)]">{isKo ? '원문 발췌' : 'Original excerpt'}</h2>
      {record.original_excerpt ? (
        <blockquote class="whitespace-pre-wrap rounded-xl bg-[var(--color-bg-subtle)] p-4 text-sm leading-7 text-[var(--color-fg)]">
          {record.original_excerpt}
        </blockquote>
      ) : (
        <p class="text-sm text-[var(--color-fg-muted)]">{isKo ? '자동 매칭된 원문 발췌가 없습니다. OCR 원문 재검토가 필요합니다.' : 'No automatic source excerpt was found.'}</p>
      )}
    </section>

    <section class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
      <h2 class="mb-3 text-lg font-bold text-[var(--color-fg)]">{isKo ? '문서·페이지 근거' : 'Document and page evidence'}</h2>
      <div class="space-y-3">
        {pageRefs.length ? pageRefs.map((ref) => (
          <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4">
            <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-[var(--color-fg-muted)]">
              <span class="font-semibold text-[var(--color-fg)]">{ref.doc}</span>
              <span>p.{ref.page}</span>
              <span>{ref.ocr_status}</span>
              <span>{ref.text_chars} chars</span>
            </div>
            <p class="text-sm leading-6 text-[var(--color-fg-muted)]">{ref.excerpt}</p>
          </article>
        )) : (
          <p class="text-sm text-[var(--color-fg-muted)]">
            {isGyeonggi
              ? (isKo ? '페이지 참조 없음' : 'No page references')
              : (isKo ? `Supabase ${record.source_table || '공개 코퍼스'} · ref_id ${record.ref_id || record.id}` : `Supabase ${record.source_table || 'public corpus'} · ref_id ${record.ref_id || record.id}`)}
          </p>
        )}
      </div>
    </section>
  </main>
</Base>
