---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../../../layouts/Base.astro';

interface PageRef {
  doc: string;
  json: string;
  page: number;
  ocr_status: string;
  text_chars: number;
  excerpt: string;
}

interface AgendaSourceRecord {
  id: string;
  slug: string;
  title: string;
  source: string;
  source_label: string;
  working_group: string;
  stage: string;
  status: string;
  status_label: string;
  summary: string;
  original_excerpt: string;
  page_refs: PageRef[];
  ocr_found: boolean;
}

export async function getStaticPaths() {
  const langs = ['ko', 'en', 'ja', 'zh', 'es'];
  const dataPath = path.join(process.cwd(), 'public', 'workshop-graph', 'data', 'gyeonggi-agenda-surface.json');
  const data = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
  const records: AgendaSourceRecord[] = Array.isArray(data.records) ? data.records : [];
  return langs.flatMap((lang) =>
    records.map((record) => ({
      params: { lang, source: 'gyeonggi', id: record.slug },
      props: { record, lang },
    }))
  );
}

interface Props {
  record: AgendaSourceRecord;
  lang: string;
}

const { record, lang } = Astro.props;
const isKo = lang === 'ko';
const statusTone: Record<string, string> = {
  final_selected: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200',
  third_adopted: 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200',
  third_rejected: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
};
const title = isKo ? record.title : `${record.title} | Source-backed agenda`;
---

<Base title={title} lang={lang}>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-5 text-sm text-[var(--color-fg-muted)]">
      <a href={`/${lang}/workshop-graph/`} class="text-[var(--color-accent)] hover:underline">
        {isKo ? '숙의 온톨로지로 돌아가기' : 'Back to deliberation ontology'}
      </a>
    </nav>

    <header class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 font-mono text-[var(--color-fg-muted)]">{record.id}</span>
        <span class={`rounded-full px-2 py-1 font-semibold ${statusTone[record.status] ?? 'border border-[var(--color-border)] text-[var(--color-fg-muted)]'}`}>
          {record.status_label}
        </span>
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 text-[var(--color-fg-muted)]">{record.working_group}</span>
        <span class="rounded-full border border-[var(--color-border)] px-2 py-1 text-[var(--color-fg-muted)]">{record.source_label}</span>
      </div>
      <h1 class="text-2xl font-bold leading-snug text-[var(--color-fg)]">{record.title}</h1>
      <p class="mt-3 text-sm leading-6 text-[var(--color-fg-muted)]">
        {isKo
          ? '이 페이지는 내부 가안 위키가 아니라 경기도 기후도민총회 OCR/텍스트 원천에서 만든 source-backed 의제 자료입니다. OCR 발췌는 원문 확인을 돕기 위한 것이며, 최종 인용 전에는 문서 페이지를 재확인해야 합니다.'
          : 'This page is generated from source-backed Gyeonggi climate assembly OCR/text materials, not from the internal draft agenda wiki.'}
      </p>
    </header>

    <section class="mb-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isKo ? '단계' : 'Stage'}</h2>
        <p class="text-sm font-semibold text-[var(--color-fg)]">{record.stage}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isKo ? '원천 매칭' : 'Source match'}</h2>
        <p class="text-sm font-semibold text-[var(--color-fg)]">{record.ocr_found ? (isKo ? 'OCR/텍스트 페이지 발견' : 'OCR/text pages found') : (isKo ? '검토 필요' : 'Needs review')}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-4">
        <h2 class="mb-2 text-xs font-bold uppercase tracking-wide text-[var(--color-fg-muted)]">{isKo ? '페이지 참조' : 'Page refs'}</h2>
        <p class="text-sm font-semibold text-[var(--color-fg)]">{record.page_refs.length}{isKo ? '건' : ''}</p>
      </div>
    </section>

    <section class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
      <h2 class="mb-3 text-lg font-bold text-[var(--color-fg)]">{isKo ? '원문 발췌' : 'Original excerpt'}</h2>
      {record.original_excerpt ? (
        <blockquote class="whitespace-pre-wrap rounded-xl bg-[var(--color-bg-subtle)] p-4 text-sm leading-7 text-[var(--color-fg)]">
          {record.original_excerpt}
        </blockquote>
      ) : (
        <p class="text-sm text-[var(--color-fg-muted)]">{isKo ? '자동 매칭된 원문 발췌가 없습니다. OCR 원문 재검토가 필요합니다.' : 'No automatic source excerpt was found.'}</p>
      )}
    </section>

    <section class="mb-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
      <h2 class="mb-3 text-lg font-bold text-[var(--color-fg)]">{isKo ? '문서·페이지 근거' : 'Document and page evidence'}</h2>
      <div class="space-y-3">
        {record.page_refs.length ? record.page_refs.map((ref) => (
          <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-4">
            <div class="mb-2 flex flex-wrap items-center gap-2 text-xs text-[var(--color-fg-muted)]">
              <span class="font-semibold text-[var(--color-fg)]">{ref.doc}</span>
              <span>p.{ref.page}</span>
              <span>{ref.ocr_status}</span>
              <span>{ref.text_chars} chars</span>
            </div>
            <p class="text-sm leading-6 text-[var(--color-fg-muted)]">{ref.excerpt}</p>
          </article>
        )) : (
          <p class="text-sm text-[var(--color-fg-muted)]">{isKo ? '페이지 참조 없음' : 'No page references'}</p>
        )}
      </div>
    </section>
  </main>
</Base>
