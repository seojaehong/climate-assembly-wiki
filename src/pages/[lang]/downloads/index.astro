---
/**
 * D6-p — /[lang]/downloads/
 *
 * Downloads index page (Group J fills the actual file list later).
 * This page is intentionally sparse in M1; Group J adds download entries.
 *
 * File hosting strategy (Design D6):
 *   - Files ≤5MB: /assets/downloads/ (Cloudflare Pages)
 *   - Files >5MB: /_r2/{path} (Cloudflare R2 redirect via public/_redirects)
 *
 * License-aware: OECD files note CC BY-NC-SA 3.0 IGO restriction.
 * Official documents (이진우, 김상규): link-only, no direct download (Decision ④).
 */
import Base from '../../../layouts/Base.astro';

// ---------------------------------------------------------------------------
// getStaticPaths
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
    // M4: add ja, zh, es
  ];
}

const { lang } = Astro.params;

// ---------------------------------------------------------------------------
// Download catalog (Group J will populate this array fully)
// Each entry: label(ko), label(en), href, size, host, license, note?
// ---------------------------------------------------------------------------
interface DownloadEntry {
  labelKo: string;
  labelEn: string;
  href: string;
  size: string;
  host: 'pages' | 'r2' | 'external';
  license: string;
  noteKo?: string;
  noteEn?: string;
}

const downloads: DownloadEntry[] = [
  {
    labelKo: 'En-ROADS 자료집 v1.1',
    labelEn: 'En-ROADS Handbook v1.1',
    href: '/assets/downloads/en-roads-handbook-v1.1.md',
    size: '40KB',
    host: 'pages',
    license: 'CC BY 4.0',
  },
  {
    labelKo: '교안 오탈자 정리 v4',
    labelEn: 'Textbook Errata v4',
    href: '/assets/downloads/textbook-errata-v4.docx',
    size: '~200KB',
    host: 'pages',
    license: 'CC BY-SA 4.0',
  },
  {
    labelKo: '모더레이터 준비 브리프 v2',
    labelEn: 'Moderator Preparation Brief v2',
    href: '/assets/downloads/moderator-brief-v2.docx',
    size: '~300KB',
    host: 'pages',
    license: 'CC BY-SA 4.0',
  },
  {
    labelKo: '모더레이터 원자료 (4개 파일, 23.2MB)',
    labelEn: 'Moderator Source Materials (4 files, 23.2MB)',
    href: '/_r2/moderator-sources/',
    size: '23.2MB',
    host: 'r2',
    license: 'CC BY-SA 4.0',
    noteKo: 'Cloudflare R2 호스팅 — 대용량 파일',
    noteEn: 'Hosted on Cloudflare R2 — large file bundle',
  },
  {
    labelKo: 'OECD 평가 보고서 (6.9MB)',
    labelEn: 'OECD Evaluation Report (6.9MB)',
    href: '/_r2/oecd-evaluation/',
    size: '6.9MB',
    host: 'r2',
    license: 'CC BY-NC-SA 3.0 IGO',
    noteKo: '비상업적 이용만 허용 (OECD/CC BY-NC-SA 3.0 IGO)',
    noteEn: 'Non-commercial use only (OECD/CC BY-NC-SA 3.0 IGO)',
  },
];

// External-link-only section removed — lecture sources now consolidated into
// in-wiki pages (/ko/doc/lecture-1-park-chan/ etc.) per sub44/sub45 decision.

const pageTitle = lang === 'ko' ? '다운로드 센터' : 'Downloads';
---
<Base title={pageTitle} lang={lang}>
  <article id="main-content">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{pageTitle}</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">
      {lang === 'ko'
        ? '2026 기후시민회의 관련 공식 자료 다운로드 모음입니다.'
        : 'Official documents and materials from the 2026 Korea Climate Citizens\' Assembly.'}
    </p>

    {downloads.length > 0 ? (
      <section aria-label={lang === 'ko' ? '다운로드 파일' : 'Downloadable files'} class="mb-10">
        <ul class="space-y-3">
          {downloads.map((item) => (
            <li class="flex flex-col sm:flex-row sm:items-start gap-2 p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-green-300 dark:hover:border-green-700 transition-colors">
              <div class="flex-1">
                <a
                  href={item.href}
                  class="font-medium text-green-700 dark:text-green-400 hover:underline"
                  {...item.host === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                >
                  {lang === 'ko' ? item.labelKo : item.labelEn}
                </a>
                {(lang === 'ko' ? item.noteKo : item.noteEn) && (
                  <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                    {lang === 'ko' ? item.noteKo : item.noteEn}
                  </p>
                )}
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-400 shrink-0">
                <span>{item.size}</span>
                <span aria-hidden="true">·</span>
                <span>{item.license}</span>
                {item.host === 'r2' && (
                  <span class="px-1.5 py-0.5 bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 rounded border border-blue-200 dark:border-blue-800">
                    R2
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <div class="border border-dashed border-gray-300 dark:border-gray-700 rounded-lg p-8 text-center text-gray-400 mb-10">
        {lang === 'ko' ? '준비 중 — 자료가 곧 등록됩니다.' : 'Coming soon — files will be added shortly.'}
      </div>
    )}

    {/* OECD license notice */}
    <p class="mt-6 text-xs text-gray-400 border-t border-gray-100 dark:border-gray-800 pt-4">
      {lang === 'ko'
        ? 'OECD 자료: CC BY-NC-SA 3.0 IGO 라이선스 — 비상업적 이용만 허용. 기타 자료: CC BY-SA 4.0.'
        : 'OECD materials: CC BY-NC-SA 3.0 IGO license — non-commercial use only. Other materials: CC BY-SA 4.0.'}
    </p>
  </article>
</Base>
