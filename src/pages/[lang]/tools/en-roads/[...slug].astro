---
/**
 * D2-p — /[lang]/tools/en-roads/[...slug]/
 *
 * Static file routes for wiki/tools/en-roads/{lang}/ tree (Design D4).
 * This directory is NOT an Astro content collection; files are read with
 * import.meta.glob (Astro-native, replaces deprecated Astro.glob()).
 *
 * Route examples:
 *   /ko/tools/en-roads/           → tools/en-roads/ko/index.md
 *   /ko/tools/en-roads/18-levers  → tools/en-roads/ko/18-levers.md
 *   /ko/tools/en-roads/scenarios  → tools/en-roads/ko/scenarios/index.md
 *
 * Fallback: if /en/ slug doesn't exist, fallbackType:'rewrite' in astro.config.mjs
 * serves ko content at /en/ URL (Astro built-in). For originals/ sub-tree
 * (en-only academic source files), only emit en paths.
 *
 * NOTE: Blocker 4 fix — do NOT also create content/ko/doc/en-roads-guide.md.
 * The canonical wiki URL for the comprehensive guide is /ko/tools/en-roads/
 * (served from tools/en-roads/ko/index.md).
 */
import { marked } from 'marked';
import { readdirSync, readFileSync } from 'node:fs';
import { join, relative, sep } from 'node:path';
import Base from '../../../../layouts/Base.astro';

// ---------------------------------------------------------------------------
// getStaticPaths
// Loaders/helpers are defined INSIDE getStaticPaths because Astro hoists
// getStaticPaths into its own module scope; top-level frontmatter consts
// referenced by it are dropped during compile. Inlining keeps everything in
// one closure that Astro preserves.
//
// We use Node fs (not import.meta.glob) because Vite's glob silently matches
// nothing when the project path contains non-ASCII segments (Korean) due to
// percent-encoding. process.cwd() returns a decoded OS path during `astro build`.
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  function loadLang(lang: 'ko' | 'en'): Record<string, string> {
    const root = join(process.cwd(), 'tools', 'en-roads', lang);
    const out: Record<string, string> = {};
    const walk = (dir: string) => {
      for (const entry of readdirSync(dir, { withFileTypes: true })) {
        const full = join(dir, entry.name);
        if (entry.isDirectory()) walk(full);
        else if (entry.isFile() && entry.name.endsWith('.md')) {
          const rel = relative(root, full).split(sep).join('/');
          out[`../../../../../tools/en-roads/${lang}/${rel}`] = readFileSync(full, 'utf8');
        }
      }
    };
    walk(root);
    return out;
  }

  // Convert key '../../../../../tools/en-roads/ko/scenarios/index.md' → 'scenarios'
  function fileKeyToSlug(key: string, lang: string): string | undefined {
    const prefix = `../../../../../tools/en-roads/${lang}/`;
    const rel = key.replace(prefix, '').replace(/\.md$/, '');
    const clean = rel.replace(/\/index$/, '').replace(/^index$/, '');
    return clean || undefined;
  }

  const koFiles = loadLang('ko');
  const enFiles = loadLang('en');

  const paths: Array<{ params: { lang: string; slug: string | undefined }; props: { rawContent: string; lang: string; slug: string | undefined } }> = [];

  // KO paths
  for (const [key, rawContent] of Object.entries(koFiles)) {
    const slug = fileKeyToSlug(key, 'ko');
    paths.push({
      params: { lang: 'ko', slug: slug ?? undefined },
      props: { rawContent: rawContent as string, lang: 'ko', slug },
    });
  }

  // EN paths — originals/ sub-tree excluded (academic source docs)
  for (const [key, rawContent] of Object.entries(enFiles)) {
    if (key.includes('/originals/')) continue;
    const slug = fileKeyToSlug(key, 'en');
    paths.push({
      params: { lang: 'en', slug: slug ?? undefined },
      props: { rawContent: rawContent as string, lang: 'en', slug },
    });
  }

  // M4 (2026-06-01): structural ja/zh/es paths.
  // Body content is the EN source (fallback). LanguageToggle + hreflang
  // ensure these URLs exist and are discoverable for SEO. Translation lands later.
  for (const structuralLang of ['ja', 'zh', 'es'] as const) {
    for (const [key, rawContent] of Object.entries(enFiles)) {
      if (key.includes('/originals/')) continue;
      // fileKeyToSlug expects the prefix to match the lang used to build the path.
      // Since enFiles keys carry the 'en' prefix, strip with 'en' here.
      const slug = fileKeyToSlug(key, 'en');
      paths.push({
        params: { lang: structuralLang, slug: slug ?? undefined },
        props: { rawContent: rawContent as string, lang: structuralLang, slug },
      });
    }
  }

  return paths;
}

// ---------------------------------------------------------------------------
// Page props
// ---------------------------------------------------------------------------
interface Props {
  rawContent: string;
  lang: string;
  slug: string | undefined;
}

const { rawContent, lang, slug } = Astro.props;

// ---------------------------------------------------------------------------
// Parse frontmatter from raw markdown
// ---------------------------------------------------------------------------
interface EnRoadsFrontmatter {
  title?: string;
  trust_label?: string;
  source?: string;
  date?: string;
  [key: string]: unknown;
}

function parseFrontmatter(raw: string): { fm: EnRoadsFrontmatter; body: string } {
  const match = raw.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
  if (!match) return { fm: {}, body: raw };
  const fm: EnRoadsFrontmatter = {};
  for (const line of match[1].split('\n')) {
    const kv = line.match(/^(\w[\w_-]*):\s*(.+)$/);
    if (kv) fm[kv[1]] = kv[2].replace(/^["']|["']$/g, '');
  }
  return { fm, body: match[2] };
}

const { fm, body } = parseFrontmatter(rawContent);
const pageTitle = (fm.title as string | undefined) ?? 'En-ROADS';
const bodyHtml = await marked.parse(body);

// Breadcrumb slug display
const slugDisplay = slug ?? '';
---
<Base title={pageTitle} lang={lang}>
  <article id="main-content">
    <nav aria-label="Breadcrumb" class="mb-4 text-sm text-gray-500 dark:text-gray-400">
      <ol class="flex items-center gap-1">
        <li><a href={`/${lang}/`} class="hover:underline">{lang === 'ko' ? '홈' : 'Home'}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={`/${lang}/tools/en-roads/`} class="hover:underline">En-ROADS</a></li>
        {slugDisplay && (
          <>
            <li aria-hidden="true">›</li>
            <li class="text-gray-700 dark:text-gray-300" aria-current="page">{slugDisplay}</li>
          </>
        )}
      </ol>
    </nav>

    {fm.trust_label && (
      <p class="mb-4 text-xs text-amber-700 dark:text-amber-400">
        ⚠ {fm.trust_label === 'machine' ? 'Machine draft — pending review' : fm.trust_label}
      </p>
    )}

    {fm.source && (
      <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">
        {lang === 'ko' ? '출처' : 'Source'}: {fm.source as string}
      </p>
    )}

    <div class="prose dark:prose-invert max-w-none" set:html={bodyHtml} />

    {fm.date && (
      <p class="mt-6 text-xs text-gray-400">
        {lang === 'ko' ? '최종 업데이트' : 'Last updated'}: {fm.date as string}
        {' · '}
        <a
          href="https://creativecommons.org/licenses/by/4.0/"
          class="hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          CC BY 4.0
        </a>
      </p>
    )}
  </article>
</Base>
