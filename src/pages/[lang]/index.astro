---
/**
 * /[lang]/ — Home page (Phase 3 홈페이지 + 위키 이중 정체성)
 *
 * Sections:
 *   1. Hero v2          — slogan + 통계 + 카운트다운 + CTA 2개
 *   2. Why This Matters — 풀비드 다크 섹션, 빅 텍스트
 *   3. 4-Stage Flow     — 시민발의 → 기획 → 숙의 → 권고안
 *   4. Agenda Grid      — 6개 핵심 의제 카드
 *   5. Tools Showcase   — En-ROADS 강조
 *   6. Latest Activity  — log.md 최신 5건
 *   7. Trust & Methodology — 신뢰도 라벨 + 라이선스
 *   8. Get Involved     — 참여 CTA 3개
 *
 * Languages: ko, en (M1–M3).
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import HomeLayout from '../../layouts/HomeLayout.astro';
import AgendaCard from '../../components/AgendaCard.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import TranslationFallbackBanner from '../../components/TranslationFallbackBanner.astro';
import { SITE_LOCALE_CODES, STRUCTURAL_LOCALE_CODES, isSiteLocale } from '../../lib/site-locales';

// R-02: repo URL constant — replace all placeholder https://github.com links
const REPO = 'https://github.com/seojaehong/climate-assembly-wiki';

export async function getStaticPaths() {
  return SITE_LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

const agendaEntries: CollectionEntry<'agenda'>[] = await getCollection('agenda');
const sessionEntries: CollectionEntry<'session'>[] = await getCollection('session');

// R-20: Featured-first selection — if any agendas have data.featured=true, prefer those.
// Falls back to id-sorted (excluding dummy #00) when featured field is absent or empty.
// NOTE: 'featured' is not yet in the Zod schema. When added, mark key agendas
// (e.g. ⑤⑧⑩⑭⑮) with `featured: true` in their frontmatter to activate.
const _featuredAgendas = agendaEntries.filter(
  (e) => e.data.id > 0 && (e.data as Record<string, unknown>).featured === true
);
const heroAgendas =
  _featuredAgendas.length >= 6
    ? _featuredAgendas.slice(0, 6)
    : [...agendaEntries]
        .filter((entry) => entry.data.id > 0)
        .sort((a, b) => a.data.id - b.data.id)
        .slice(0, 6);

// Sort sessions by order field
const orderedSessions = [...sessionEntries]
  .filter((s) => typeof s.data.order === 'number')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Find next upcoming session for countdown
const today = new Date();
today.setHours(0, 0, 0, 0);

const nextSession = orderedSessions.find((s) => {
  if (!s.data.date) return false;
  const d = new Date(s.data.date);
  d.setHours(0, 0, 0, 0);
  return d >= today;
});

// Days until next session
let daysUntil: number | null = null;
if (nextSession?.data.date) {
  const d = new Date(nextSession.data.date);
  d.setHours(0, 0, 0, 0);
  daysUntil = Math.round((d.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
}

const isKo = lang === 'ko';
const isStructuralLocale = isSiteLocale(lang) && STRUCTURAL_LOCALE_CODES.includes(lang);

// Latest activity — official climatevoice notices plus site updates.
const latestActivity = isKo ? [
  { date: '2026-06-08', label: '공식 공지 — 기후시민회의 의제 접수', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=1&contentNo=11' },
  { date: '2026-06-08', label: '공식 의제 제안 홈페이지 열림', href: 'https://climatevoice.kr/opinion/write.do' },
  { date: '2026-05-16', label: '공식 공지 — 기후시민회의 발대식', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=2&contentNo=3' },
  { date: '2026-01-28', label: '공식 공지 — K-기후공론장 개설 토론회', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=2&contentNo=13' },
] : [
  { date: '2026-06-08', label: 'Official notice — climate agenda proposal intake', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=1&contentNo=11' },
  { date: '2026-06-08', label: 'Official agenda proposal page opened', href: 'https://climatevoice.kr/opinion/write.do' },
  { date: '2026-05-16', label: 'Official notice — Climate Citizens Assembly launch', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=2&contentNo=3' },
  { date: '2026-01-28', label: 'Official notice — K-climate public sphere forum', href: 'https://climatevoice.kr/notice/list.do?category=&pageNo=2&contentNo=13' },
];

// Organization + WebSite JSON-LD
const ldJson = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: isKo ? '기후시민회의 Wiki' : 'Korea Climate Assembly Wiki',
    url: 'https://climate-assembly-wiki.pages.dev',
    description: isKo
      ? '2026 기후시민회의 모더레이터 아카이브 및 다국어 위키'
      : "2026 Korea Climate Citizens' Assembly — Moderator Archive & Multilingual Wiki",
    inLanguage: lang,
    potentialAction: {
      '@type': 'SearchAction',
      target: `https://climate-assembly-wiki.pages.dev/${lang}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: isKo ? '기후시민회의 위키 아카이브' : 'Korea Climate Assembly Wiki Archive',
    url: 'https://climate-assembly-wiki.pages.dev',
    contactPoint: {
      '@type': 'ContactPoint',
      url: `${REPO}/issues`,
      contactType: 'customer service',
    },
  },
]);
---

<HomeLayout
  title={isKo ? '홈' : 'Home'}
  lang={lang}
  description={isKo
    ? '2026 기후시민회의 모더레이터 아카이브 — 220명 규모 시민참여단의 숙의 과정, En-ROADS 기후 시뮬레이터, 15개 의제 다국어 위키'
    : "2026 Korea Climate Citizens' Assembly Archive — about 220 citizen participants, deliberation sessions, En-ROADS climate simulator, 15-agenda multilingual wiki"}
  ldJson={ldJson}
>

  {isStructuralLocale && (
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <TranslationFallbackBanner targetLang={lang} currentPath={Astro.url.pathname} />
    </div>
  )}

  <!-- ================================================================
       1. HERO — slogan + stats + countdown + CTA
       ================================================================ -->
  <section
    aria-label={isKo ? '소개' : 'Introduction'}
    class="w-full relative overflow-hidden"
    style="background: var(--gradient-hero); padding-block: var(--section-py);"
  >
    <!-- Decorative blobs -->
    <div
      aria-hidden="true"
      class="absolute -top-20 -right-20 w-80 h-80 rounded-full opacity-25 dark:opacity-15 blur-3xl pointer-events-none"
      style="background: var(--gradient-accent);"
    ></div>
    <div
      aria-hidden="true"
      class="absolute -bottom-16 -left-16 w-64 h-64 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none"
      style="background: var(--gradient-highlight);"
    ></div>

    <div class="relative max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold mb-6 bg-[var(--color-accent-muted)] text-[var(--color-accent-hover)] dark:bg-[var(--color-accent-subtle)] dark:text-[var(--color-accent)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
        {isKo ? '2026 기후시민회의 아카이브 · 진행 중' : "2026 Korea Climate Citizens' Assembly Archive · Live"}
      </div>

      <!-- Slogan -->
      <!-- R-18: Korean display headlines use --tracking-korean (-0.01em) not --tracking-tight (-0.03em) -->
      <h1
        class="font-bold text-[var(--color-fg)] mb-5 max-w-3xl"
        style={`font-size: var(--size-display-1); letter-spacing: ${isKo ? 'var(--tracking-korean)' : 'var(--tracking-snug)'}; line-height: var(--leading-tight);`}
      >
        {isKo
          ? '국민이 대한민국의 기후정책을 바꿉니다'
          : "Citizens are changing Korea's climate policy"
        }
      </h1>

      <!-- Description -->
      <p
        class="text-[var(--color-fg-muted)] mb-8 max-w-xl"
        style="font-size: var(--size-display-3); line-height: var(--leading-relaxed);"
      >
        {isKo
          ? '「탄소중립·녹색성장 기본법」 제19조의2에 따라 구성된 220명 규모 시민참여단의 기후 숙의 과정을 기록합니다.'
          : "Documents the climate deliberation of about 220 citizen participants constituted under Article 19-2 of Korea's Carbon Neutrality Framework Act."}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-3 mb-12">
        <a
          href={`/${lang}/agenda/`}
          class="btn btn-primary"
        >
          {isKo ? '의제 전체 보기' : 'View All Agendas'}
        </a>
        <a
          href="https://climatevoice.kr/opinion/write.do"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          {isKo ? '공식 의제 제안' : 'Official Agenda Proposal'}
        </a>
        {/* 2026-06-02 privacy: About link removed (doc routes privatized). */}
      </div>

      <!-- Stats row -->
      <div class="flex flex-wrap gap-8 sm:gap-12">
        <div class="flex flex-col">
          <span
            class="font-bold text-[var(--color-accent)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
          >220</span>
          <span class="text-xs text-[var(--color-fg-muted)] mt-0.5">{isKo ? '시민참여단 규모' : 'Citizen panel scale'}</span>
        </div>
        <div class="flex flex-col">
          <span
            class="font-bold text-[var(--color-accent)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
          >{orderedSessions.length}</span>
          <span class="text-xs text-[var(--color-fg-muted)] mt-0.5">{isKo ? '전체 회차' : 'Total Sessions'}</span>
        </div>
        <div class="flex flex-col">
          <span
            class="font-bold text-[var(--color-accent)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
          >{isKo ? '6개월' : '6 Mo.'}</span>
          <span class="text-xs text-[var(--color-fg-muted)] mt-0.5">{isKo ? '숙의 기간' : 'Duration'}</span>
        </div>
        <div class="flex flex-col">
          <span
            class="font-bold text-[var(--color-accent)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
          >15</span>
          <span class="text-xs text-[var(--color-fg-muted)] mt-0.5">{isKo ? '의제 수' : 'Agendas'}</span>
        </div>
        {nextSession && daysUntil !== null && (
          <div class="flex flex-col">
            <span
              class="font-bold text-[var(--color-accent)]"
              style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
            >
              {daysUntil === 0 ? (isKo ? '오늘' : 'Today') : `D-${daysUntil}`}
            </span>
            <span class="text-xs text-[var(--color-fg-muted)] mt-0.5">{isKo ? '다음 회차' : 'Next Session'}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ================================================================
       2. WHY THIS MATTERS — 풀비드 다크 섹션
       ================================================================ -->
  <section
    aria-labelledby="why-heading"
    class="w-full relative overflow-hidden"
    style="background: var(--gradient-why); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Eyebrow -->
        <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-4">
          WHY THIS MATTERS
        </p>

        <!-- Big statement -->
        <h2
          id="why-heading"
          class="font-bold text-white mb-8"
          style="font-size: var(--size-display-1); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
        >
          {isKo ? (
            <><span class="block">한국 기후위기 정책은</span><span class="block">시민이 결정한다</span></>
          ) : (
            <><span class="block">Korean climate policy</span><span class="block">is decided by citizens</span></>
          )}
        </h2>

        <!-- Context paragraph -->
        <p
          class="text-gray-300 mb-6"
          style="font-size: var(--size-display-3); line-height: var(--leading-relaxed);"
        >
          {isKo
            ? '2026년 5월 16일 출범한 세계 최초 국가 단위 기후 공론 상설기구. 220명 규모의 시민참여단이 학습·토론·숙의를 거쳐 정부에 정책 권고를 제안합니다.'
            : 'Launched on May 16, 2026 as a national permanent climate public sphere. A citizen panel of about 220 people learns, discusses, deliberates, and proposes policy recommendations to the government.'}
        </p>

        <!-- Supporting facts row -->
        <div class="flex flex-wrap gap-6 sm:gap-10 pt-4 border-t border-white/10">
          <div>
            <p class="text-white font-semibold text-sm mb-0.5">{isKo ? '탄소중립기본법 제19조의2' : 'Carbon Neutrality Act §19-2'}</p>
            <p class="text-gray-400 text-xs">{isKo ? '법적 근거' : 'Legal basis'}</p>
          </div>
          <div>
            <p class="text-white font-semibold text-sm mb-0.5">{isKo ? '갤럽·KCRC 설계' : 'Gallup · KCRC design'}</p>
            <p class="text-gray-400 text-xs">{isKo ? '참여단 선발' : 'Participant selection'}</p>
          </div>
          <div>
            <p class="text-white font-semibold text-sm mb-0.5">{isKo ? 'OECD·KNOCA·CAUK·Lisode' : 'OECD · KNOCA · CAUK · Lisode'}</p>
            <p class="text-gray-400 text-xs">{isKo ? '국제 자문' : 'International advisors'}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       3. 4-STAGE FLOW — 시민발의 → 기획 → 숙의 → 권고안
       ================================================================ -->
  <section
    aria-labelledby="flow-heading"
    class="w-full"
    style="background: var(--color-bg); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
        PROCESS
      </p>
      <h2
        id="flow-heading"
        class="font-bold text-[var(--color-fg)] mb-4"
        style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
      >
        {isKo ? '4단계 숙의 과정' : '4-Stage Deliberation'}
      </h2>
      <p class="text-[var(--color-fg-muted)] mb-12 max-w-xl" style="line-height: var(--leading-relaxed);">
        {isKo
          ? '이 위키는 시민발의부터 최종 권고안까지 전 과정을 아카이빙합니다.'
          : 'This wiki archives the entire process from citizen proposals to final recommendations.'}
      </p>

      <!-- Flow steps -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Step 1 -->
        <div class="relative p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-[var(--shadow-sm)]">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-subtle)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-[var(--color-accent)] mb-1">STEP 1</div>
          <h3 class="font-bold text-[var(--color-fg)] text-base mb-2">{isKo ? '시민 발의' : 'Citizen Proposals'}</h3>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? 'climatevoice.kr에서 누구나 의제를 제안. 31건 발의 트래킹 중.' : 'Anyone can propose agendas at climatevoice.kr. Tracking 31 proposals.'}
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-[var(--shadow-sm)]">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-subtle)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-[var(--color-accent)] mb-1">STEP 2</div>
          <h3 class="font-bold text-[var(--color-fg)] text-base mb-2">{isKo ? '기획참여단 워크숍' : 'Planning Panel Workshop'}</h3>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '전문가·시민 혼합 기획단이 의제를 정선·구조화합니다.' : 'Mixed expert-citizen panel refines and structures agendas.'}
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-[var(--shadow-sm)]">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-subtle)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-[var(--color-accent)] mb-1">STEP 3</div>
          <h3 class="font-bold text-[var(--color-fg)] text-base mb-2">{isKo ? '숙의참여단 9회차' : '9-Session Deliberation'}</h3>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '220명 규모 시민참여단이 6개월간 숙의. En-ROADS 시뮬레이터 등 도구 직접 사용.' : 'A citizen panel of about 220 deliberates over six months, with direct use of En-ROADS and other tools.'}
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative p-6 rounded-2xl border border-[var(--color-accent-muted)] bg-[var(--color-accent-subtle)] shadow-[var(--shadow-sm)]">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="text-xs font-bold text-[var(--color-accent)] mb-1">STEP 4</div>
          <h3 class="font-bold text-[var(--color-fg)] text-base mb-2">{isKo ? '권고안 제출' : 'Final Recommendations'}</h3>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '2026년 연말까지 시민 권고안을 도출해 국가 기후정책 논의에 제출합니다.' : 'By the end of 2026, citizen recommendations are prepared for national climate policy discussion.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       4. AGENDA GRID — 6개 핵심 의제
       ================================================================ -->
  <section
    aria-labelledby="agenda-heading"
    class="w-full"
    style="background: var(--color-bg-subtle); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10 gap-4 flex-wrap">
        <div>
          <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
            AGENDA
          </p>
          <h2
            id="agenda-heading"
            class="font-bold text-[var(--color-fg)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
          >
            {isKo ? '주요 의제' : 'Key Agendas'}
          </h2>
        </div>
        <a
          href={`/${lang}/agenda/`}
          class="shrink-0 text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors inline-flex items-center gap-1.5"
        >
          {isKo ? '전체 의제 보기' : 'View all agendas'}
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      {/* R-16: Category colour legend — one compact row above the grid */}
      <div class="flex flex-wrap items-center gap-4 mb-6" aria-label={isKo ? '의제 분류 범례' : 'Agenda category legend'}>
        <span class="text-xs text-[var(--color-fg-muted)] font-semibold">{isKo ? '분류:' : 'Category:'}</span>
        <span class="flex items-center gap-1.5 text-xs">
          <span class="inline-block w-3 h-3 rounded-full" style="background:var(--color-cat-general-bar)" aria-hidden="true"></span>
          <span style="color:var(--color-cat-general-fg)">{isKo ? '일반 의제' : 'General'}</span>
        </span>
        <span class="flex items-center gap-1.5 text-xs">
          <span class="inline-block w-3 h-3 rounded-full" style="background:var(--color-cat-meta-bar)" aria-hidden="true"></span>
          <span style="color:var(--color-cat-meta-fg)">{isKo ? '메타 의제' : 'Meta'}</span>
        </span>
        <span class="flex items-center gap-1.5 text-xs">
          <span class="inline-block w-3 h-3 rounded-full" style="background:var(--color-cat-action-bar)" aria-hidden="true"></span>
          <span style="color:var(--color-cat-action-fg)">{isKo ? '실행 의제' : 'Action'}</span>
        </span>
      </div>

      {heroAgendas.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {heroAgendas.map((entry) => {
            // R-05: KO original is always 'native' trust. EN shows the translation status.
            const contentStatus =
              lang === 'ko'
                ? 'native'
                : (entry.data.translations?.en?.status ?? 'machine');
            return (
              <AgendaCard
                id={entry.data.id}
                title={entry.data.title}
                category={entry.data.category}
                status={entry.data.status}
                slug={entry.data.slug}
                lang={lang}
                contentStatus={contentStatus}
                enAvailable={!!entry.data.translations?.en}
              />
            );
          })}
        </div>
      ) : (
        <p class="text-sm text-[var(--color-fg-subtle)]">
          {isKo ? '의제가 준비 중입니다.' : 'Agendas coming soon.'}
        </p>
      )}
    </div>
  </section>

  <!-- ================================================================
       5. TOOLS SHOWCASE — En-ROADS 강조
       ================================================================ -->
  <section
    aria-labelledby="tools-heading"
    class="w-full relative overflow-hidden"
    style="background: var(--color-bg); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 items-center">
        <!-- Text side -->
        <div>
          <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
            SIMULATION TOOL
          </p>
          <h2
            id="tools-heading"
            class="font-bold text-[var(--color-fg)] mb-5"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
          >
            En-ROADS<br />{isKo ? '기후 시뮬레이터' : 'Climate Simulator'}
          </h2>
          <p class="text-[var(--color-fg-muted)] mb-4" style="font-size: var(--text-base); line-height: var(--leading-relaxed);">
            {isKo
              ? '이 도구로 시민참여단이 18개 정책 슬라이더를 직접 조작해 2100년 지구 온도를 시뮬레이션합니다. 매사추세츠 MIT Climate Interactive 개발.'
              : 'Citizen participants use this tool to directly manipulate 18 policy levers and simulate global temperatures to 2100. Developed by MIT Climate Interactive.'}
          </p>
          <ul class="space-y-2 mb-8">
            {(isKo ? [
              '18개 정책 레버 (에너지·교통·토지·탄소가격 등)',
              '실시간 온도 시나리오 2100년까지',
              '한국어 자료집 v1.1 제공',
              '모더레이터 활용 가이드 포함',
            ] : [
              '18 policy levers (energy, transport, land, carbon price…)',
              'Real-time temperature scenarios to 2100',
              'Korean resource guide v1.1 available',
              'Moderator facilitation guide included',
            ]).map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[var(--color-fg-muted)]">
                <svg aria-hidden="true" class="w-4 h-4 mt-0.5 shrink-0 text-[var(--color-accent)]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M5 13l4 4L19 7"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          {/* 2026-06-02 privacy: En-ROADS hub + guide links removed (tools routes privatized). */}
        </div>

        <!-- Visual side — temperature badge card -->
        <div class="flex justify-center lg:justify-end">
          <div
            class="relative w-full max-w-sm rounded-2xl border border-[var(--color-info-bg)] p-8 shadow-[var(--shadow-xl)]"
            style="background: var(--color-info-bg);"
          >
            <!-- Temperature display -->
            <!-- R-21: Label as illustrative scenario — not actual measured data -->
            <div class="text-center mb-6">
              <div class="text-6xl font-bold text-orange-500 mb-1" style="letter-spacing: var(--tracking-tight);">+2.4°C</div>
              <div class="text-sm text-[var(--color-fg-muted)]">{isKo ? '예시 시나리오 (2100년)' : 'Illustrative scenario (2100)'}</div>
              <div class="text-xs text-[var(--color-fg-muted)] mt-1 opacity-70">
                {isKo ? '실제 슬라이더 조작 결과는 다릅니다' : 'Actual slider results will vary'}
              </div>
            </div>
            <!-- Lever preview -->
            <div class="space-y-3">
              {(isKo ? [
                { label: '태양광 발전', value: 65 },
                { label: '전기차 전환', value: 42 },
                { label: '탄소세', value: 78 },
              ] : [
                { label: 'Solar Power', value: 65 },
                { label: 'EV Transition', value: 42 },
                { label: 'Carbon Tax', value: 78 },
              ]).map((lever) => (
                <div>
                  <div class="flex justify-between text-xs text-[var(--color-fg-muted)] mb-1">
                    <span>{lever.label}</span>
                    <span class="text-[var(--color-accent)] font-semibold">{lever.value}%</span>
                  </div>
                  <div class="h-1.5 rounded-full bg-[var(--color-border)]">
                    <div
                      class="h-1.5 rounded-full bg-[var(--color-accent)]"
                      style={`width: ${lever.value}%`}
                    ></div>
                  </div>
                </div>
              ))}
            </div>
            <!-- R-21: Source attribution for tool card data -->
            <p class="text-xs text-center text-[var(--color-fg-muted)] mt-5">
              {isKo ? '시민이 직접 슬라이더를 조작합니다' : 'Citizens manipulate sliders directly'}
            </p>
            <p class="text-[10px] text-center text-[var(--color-fg-muted)] mt-1 opacity-60">
              {isKo
                ? '출처: MIT Climate Interactive En-ROADS (예시 값)'
                : 'Source: MIT Climate Interactive En-ROADS (illustrative values)'}
            </p>
          </div>
        </div>
      </div>

      {/* 2026-08-29: 「숙의 온톨로지 그래프」·「온톨로지 사용설명서」 카드 2장 숨김.
          제5차 회의 당일이라 홈에서 6월 워크숍 그래프가 오늘의 숙의 결과로 읽힌다.
          상단 탭(navigation.ts)·의제 자료실과 같은 이유·같은 방식 — 페이지는 남기고
          안내 동선에서만 뺀다. 직접 URL(/workshop-graph/, /workshop-graph/guide/) 보존. */}
    </div>
  </section>

  <!-- ================================================================
       6. LATEST ACTIVITY
       ================================================================ -->
  <section
    aria-labelledby="activity-heading"
    class="w-full"
    style="background: var(--color-bg-subtle); padding-block: var(--section-py-sm);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8 gap-4 flex-wrap">
        <div>
          <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
            LATEST ACTIVITY
          </p>
          <h2
            id="activity-heading"
            class="font-bold text-[var(--color-fg)]"
            style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight);"
          >
            {isKo ? '최근 업데이트' : 'Recent Updates'}
          </h2>
        </div>
        <a
          href="https://climatevoice.kr/notice/list.do"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors"
        >
          {isKo ? '공식 공지 전체 →' : 'Official notices →'}
        </a>
      </div>

      <ul class="divide-y divide-[var(--color-border)]">
        {latestActivity.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center justify-between gap-4 py-4 hover:bg-[var(--color-card-hover)] rounded-lg px-3 -mx-3 transition-colors group"
            >
              <div class="flex items-center gap-3 min-w-0">
                <span class="shrink-0 w-2 h-2 rounded-full bg-[var(--color-accent)] opacity-70"></span>
                <span class="text-sm text-[var(--color-fg)] group-hover:text-[var(--color-accent)] transition-colors truncate">
                  {item.label}
                </span>
              </div>
              <span class="shrink-0 text-xs text-[var(--color-fg-muted)] font-mono">{item.date}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================================================================
       7. TRUST & METHODOLOGY
       ================================================================ -->
  <section
    aria-labelledby="trust-heading"
    class="w-full"
    style="background: var(--gradient-trust); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
        TRUST & METHODOLOGY
      </p>
      <h2
        id="trust-heading"
        class="font-bold text-[var(--color-fg)] mb-4"
        style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
      >
        {isKo ? '인용 가능한 위키' : 'Citable Wiki'}
      </h2>
      <p class="text-[var(--color-fg-muted)] mb-12 max-w-xl" style="line-height: var(--leading-relaxed);">
        {isKo
          ? '모든 페이지에 신뢰도 라벨·라이선스·인용 형식을 명시합니다. Wikipedia·MDN·Anthropic Docs 수준의 학술적 신뢰성을 목표로 합니다.'
          : 'Every page clearly displays trust labels, license information, and citation formats. We aim for academic reliability on par with Wikipedia, MDN, and Anthropic Docs.'}
      </p>

      <!-- R-07: Use actual TrustBadge components instead of emoji — single visual language -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-12">
        <!-- machine -->
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)]">
          <div class="flex items-center gap-2 mb-3">
            <TrustBadge status="machine" lang={lang} />
          </div>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? 'LLM 자동 번역·초안. 사실 오류 가능성 있음.' : 'LLM auto-translated or drafted. May contain factual errors.'}
          </p>
        </div>
        <!-- reviewed -->
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)]">
          <div class="flex items-center gap-2 mb-3">
            <TrustBadge status="reviewed" lang={lang} />
          </div>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '전문가 검토 완료. 인용 가능.' : 'Expert-reviewed. Safe to cite.'}
          </p>
        </div>
        <!-- native -->
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)]">
          <div class="flex items-center gap-2 mb-3">
            <TrustBadge status="native" lang={lang} />
          </div>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '원어 작성. 번역본 기준 원문.' : 'Written in source language. Authoritative original.'}
          </p>
        </div>
        <!-- author-verified -->
        <div class="p-5 rounded-xl border border-[var(--color-accent-muted)] bg-[var(--color-accent-subtle)]">
          <div class="flex items-center gap-2 mb-3">
            <TrustBadge status="author-verified" lang={lang} />
          </div>
          <p class="text-xs text-[var(--color-fg-muted)]" style="line-height: var(--leading-relaxed);">
            {isKo ? '저자 직접 검증. 가장 높은 신뢰도.' : 'Directly verified by the author. Highest trust level.'}
          </p>
        </div>
      </div>

      <!-- License + Sources row -->
      <div class="flex flex-wrap gap-6 items-start pt-8 border-t border-[var(--color-border)]">
        <div>
          <p class="text-xs font-semibold text-[var(--color-fg)] mb-1">{isKo ? '라이선스' : 'License'}</p>
          <p class="text-sm text-[var(--color-fg-muted)]">CC BY-SA 4.0</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-[var(--color-fg)] mb-1">{isKo ? '주요 출처' : 'Key Sources'}</p>
          <p class="text-sm text-[var(--color-fg-muted)]">갤럽·KCRC · OECD · KNOCA · CAUK · Lisode · MIT Climate Interactive</p>
        </div>
        <div>
          <p class="text-xs font-semibold text-[var(--color-fg)] mb-1">{isKo ? '오픈소스' : 'Open Source'}</p>
          <a
            href={REPO}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors"
          >
            GitHub →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================
       8. GET INVOLVED
       ================================================================ -->
  <section
    aria-labelledby="involved-heading"
    class="w-full relative overflow-hidden"
    style="background: var(--gradient-why); padding-block: var(--section-py);"
  >
    <div class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold tracking-widest uppercase text-[var(--color-accent)] mb-3">
        GET INVOLVED
      </p>
      <h2
        id="involved-heading"
        class="font-bold text-white mb-4"
        style="font-size: var(--size-display-2); letter-spacing: var(--tracking-tight); line-height: var(--leading-tight);"
      >
        {isKo ? '함께 참여하세요' : 'Join the effort'}
      </h2>
      <p class="text-gray-300 mb-12 max-w-xl" style="line-height: var(--leading-relaxed);">
        {isKo
          ? '공식 의제 제안과 공지, 위키 기여 경로를 함께 안내합니다.'
          : 'Official agenda proposals, notices, and wiki contribution paths are collected here.'}
      </p>

      <div class="grid gap-5 sm:grid-cols-3">
        <!-- 공식 의제 제안 -->
        <a
          href="https://climatevoice.kr/opinion/write.do"
          target="_blank"
          rel="noopener noreferrer"
          class="group block p-6 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
        >
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="font-bold text-white text-base mb-2">
            {isKo ? '공식 의제 제안' : 'Official Agenda Proposal'}
          </h3>
          <p class="text-xs text-gray-400" style="line-height: var(--leading-relaxed);">
            {isKo ? 'climatevoice.kr 본인인증 후 기후시민회의 의제를 제안합니다.' : 'Submit an agenda through climatevoice.kr after identity verification.'}
          </p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs text-[var(--color-accent)] group-hover:gap-2 transition-all">
            {isKo ? '제안하기' : 'Submit'} <span aria-hidden="true">→</span>
          </span>
        </a>

        <!-- 공식 공지 -->
        <a
          href="https://climatevoice.kr/notice/list.do"
          target="_blank"
          rel="noopener noreferrer"
          class="group block p-6 rounded-2xl border border-white/10 bg-white/5 hover:bg-white/10 transition-colors"
        >
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v8a2 2 0 01-2 2z"/>
              <path d="M14 4v6h6M8 13h8M8 17h5"/>
            </svg>
          </div>
          <h3 class="font-bold text-white text-base mb-2">
            {isKo ? '공식 공지사항' : 'Official Notices'}
          </h3>
          <p class="text-xs text-gray-400" style="line-height: var(--leading-relaxed);">
            {isKo ? '발대식, 의제 접수, 영상 안내 등 공식 자료를 확인합니다.' : 'Check official launch, agenda intake, and media notices.'}
          </p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs text-[var(--color-accent)] group-hover:gap-2 transition-all">
            {isKo ? '공지 보기' : 'View notices'} <span aria-hidden="true">→</span>
          </span>
        </a>

        <!-- 이슈·제안 -->
        <div class="p-6 rounded-2xl border border-white/10 bg-white/5">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent)] flex items-center justify-center mb-4">
            <svg aria-hidden="true" class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <h3 class="font-bold text-white text-base mb-2">
            {isKo ? '이슈·제안' : 'Issues & Suggestions'}
          </h3>
          <p class="text-xs text-gray-400" style="line-height: var(--leading-relaxed);">
            {isKo ? '오류 신고, 콘텐츠 개선 제안, 새 의제 아이디어를 환영합니다.' : 'Bug reports, content improvement suggestions, and new agenda ideas welcome.'}
          </p>
          <a
            href={`${REPO}/issues/new`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1 text-xs text-[var(--color-accent)] hover:gap-2 transition-all"
          >
            {isKo ? 'GitHub 이슈 열기' : 'Open GitHub issue'} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</HomeLayout>
