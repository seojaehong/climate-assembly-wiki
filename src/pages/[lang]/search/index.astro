---
/**
 * D7-p — /[lang]/search/
 *
 * Pagefind search UI page (Design §5.1).
 *
 * Pagefind is a static search library that runs post-build.
 * astro-pagefind integration auto-injects the pagefind bundle.
 *
 * The Search component from astro-pagefind renders the UI overlay.
 * Language filtering is automatic: Pagefind indexes `lang` from <html lang="...">
 * so /ko/search/ returns KO results and /en/search/ returns EN results.
 *
 * Accessibility: dedicated /search/ page is the a11y fallback
 * for the header icon trigger that opens the overlay.
 *
 * Performance: Pagefind WASM (~100KB gzip) is loaded async on demand.
 * First-keystroke target: <300ms (Plan §7.1).
 */
import Base from '../../../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search';

// ---------------------------------------------------------------------------
// getStaticPaths
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  return [
    { params: { lang: 'ko' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'zh' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;

const pageTitle = lang === 'ko' ? '검색' : 'Search';
const placeholder = lang === 'ko' ? '용어, 의제, 회차 검색…' : 'Search agendas, sessions, tools…';
---
<Base title={pageTitle} lang={lang}>
  <article id="main-content">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">{pageTitle}</h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      {lang === 'ko'
        ? '전체 위키 콘텐츠를 검색합니다. 현재 언어의 페이지만 표시됩니다.'
        : 'Search all wiki content. Results are filtered to the current language.'}
    </p>

    <div class="pagefind-wrapper" data-pagefind-body>
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 20,
          placeholder,
          translations: lang === 'ko' ? {
            placeholder: '검색어를 입력하세요',
            clear_search: '초기화',
            load_more: '더 보기',
            search_label: '이 사이트 검색',
            filters_label: '필터',
            zero_results: '"[SEARCH_TERM]"에 대한 결과 없음',
            many_results: '"[SEARCH_TERM]"에 대한 [COUNT]개 결과',
            one_result: '"[SEARCH_TERM]"에 대한 1개 결과',
            alt_search: '"[SEARCH_TERM]" 대신 "[DIFFERENT_TERM]" 검색됨',
            search_suggestion: '"[DIFFERENT_TERM]"을(를) 검색하겠습니까?',
            searching: '검색 중…',
          } : undefined,
        }}
      />
    </div>

    <p class="mt-8 text-xs text-gray-400">
      {lang === 'ko'
        ? '검색 인덱스는 빌드 시점 기준입니다. 최신 내용이 반영되지 않을 수 있습니다.'
        : 'Search index is generated at build time. Recently added content may not appear.'}
    </p>
  </article>
</Base>
