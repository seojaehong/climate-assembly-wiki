---
/**
 * D3-p — /[lang]/sessions/[n]/
 *
 * Blocker 1 resolution (Design §2.2):
 *   getCollection('session').find(e => e.data.order === Number(n))
 *
 * Session files are named {YYYY-MM-DD}-{slug}.md (D2: singular directory).
 * The `order` field in frontmatter maps numeric URL ordinal → file.
 * Sessions without an `order` field are not routable via this URL pattern
 * and will not be emitted in getStaticPaths.
 *
 * i18n fallback: 'en' paths are always emitted (for fallbackType:'rewrite').
 * If no EN translation exists, Astro serves the KO collection content at /en/
 * and the banner is shown.
 *
 * Layout: imports SessionLayout (Group C). Falls back to Base until C ships.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SessionLayout from '../../../layouts/SessionLayout.astro';
import { SITE_LOCALE_CODES, STRUCTURAL_LOCALE_CODES, isSiteLocale } from '../../../lib/site-locales';

// ---------------------------------------------------------------------------
// getStaticPaths — Blocker 1 fix
// ---------------------------------------------------------------------------
export async function getStaticPaths() {
  const sessionEntries = await getCollection('session');

  // Only emit paths for sessions that have an explicit `order` field.
  // 2026-06-02 privacy: also skip draft sessions so unpublished pages get no routes.
  const orderedSessions = sessionEntries.filter(
    (e) => typeof e.data.order === 'number' && e.data.draft !== true
  );

  return SITE_LOCALE_CODES.flatMap((lang) =>
    orderedSessions.map((entry) => ({
      params: { lang, n: String(entry.data.order) },
      props: { entry, lang },
    }))
  );
}

// ---------------------------------------------------------------------------
// Page props
// ---------------------------------------------------------------------------
const { entry, lang } = Astro.props as { entry: CollectionEntry<'session'>; lang: string };
const { n } = Astro.params;

const { Content } = await render(entry);

// Determine whether to show fallback banner.
// Since session translations/ tree doesn't exist yet in M1,
// show banner for any EN page (safe default; remove when en translations ship).
const hasEnTranslation =
  lang === 'en' &&
  entry.data.translations &&
  typeof (entry.data.translations as Record<string, unknown>)['en'] !== 'undefined';

const showFallbackBanner =
  (lang === 'en' && !hasEnTranslation) ||
  (isSiteLocale(lang) && STRUCTURAL_LOCALE_CODES.includes(lang));

const translationStatus =
  lang !== 'ko' && entry.data.translations
    ? (entry.data.translations as Record<string, { status: 'machine' | 'reviewed' | 'native' | 'author-verified' } | undefined>)[lang]?.status
    : undefined;

const sessionLabel = lang === 'ko' ? `${n}차` : `Session ${n}`;
---
<SessionLayout
  title={`${sessionLabel} — ${entry.data.title}`}
  lang={lang}
  trustLabel={translationStatus ?? 'author-verified'}
  license={entry.data.license as 'CC-BY-SA-4.0' | 'CC-BY-4.0' | 'CC-BY-NC-SA-3.0-IGO' | 'all-rights-reserved'}
  alternateLangs={[...SITE_LOCALE_CODES]}
  canonicalPath={`/${lang}/sessions/${n}/`}
  isFallback={showFallbackBanner}
  sourceKorean={`/ko/sessions/${n}/`}
  sessionOrder={entry.data.order ?? undefined}
  sessionDate={entry.data.date}
  sessionType={entry.data.session_type as 'kickoff' | 'lecture' | 'discussion' | 'recommendation' | 'event' | 'closing'}
  speaker={entry.data.speaker}
  affiliation={entry.data.affiliation}
  frontmatter={{ last_updated: entry.data.last_updated }}
>
  <h1 class="text-2xl font-bold text-[var(--color-fg)] mb-4 not-prose">{entry.data.title}</h1>

  {entry.data.agendas_discussed.length > 0 && (
    <div class="flex flex-wrap gap-1 mb-6 not-prose" aria-label={lang === 'ko' ? '논의된 의제' : 'Agendas discussed'}>
      {entry.data.agendas_discussed.map((id: number) => (
        <a
          href={`/${lang}/agenda/`}
          class="text-xs px-2 py-0.5 bg-[var(--color-accent-subtle)] text-[var(--color-accent)] rounded border border-[var(--color-accent-muted)] hover:underline"
        >
          #{id}
        </a>
      ))}
    </div>
  )}

  <Content />
</SessionLayout>
