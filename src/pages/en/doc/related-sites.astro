---
/**
 * /en/doc/related-sites/
 * English version — static route.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedSites from '../../../components/RelatedSites.astro';

const lang = 'en';

const pageTitle = 'Related Sites';
const pageDescription =
  'Curated external resources cited by the Climate Assembly Wiki: tools, official bodies, methodology, academic, media, and precedent sites.';
---

<BaseLayout title={pageTitle} lang={lang} description={pageDescription}>
  <article id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-3 text-xs" style="color: var(--color-fg-muted);">
        <a href="/en/" style="color: var(--color-fg-muted); text-decoration: none;" class="hover:underline">Home</a>
        <span aria-hidden="true">/</span>
        <span>{pageTitle}</span>
      </div>

      <h1
        class="text-3xl font-bold tracking-tight mb-3"
        style="color: var(--color-fg); letter-spacing: var(--tracking-snug);"
      >
        {pageTitle}
      </h1>

      <p class="text-base" style="color: var(--color-fg-muted); max-width: 60ch; line-height: var(--leading-relaxed);">
        External primary sources, tools, institutions, and precedent sites cited by this wiki. Each card opens in a new tab.
      </p>
    </header>

    {/* ── Simulators & Tools ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #2563eb;"
          aria-hidden="true"
        >T</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Simulators &amp; Tools</h2>
      </div>
      <RelatedSites category="tool" title="" />
    </section>

    {/* ── Official Bodies ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #16a34a;"
          aria-hidden="true"
        >O</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Official Bodies</h2>
      </div>
      <RelatedSites category="official" title="" />
    </section>

    {/* ── Methodology ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #7c3aed;"
          aria-hidden="true"
        >M</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Methodology &amp; Standards</h2>
      </div>
      <RelatedSites category="methodology" title="" />
    </section>

    {/* ── Academic ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #059669;"
          aria-hidden="true"
        >A</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Academic &amp; Science</h2>
      </div>
      <RelatedSites category="academic" title="" />
    </section>

    {/* ── Media ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #d97706;"
          aria-hidden="true"
        >M</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Media</h2>
      </div>
      <RelatedSites category="media" title="" />
    </section>

    {/* ── Precedent Assemblies ── */}
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-5">
        <span
          class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-white text-sm font-bold"
          style="background: #6b7280;"
          aria-hidden="true"
        >P</span>
        <h2 class="text-xl font-semibold" style="color: var(--color-fg);">Precedent Assemblies</h2>
      </div>
      <RelatedSites category="precedent" title="" />
    </section>

    <footer class="pt-8 border-t" style="border-color: var(--color-border);">
      <p class="text-xs" style="color: var(--color-fg-subtle);">
        Report errors or missing sites: GitHub Issues or{' '}
        <a href="mailto:iceamericano9@gmail.com" style="color: var(--color-link);" class="hover:underline">
          iceamericano9@gmail.com
        </a>
        . Last updated: 2026-06-01 · CC-BY-SA-4.0
      </p>
    </footer>
  </article>
</BaseLayout>
