---
/**
 * @deprecated GAP-3 (site-composition.analysis.md, 2026-05-31)
 * Transitional layout — superseded by BaseLayout.astro (Group C, Design §3.4).
 * Phase 3 fix: now renders SiteHeader + SiteFooter for visual parity.
 * Do NOT add new imports of Base.astro — use BaseLayout.astro.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  lang: string;
  description?: string;
}

const { title, lang, description = '2026 기후시민회의 모더레이터 아카이브' } = Astro.props;

// M4 (2026-06-01): emit hreflang for all 5 locales on Base-using pages too.
// Base.astro is deprecated, but 9 pages still import it; SEO requires alternates
// to ja/zh/es to ship even before migration to BaseLayout completes.
const SITE_URL = (Astro.site?.toString() ?? 'https://climate-assembly-wiki.pages.dev').replace(/\/$/, '');
const M4_LOCALES = ['ko', 'en', 'ja', 'zh', 'es'];
const _path = Astro.url.pathname;
const hreflangLinks = M4_LOCALES.map((altLang) => {
  const altPath = _path.replace(/^\/(ko|en|ja|zh|es)\//, `/${altLang}/`);
  const ensured = altPath.endsWith('/') ? altPath : altPath + '/';
  return { lang: altLang, url: `${SITE_URL}${ensured}` };
});
const canonicalUrl = `${SITE_URL}${_path.endsWith('/') ? _path : _path + '/'}`;
const xDefaultUrl = hreflangLinks.find((l) => l.lang === 'ko')?.url ?? canonicalUrl;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | 기후시민회의 Wiki</title>
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.lang} href={l.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Theme: apply dark class AND data-theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (!stored && prefersDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--color-bg)] text-[var(--color-fg)] transition-colors duration-200">

    <SiteHeader lang={lang} />

    <main id="main-content" tabindex="-1" data-pagefind-body class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <SiteFooter lang={lang} />

  </body>
</html>
