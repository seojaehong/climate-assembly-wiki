---
/**
 * @deprecated GAP-3 (site-composition.analysis.md, 2026-05-31)
 * Transitional layout — superseded by BaseLayout.astro (Group C, Design §3.4).
 * Phase 3 fix: now renders SiteHeader + SiteFooter for visual parity.
 * Do NOT add new imports of Base.astro — use BaseLayout.astro.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_LOCALE_CODES, localeDirection, replaceLocalePrefix, siteShellCopy } from '../lib/site-locales';

interface Props {
  title: string;
  lang: string;
  description?: string;
}

const { title, lang, description: descriptionProp } = Astro.props;
const shellCopy = siteShellCopy(lang);
const description = descriptionProp ?? shellCopy.defaultDescription;

// Emit hreflang for every public locale on Base-using pages too.
// Base.astro is deprecated, but 9 pages still import it; SEO requires alternates
// to structural locales before migration to BaseLayout completes.
const SITE_URL = (Astro.site?.toString() ?? 'https://climate-assembly-wiki.pages.dev').replace(/\/$/, '');
const _path = Astro.url.pathname;
const hreflangLinks = SITE_LOCALE_CODES.map((altLang) => {
  const altPath = replaceLocalePrefix(_path, altLang);
  const ensured = altPath.endsWith('/') ? altPath : altPath + '/';
  return { lang: altLang, url: `${SITE_URL}${ensured}` };
});
const canonicalUrl = `${SITE_URL}${_path.endsWith('/') ? _path : _path + '/'}`;
const xDefaultUrl = hreflangLinks.find((l) => l.lang === 'ko')?.url ?? canonicalUrl;
---
<!doctype html>
<html lang={lang} dir={localeDirection(lang)} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | {shellCopy.siteName}</title>
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.lang} href={l.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Theme: apply dark class AND data-theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var isDark = stored === 'dark' || (!stored && prefersDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[var(--color-bg)] text-[var(--color-fg)] transition-colors duration-200">

    <a
      href="#main-content"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:dark:bg-gray-900 focus:border-2 focus:border-green-600 focus:rounded focus:text-green-800 focus:dark:text-green-400 focus:outline-none focus:ring-2 focus:ring-green-500"
    >
      {shellCopy.skipToContent}
    </a>

    <SiteHeader lang={lang} />
    <SearchModal lang={lang} />

    <main id="main-content" tabindex="-1" data-pagefind-body class="max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <SiteFooter lang={lang} />

  </body>
</html>
