---
/**
 * HomeLayout.astro — Home page layout: no sidebar, full-bleed sections.
 * Design §4 Group C (C4). Composes BaseLayout.
 *
 * Phase 3 uplift: removed outer container wrapper so each section in the
 * slot can be truly full-bleed (w-full) or self-constrained.
 * Inner content uses max-w-[var(--size-container)] mx-auto px-4 sm:px-6 lg:px-8.
 *
 * Used by: src/pages/[lang]/index.astro
 * Does NOT render SiteSidebar (home page is full-width, Design §3.5).
 */

import BaseLayout from './BaseLayout.astro';
import { SITE_LOCALE_CODES } from '../lib/site-locales';

// ---------------------------------------------------------------------------
// Props
// ---------------------------------------------------------------------------
export interface Props {
  /** Page title passed through to BaseLayout <title> */
  title: string;
  /** Current page language */
  lang: string;
  /** Optional meta description override */
  description?: string;
  /** Optional JSON-LD structured data (passed through to BaseLayout) */
  ldJson?: string;
}

const { title, lang, description, ldJson } = Astro.props;

// Structural locales render EN body content with a prominent fallback banner.
const alternateLangs = [...SITE_LOCALE_CODES];
---
<BaseLayout
  title={title}
  lang={lang}
  description={description}
  alternateLangs={alternateLangs}
  canonicalPath={`/${lang}/`}
  ogType="website"
  ldJson={ldJson}
>
  <!-- Full-bleed slot — each section manages its own width constraint -->
  <slot />
</BaseLayout>
