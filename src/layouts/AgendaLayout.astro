---
/**
 * AgendaLayout.astro — Layout for individual agenda pages.
 * Design §4 Group C (C1): Header + Sidebar + TrustBadge + LicenseBadge.
 *
 * Used by: src/pages/[lang]/agenda/[slug].astro
 *
 * Group B components (parallel development):
 *   SiteSidebar, TrustBadge, LicenseBadge, TranslationFallbackBanner
 */

import BaseLayout from './BaseLayout.astro';
import SiteSidebar from '../components/SiteSidebar.astro';
import TrustBadge from '../components/TrustBadge.astro';
import LicenseBadge from '../components/LicenseBadge.astro';
import TranslationFallbackBanner from '../components/TranslationFallbackBanner.astro';
import Toc from '../components/Toc.astro';

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

/** Trust label values — Design §3.1, §1.4 */
type TrustStatus = 'machine' | 'reviewed' | 'native' | 'author-verified';

/** License values — Design §3.2, §1.5 */
type LicenseValue = 'CC-BY-SA-4.0' | 'CC-BY-4.0' | 'CC-BY-NC-SA-3.0-IGO' | 'all-rights-reserved';

// ---------------------------------------------------------------------------
// Props
// ---------------------------------------------------------------------------
export interface Props {
  /** Page title */
  title: string;
  /** Current page language */
  lang: string;
  /** Meta description (optional; auto-generated from first paragraph in pages) */
  description?: string;
  /** Trust/translation status for TrustBadge (Design §3.1) */
  trustLabel?: TrustStatus;
  /** License for LicenseBadge (Design §3.2) */
  license?: LicenseValue;
  /**
   * Alternate languages that have real (non-fallback) translations.
   * Used for hreflang emission. Defaults to ['ko'] if no EN translation.
   */
  alternateLangs?: string[];
  /**
   * Canonical path override (e.g. '/ko/agenda/climate-dividend/').
   * Inferred from URL if omitted.
   */
  canonicalPath?: string;
  /**
   * Source Korean page URL (for TranslationFallbackBanner).
   * Set when rendering an EN page that falls back to KO content.
   */
  sourceKorean?: string;
  /**
   * True when this page is displaying fallback content (EN URL → KO content).
   * Triggers TranslationFallbackBanner (Design §1.3, §3.9).
   */
  isFallback?: boolean;
  /**
   * Frontmatter data from the agenda collection entry.
   * Used to build JSON-LD Article schema (Design §5.2).
   */
  frontmatter?: {
    id?: number;
    last_updated?: string;
    ministries?: string[];
    international_cases?: string[];
  };
  /** For 'all-rights-reserved' license badge — organisation name */
  orgName?: string;
  /**
   * Headings from entry.render() — used by Toc (M2-2).
   * Passed as { depth, slug, text }[]. Only h2/h3 are shown.
   */
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

// ---------------------------------------------------------------------------
// Resolve props
// ---------------------------------------------------------------------------
const {
  title,
  lang,
  description,
  trustLabel = 'author-verified',
  license = 'CC-BY-SA-4.0',
  alternateLangs = ['ko'],
  canonicalPath,
  sourceKorean,
  isFallback = false,
  frontmatter,
  orgName,
  headings = [],
} = Astro.props;

// ---------------------------------------------------------------------------
// JSON-LD Article schema (Design §5.2)
// ---------------------------------------------------------------------------
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  name: title,
  ...(description && { description }),
  inLanguage: lang,
  author: {
    '@type': 'Person',
    name: 'Jaehong Seo',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Korea Climate Assembly Wiki',
  },
  ...(frontmatter?.last_updated && { dateModified: frontmatter.last_updated }),
  ...(canonicalPath && {
    url: `https://climate-assembly-wiki.pages.dev${canonicalPath}`,
  }),
};

const ldJson = JSON.stringify(articleSchema);
---
<BaseLayout
  title={title}
  lang={lang}
  description={description}
  alternateLangs={alternateLangs}
  canonicalPath={canonicalPath}
  ogType="article"
  ldJson={ldJson}
>
  <!-- Translation fallback banner (Design §1.3, §3.9) -->
  {isFallback && (
    <TranslationFallbackBanner targetLang={lang} />
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex gap-8">

      <!-- Left sidebar (Design §3.5) -->
      <aside class="hidden lg:block w-64 flex-shrink-0">
        <SiteSidebar lang={lang} currentPath={Astro.url.pathname} />
      </aside>

      <!-- Main content area -->
      <article class="flex-1 min-w-0">

        <!-- Mobile TOC (M2-2) — <details> toggle, hidden on xl+ -->
        <Toc headings={headings} lang={lang} variant="mobile" />

        <!-- Wiki meta line: last updated · trust · license -->
        {frontmatter?.last_updated && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-4 text-xs text-[var(--color-fg-muted)]">
            <span>
              {lang === 'ko' ? '마지막 갱신:' : 'Last updated:'}
              <time class="ml-1 font-mono text-[var(--color-fg-subtle)]">{frontmatter.last_updated}</time>
            </span>
            <span aria-hidden="true" class="text-[var(--color-border-strong)]">·</span>
            {trustLabel && (
              <TrustBadge status={trustLabel} lang={lang} />
            )}
            <span aria-hidden="true" class="text-[var(--color-border-strong)]">·</span>
            <LicenseBadge license={license} orgName={orgName} />
          </div>
        )}

        {/* Fallback: trust badge without meta line (when no last_updated) */}
        {!frontmatter?.last_updated && trustLabel && (
          <div class="mb-3">
            <TrustBadge status={trustLabel} lang={lang} />
          </div>
        )}

        <!-- Page body slot -->
        <div class="prose prose-green dark:prose-invert max-w-none">
          <slot />
        </div>

        <!-- Page footer: citation toggle + source link + license -->
        <footer class="mt-10 pt-6 border-t border-[var(--color-border)]">

          <!-- Citation toggle -->
          <details class="mb-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-subtle)] overflow-hidden">
            <summary class="flex items-center gap-2 px-4 py-3 cursor-pointer select-none text-sm font-semibold text-[var(--color-fg)] hover:bg-[var(--color-card-hover)] transition-colors">
              <svg aria-hidden="true" class="w-4 h-4 text-[var(--color-accent)] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              {lang === 'ko' ? '이 페이지 인용하기' : 'Cite this page'}
            </summary>
            <div class="px-4 pb-4 pt-2 space-y-4">
              {/* BibTeX */}
              <div>
                <p class="text-xs font-bold text-[var(--color-fg-muted)] uppercase tracking-wide mb-1.5">BibTeX</p>
                <pre class="text-[11px] leading-relaxed bg-[var(--color-code-bg)] rounded-lg p-3 overflow-x-auto whitespace-pre-wrap break-all"><code>{`@misc{climatewiki_${(frontmatter?.last_updated ?? '2026').replace(/-/g, '')},
  title  = {${title}},
  author = {Seo, Jaehong},
  year   = {${(frontmatter?.last_updated ?? '2026').slice(0, 4)}},
  url    = {https://climate-assembly-wiki.pages.dev${canonicalPath ?? ''}},
  note   = {Korea Climate Assembly Wiki, CC BY-SA 4.0}
}`}</code></pre>
              </div>
              {/* MLA */}
              <div>
                <p class="text-xs font-bold text-[var(--color-fg-muted)] uppercase tracking-wide mb-1.5">MLA</p>
                <p class="text-xs text-[var(--color-fg-muted)] bg-[var(--color-code-bg)] rounded-lg p-3 leading-relaxed">
                  Seo, Jaehong. "{title}." <em>Korea Climate Assembly Wiki</em>, {frontmatter?.last_updated ?? '2026'}.
                  &lt;https://climate-assembly-wiki.pages.dev{canonicalPath ?? ''}&gt;.
                </p>
              </div>
              {/* Chicago */}
              <div>
                <p class="text-xs font-bold text-[var(--color-fg-muted)] uppercase tracking-wide mb-1.5">Chicago</p>
                <p class="text-xs text-[var(--color-fg-muted)] bg-[var(--color-code-bg)] rounded-lg p-3 leading-relaxed">
                  Seo, Jaehong. "{title}." Korea Climate Assembly Wiki. Last modified {frontmatter?.last_updated ?? '2026'}.
                  https://climate-assembly-wiki.pages.dev{canonicalPath ?? ''}.
                </p>
              </div>
            </div>
          </details>

          <!-- License + source link row -->
          <div class="flex flex-wrap items-center gap-4">
            {!frontmatter?.last_updated && <LicenseBadge license={license} orgName={orgName} />}
            {sourceKorean && lang !== 'ko' && (
              <a
                href={sourceKorean}
                class="text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] hover:underline transition-colors"
              >
                {lang === 'en' ? '← Korean source' : '← 한국어 원문'}
              </a>
            )}
          </div>
        </footer>

      </article>

      <!-- Right sticky TOC (M2-2) — desktop xl+ only -->
      <Toc headings={headings} lang={lang} variant="desktop" />

    </div>
  </div>
</BaseLayout>
