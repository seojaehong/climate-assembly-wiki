# Dependencies
node_modules/
.pnpm-store/
.yarn/
package-lock.json.bak

# Data file backups (do not commit)
src/data/*.bak
src/data/*.bak.*
src/data/*.json.bak

# Astro
dist/
.astro/
.output/

# Build / cache
.cache/
.tmp/
.turbo/
.vercel/
.wrangler/

# Pagefind
public/pagefind/
pagefind/

# Scratch render files (PNG 추출용 임시 HTML — 노출/배포 제외, 로컬엔 보존)
public/tmp-postit.html
public/tmp-rounds/
public/tmp-*

# Environment
.env
.env.*
!.env.example

# Secrets / keys
*.pem
*.key
*.crt
secrets.json
.anthropic_key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Python (translation scripts may use python helpers)
__pycache__/
*.pyc
.venv/
venv/

# Translation cache
.translation-cache/
scripts/.cache/

# Internal subagent memory (not public)
.claude/
build_output.txt
# Lockfile intentionally ignored — Cloudflare auto-selects npm ci (strict) when
# committed, which fails on cross-platform optional deps (sharp/@emnapi etc).
# package.json#overrides handles version pinning declaratively. See feedback memory.
package-lock.json
dist_backup_tmp
dist_backup2
