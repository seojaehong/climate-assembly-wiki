{
  "name": "climate-assembly-wiki",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.18.0 <21"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:automation": "cd automation && node node_modules/vitest/vitest.mjs run",
    "verify:0912:static": "node scripts/verify-workshop-access-contract.mjs && node scripts/verify-0912-readiness.mjs --output .tmp-verify/0912-13-traceability-report.json",
    "verify:0912:postgres": "bash scripts/verify-0912-postgres.sh",
    "verify:0912:field": "node scripts/verify-field-rehearsal.mjs --report .tmp-verify/0912-13-field-rehearsal.json",
    "verify:0912:hq": "node scripts/verify-0912-hq-rehearsal.mjs --report .tmp-verify/0912-13-hq-rehearsal.json",
    "verify:0912:release-report": "node scripts/verify-0912-release-report.mjs",
    "prepare:0912:operator": "node scripts/prepare-0912-operator-packet.mjs",
    "verify:0912:local": "vitest run && npm run test:automation && astro check && node scripts/verify-workshop-access-contract.mjs && node scripts/verify-0912-readiness.mjs --output .tmp-verify/0912-13-traceability-report.json && bash scripts/verify-0912-postgres.sh",
    "build:scene": "node scripts/build-agenda-network-scene.mjs",
    "build:agenda-surface": "node scripts/build-agenda-surface.mjs",
    "build:gyeonggi-agenda-source": "node scripts/build-gyeonggi-agenda-source.mjs",
    "build:supabase-agenda-source": "node scripts/build-supabase-agenda-source.mjs",
    "build:kb-agenda-source": "node scripts/build-kb-agenda-source.mjs",
    "build:source-coverage-graph": "node scripts/build-graph-source-coverage-graph.mjs",
    "audit:agenda-sources": "node scripts/audit-agenda-source-inventory.mjs",
    "audit:graph-sources": "node scripts/audit-graph-source-coverage.mjs",
    "prebuild": "npm run build:scene && npm run build:agenda-surface && npm run build:gyeonggi-agenda-source && npm run build:kb-agenda-source && npm run wiki:reindex && npm run wiki:log",
    "build": "astro build",
    "postbuild": "node scripts/write-deployment-revision.mjs",
    "postinstall": "node scripts/prune-kordoc-optionals.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "wiki:reindex": "node scripts/build-index.mjs",
    "wiki:log": "node scripts/append-log.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "^3.2.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@rhwp/core": "file:./vendor/rhwp-core-0.8.4",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "4.1.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@xyflow/react": "^12.11.0",
    "astro": "5.18.2",
    "astro-pagefind": "^1.7.0",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.7.1",
    "gray-matter": "^4.0.3",
    "kordoc": "file:./vendor/kordoc-4.12.0",
    "marked": "^18.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "clsx": "^2.1.1"
  }
}
